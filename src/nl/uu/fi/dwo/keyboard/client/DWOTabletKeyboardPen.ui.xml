<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui"
	xmlns:my="urn:import:nl.uu.fi.dwo.keyboard.client"
	>
	<ui:style>
	.pad {
		float: right;
		margin-left: 7px;
	}
	
	.pen {
		width: 593px;
		height: 150px;
	}
	.dkeys {
		width: auto !important;
	}
	
	</ui:style>
		<g:HorizontalPanel addStyleNames="keyboard keyboard-hand is-active {style.dkeys}" >
			<g:SimplePanel ui:field="writePanel" styleName="{style.pen}" />
			<my:DWOTabletKeyboardPad ui:field="pad" styleName="{style.pad}" />	
		</g:HorizontalPanel>
</ui:UiBinder> 