<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui"
	xmlns:my="urn:import:nl.uu.fi.dwo.keyboard.client"
	>
	<ui:style>
	.pad {
		float: right;
		margin-left: 7px;
		margin-top: 60px;
		margin-right: 10px;
	}
	
	.pen {
		height: 210px;
		margin-left: 10px;
	}
	.dkeys {
		width: 100%;
	}
	
	</ui:style>
	<g:DockLayoutPanel unit="PX" addStyleNames="keyboard keyboard-hand is-active {style.dkeys}" >
	  <g:center>
		<g:SimplePanel ui:field="writePanel" styleName="{style.pen}" />
	  </g:center>
	  <g:east size="90">
		<my:DWOTabletKeyboardPad ui:field="pad" styleName="{style.pad}" />
	  </g:east>
	</g:DockLayoutPanel>
</ui:UiBinder> 