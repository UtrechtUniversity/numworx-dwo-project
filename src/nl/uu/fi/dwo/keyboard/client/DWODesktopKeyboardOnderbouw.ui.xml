<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:my="urn:import:nl.uu.fi.dwo.keyboard.client"
	xmlns:g="urn:import:com.google.gwt.user.client.ui">
	<ui:with type="nl.uu.fi.dwo.keyboard.client.DWOkeyboardBundle" field="resources" />
	<ui:style field='style' type='nl.uu.fi.dwo.keyboard.client.ResponsiveCSS'>
	@def grijs rgb(180,180,180);
	@def blauw #7896CA);
	@def donkerblauw #2673B6;
	@def achtergrond rgb(229,231,233);

	.root {
		background-color: achtergrond;
		position:relative;
		line-height: 33px;

		font-family: sans-serif;
		font-style: initial;
		font-weight: bold !important;
		font-size: 16px;
	}
	
	.normal {
	}
	
	.small {
	}
	
	.extrasmall {
	}
	
	.normal .row1 {
		width: 30%;
		top: 5px;
		position: absolute;
		left: 0%;
	}		
	.small .row1 {
		width: 60%;
		margin-top: 5px;
	}		

	.normal .row2 {
		top: 5px;
		width: 30%;
		left: 30%;
		position: absolute;
	}	
	.small .row2 {
		top: 42px;
		left: 0%;
		width: 60%;
		position: absolute;
	}

	.normal .row3 {
		top: 5px;
		width: 10%;
		left: 60%;
		position: absolute;
	}
	.small .row3 {
		top: 5px;
		width: 20%;
		left: 60%;
		position: absolute;
	}
	.normal .row4 {
		top: 5px;
		width: 10%;
		left: 70%;
		position: absolute;
	}
	.small .row4 {
		top: 42px;
		width: 20%;
		left: 60%;
		position: absolute;
	}	
	.normal .row5 {
		top: 5px;
		width: 10%;
		left: 80%;
		position: absolute;
	}
	.small .row5 {
		top: 5px;
		width: 20%;
		left: 80%;
		position: absolute;
	}
	
	.normal .row6 {
		top: 5px;
		width: 10%;
		left: 90%;
		position: absolute;
	}
	.small .row6 {
		top: 42px;
		width: 20%;
		left: 80%;
		position: absolute;
	}
	
	.row1 .svgimage, .row2 .svgimage {
		width: 16.6667%;
	}

	.row3 .svgimage, .row4 .svgimage, .row5 .svgimage, .row6 .svgimage, .row6 .svgimagem, .row6 .svgimagen {
		width: 50%;
	}
	
	.svgimage {
		position: relative;
		height: 32px !important;
		display: inline-block;
		margin-top: 5px;
	}
	.svgimagem {
		position: relative;
		display: inline-block;
		margin-top: 5px;
		height: 47px;
	}
	.svgimagem .key {
		height: 32px;
		padding-bottom: 15px;
	}

	.svgimagen {
		position: relative;
		height: 32px !important;
		margin-bottom: 15px;
		display: inline-block;
		margin-top: 5px;
	}
	.lt.key div { 
		font-style: italic;
	}
	.bluesymbol.key div, .ltbluesymbol.key div {
		font-weight: normal;
	}
	
	.graysymbol.key {
		background-color: grijs;
		color: white;
	}
	.bluesymbol.key {
		background-color: blauw;
		color: white;
	}

	.ltbluesymbol.key {
		background-color: donkerblauw;
		color: white;
	}
	
	.row1, .row2, .row3, .row4, .row5, .row6 {
		display: inline-block;
	}
	
	.key {
		position: absolute;
		left: 5px; right: 0px; top: 0px; bottom: 0px;
		border-radius: 5px;
		background-color: white;
	}
	.key img {
		width: 100%;
		height: 32px;
	}
	.pad {
		padding-left: 5px;
		padding-right: 10px;
		background-color: achtergrond;
	}
	
	</ui:style>
	<g:SimplePanel addStyleNames="{style.normal} {style.pad}">
	<g:FlowPanel addStyleNames="{style.root}">
		<g:FlowPanel addStyleNames='{style.row1}'>
			<g:SimplePanel addStyleNames="{style.svgimage}"><g:SimplePanel addStyleNames="{style.key}"><my:DKey ui:field="t3_1" resource="{resources.wortel_svg}" /></g:SimplePanel></g:SimplePanel>
			<g:SimplePanel addStyleNames="{style.svgimage}"><g:SimplePanel addStyleNames="{style.key}"><my:DKey ui:field="t3_2" resource="{resources.macht_svg}" /></g:SimplePanel></g:SimplePanel>
			<g:SimplePanel addStyleNames="{style.svgimage}"><g:SimplePanel addStyleNames="{style.key}"><my:DKey ui:field="t3_3" resource="{resources.kwadraat_svg}" /></g:SimplePanel></g:SimplePanel>
			<g:SimplePanel addStyleNames="{style.svgimage}"><g:SimplePanel addStyleNames="{style.key}"><my:DKey ui:field="t3_4" resource="{resources.breuk_svg}" /></g:SimplePanel></g:SimplePanel>
			<g:SimplePanel addStyleNames="{style.svgimage}"><g:SimplePanel addStyleNames="{style.key}"><my:DKey ui:field="t3_5" resource="{resources.haakjes_svg}" /></g:SimplePanel></g:SimplePanel>
			<g:SimplePanel addStyleNames="{style.svgimage}"><g:SimplePanel addStyleNames="{style.key}"><my:DKey ui:field="t3_6" resource="{resources.ndewortel_svg}"/></g:SimplePanel></g:SimplePanel>
		</g:FlowPanel>
		<g:FlowPanel addStyleNames="{style.row2}" > 
			<g:SimplePanel addStyleNames="{style.svgimage}"><g:SimplePanel addStyleNames="{style.key} {style.lt}"><my:FKey ui:field="t4_8">π</my:FKey></g:SimplePanel></g:SimplePanel>
			<g:SimplePanel addStyleNames="{style.svgimage}"><g:SimplePanel addStyleNames="{style.key}"><my:FKey ui:field="t4_11">≤</my:FKey></g:SimplePanel></g:SimplePanel>
			<g:SimplePanel addStyleNames="{style.svgimage}"><g:SimplePanel addStyleNames="{style.key}"><my:FKey ui:field="t4_12">≥</my:FKey></g:SimplePanel></g:SimplePanel>
			<g:SimplePanel addStyleNames="{style.svgimage}"><g:SimplePanel addStyleNames="{style.key}"><my:FKey ui:field="t4_15">≈</my:FKey></g:SimplePanel></g:SimplePanel>
			<g:SimplePanel addStyleNames="{style.svgimage}"><g:SimplePanel addStyleNames="{style.key}"><my:FKey ui:field="t4_14">∠</my:FKey></g:SimplePanel></g:SimplePanel>
			<g:SimplePanel addStyleNames="{style.svgimage}"><g:SimplePanel addStyleNames="{style.key}"><my:FKey ui:field="t4_13">°</my:FKey></g:SimplePanel></g:SimplePanel>
		</g:FlowPanel>
		<g:FlowPanel addStyleNames="{style.row3}" >
			<g:SimplePanel addStyleNames="{style.svgimage}"><g:SimplePanel addStyleNames="{style.key} {style.graysymbol}"><my:FKey ui:field="t1_5">〈</my:FKey></g:SimplePanel></g:SimplePanel>
			<g:SimplePanel addStyleNames="{style.svgimage}"><g:SimplePanel addStyleNames="{style.key} {style.graysymbol}"><my:FKey ui:field="t1_6">〉</my:FKey></g:SimplePanel></g:SimplePanel>
		</g:FlowPanel>
		<g:FlowPanel addStyleNames="{style.row4}" >
			<g:SimplePanel addStyleNames="{style.svgimage}"><g:SimplePanel addStyleNames="{style.key} {style.graysymbol}"><my:FKey ui:field="t1_7">←</my:FKey></g:SimplePanel></g:SimplePanel>
			<g:SimplePanel addStyleNames="{style.svgimage}"><g:SimplePanel addStyleNames="{style.key} {style.graysymbol}"><my:FKey ui:field="t1_8">→</my:FKey></g:SimplePanel></g:SimplePanel>
		</g:FlowPanel>
		<g:FlowPanel addStyleNames="{style.row5}" >
			<g:SimplePanel addStyleNames="{style.svgimage}"><g:SimplePanel addStyleNames="{style.key} {style.ltbluesymbol}"><my:FKey ui:field="t2_16">123</my:FKey></g:SimplePanel></g:SimplePanel>
			<g:SimplePanel addStyleNames="{style.svgimage}"><g:SimplePanel addStyleNames="{style.key} {style.bluesymbol}"><my:FKey ui:field="t1_16">αβ</my:FKey></g:SimplePanel></g:SimplePanel>
		</g:FlowPanel>
		<g:FlowPanel addStyleNames="{style.row6}">
			<g:SimplePanel addStyleNames="{style.svgimagen}"><g:SimplePanel addStyleNames="{style.key} {style.bluesymbol}"><my:DKey ui:field="t4_16" resource="{resources.hand_svg}" /></g:SimplePanel></g:SimplePanel>
			<g:SimplePanel addStyleNames="{style.svgimagem}"><g:SimplePanel addStyleNames="{style.key} {style.graysymbol}"><my:DKey ui:field="t4_17" resource="{resources.VVV_svg}" /></g:SimplePanel></g:SimplePanel>
		</g:FlowPanel>
	</g:FlowPanel></g:SimplePanel>
</ui:UiBinder> 