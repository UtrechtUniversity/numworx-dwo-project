	}
	.small .row2 .svgimage, .extrasmall .row2 .svgimage { width: 100%; }
	.normal .row3 .svgimage, .normal .row4 .svgimage, .normal .row5 .svgimage, .normal .row6 .svgimage {
		width: 16.667%;
	}
	.small .row3 .svgimage, .small .row3 .svgimage, .small .row4 .svgimage, .small .row10 .svgimage,
	.small .row7 .svgimage, .extrasmall .row7 .svgimage,
	.extrasmall .row3 .svgimage, .extrasmall .row4 .svgimage, .extrasmall .row5 .svgimage,
