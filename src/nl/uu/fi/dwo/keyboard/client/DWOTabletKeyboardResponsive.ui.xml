	.root {
		background-color: achtergrond;
		position: relative;
		line-height: 0px;
	
		font-family: sans-serif;
		font-style: initial;
		font-size: 16px;
		font-weight: normal;
	}

	.pad {
		padding-left: 5px;
		padding-right: 10px;
		background-color: achtergrond;
	}
	.key {
		position: absolute;
		left: 5px; right: 0px; top: 0px; bottom: 0px;
		border-radius: 5px;
		background-color: white;
	}
	.key img {
		width: 100%;
		height: 32px;
	}
	
	.row1 .svgimage {
		width: 25%;
	}
	.small .row6 .svgimage {
		width: 33.333%;
	}
	.normal .row2 .svgimage, .normal .row7 .svgimage,  .row8 .svgimage, .row9 .svgimage, .normal .row10 .svgimage,
	.small .row5 .svgimage, .extrasmall .row6 .svgimage
