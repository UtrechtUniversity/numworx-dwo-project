	.symbol {
		vertical-align: top;
	}
	.grsymbol.svgimage {
		background-color: gray;
		vertical-align: top;
		color: white;
	}
	.dgrsymbol.svgimage {
		background-color: darkgray;
		vertical-align: top;
		color: white;
	}
	.lgrsymbol.svgimage {
		background-color: lightgray;
		vertical-align: top;
		color: black;
	}
	.blsymbol.svgimage {
		background-color: blue;
		vertical-align: top;
		color: white;
	}

	.dblsymbol.svgimage {
		background-color: darkblue;
		vertical-align: top;
		color: white;
	}
	
	.row1 .svgimage, .normal .row10 .svgimage, .row11 .svgimage, .small .row5 .svgimage { 
		width: 33.333%;
	}

	.row2 .svgimage, .row13 .symbol, .small .row6 .svgimage, .small .row7 .svgimage, .small .row8 .svgimage {
		width: 100%;
	}
	.row3 .svgimage, .normal .row8 .svgimage, .row12 .svgimage, .small .row10 .svgimage {
		width: 50%;
	}
	.row4 .svgimage, .row9 .svgimage {
		width: 50%;
	}

	.normal .row5 .svgimage, .normal .row6 .svgimage {
		width: 14.286%
	}
	.normal .row7 .svgimage {
		width: 20%;
	}
	
	
	.svgimage {
		height: 32px !important;
		display: inline-block;
		margin-top: 5px;
		border-radius: 5px;
		background-color: white;
	}
	.svgimagem, .svgimagel {
		height: 69px;
		margin-top: 5px;
		border-radius: 5px;
		background-color: gray;
	}
	
