	<g:FlowPanel addStyleNames="{style.root} {style.normal}">
		<g:FlowPanel addStyleNames="{style.row1}">
			<my:FKey addStyleNames="{style.dgrsymbol} {style.svgimage}" ui:field="t7">7</my:FKey>	
			<my:FKey addStyleNames="{style.dgrsymbol} {style.svgimage}" ui:field="t8">8</my:FKey>	
