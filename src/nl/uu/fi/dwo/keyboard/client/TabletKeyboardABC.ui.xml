<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui"
	xmlns:my="urn:import:nl.uu.fi.dwo.keyboard.client"
	>
	<ui:with field='res' type='nl.uu.fi.dwo.keyboard.client.ResourceBase' />
	<ui:style>
	
	.pad {
		float: right;
	}
	
	</ui:style>
	<g:HorizontalPanel addStyleNames="keyboard keyboard-abc is-active" >
		<g:FlowPanel  styleName="keys">
			<g:FlowPanel  addStyleNames="row row-1" >
				<my:Key addStyleNames="key" ui:field="t1_1" >
					<my:upFace>q</my:upFace>
				</my:Key>
				<my:Key addStyleNames="key" ui:field="t1_2" >
					<my:upFace>w</my:upFace>
				</my:Key>
				<my:Key addStyleNames="key" ui:field="t1_3" >
					<my:upFace>e</my:upFace>
				</my:Key>
				<my:Key addStyleNames="key" ui:field="t1_4" >
					<my:upFace>r</my:upFace>
				</my:Key>
				<my:Key addStyleNames="key" ui:field="t1_5" >
					<my:upFace>t</my:upFace>
				</my:Key>
				<my:Key addStyleNames="key" ui:field="t1_6" >
					<my:upFace>y</my:upFace>
				</my:Key>
				<my:Key addStyleNames="key" ui:field="t1_7" >
					<my:upFace>u</my:upFace>
				</my:Key>
				<my:Key addStyleNames="key" ui:field="t1_8" >
					<my:upFace>i</my:upFace>
				</my:Key>
				<my:Key addStyleNames="key" ui:field="t1_9" >
					<my:upFace>o</my:upFace>
				</my:Key>
				<my:Key addStyleNames="key" ui:field="t1_10" >
					<my:upFace>p</my:upFace>
				</my:Key>
			</g:FlowPanel>

			<g:FlowPanel  addStyleNames="row row-2" >
				<my:Key addStyleNames="key" ui:field="t2_1" >
					<my:upFace>a</my:upFace>
				</my:Key>
				<my:Key addStyleNames="key" ui:field="t2_2" >
					<my:upFace>s</my:upFace>
				</my:Key>
				<my:Key addStyleNames="key" ui:field="t2_3" >
					<my:upFace>d</my:upFace>
				</my:Key>
				<my:Key addStyleNames="key" ui:field="t2_4" >
					<my:upFace>f</my:upFace>
				</my:Key>
				<my:Key addStyleNames="key" ui:field="t2_5" >
					<my:upFace>g</my:upFace>
				</my:Key>
				<my:Key addStyleNames="key" ui:field="t2_6" >
					<my:upFace>h</my:upFace>
				</my:Key>
				<my:Key addStyleNames="key" ui:field="t2_7" >
					<my:upFace>j</my:upFace>
				</my:Key>
				<my:Key addStyleNames="key" ui:field="t2_8" >
					<my:upFace>k</my:upFace>
				</my:Key>
				<my:Key addStyleNames="key" ui:field="t2_9" >
					<my:upFace>l</my:upFace>
				</my:Key>
			</g:FlowPanel>
		
			<g:FlowPanel  addStyleNames="row row-3" >
				<my:Key addStyleNames="key key-shift" ui:field="t3_1" >
					<my:upFace><span class='basis-T3-1' ></span></my:upFace>
				</my:Key>
				<my:Key addStyleNames="key" ui:field="t3_2" >
					<my:upFace>z</my:upFace>
				</my:Key>
				<my:Key addStyleNames="key" ui:field="t3_3" >
					<my:upFace>x</my:upFace>
				</my:Key>
				<my:Key addStyleNames="key" ui:field="t3_4" >
					<my:upFace>c</my:upFace>
				</my:Key>
				<my:Key addStyleNames="key" ui:field="t3_5" >
					<my:upFace>v</my:upFace>
				</my:Key>
				<my:Key addStyleNames="key" ui:field="t3_6" >
					<my:upFace>b</my:upFace>
				</my:Key>
				<my:Key addStyleNames="key" ui:field="t3_7" >
					<my:upFace>n</my:upFace>
				</my:Key>
				<my:Key addStyleNames="key" ui:field="t3_8" >
					<my:upFace>m</my:upFace>
				</my:Key>
				<my:Key addStyleNames="key" ui:field="t3_9" >
					<my:upFace>!</my:upFace>
				</my:Key>
				<my:Key addStyleNames="key" ui:field="t3_10" >
					<my:upFace>,</my:upFace>
				</my:Key>
				<my:Key addStyleNames="key" ui:field="t3_11" >
					<my:upFace>.</my:upFace>
				</my:Key>
				<my:Key addStyleNames="key" ui:field="t3_12" >
					<my:upFace>?</my:upFace>
				</my:Key>
			</g:FlowPanel>

			<g:FlowPanel  addStyleNames="row row-4" >
				<my:Key addStyleNames="key key-space" ui:field="t4_1" >
					<my:upFace>spatie</my:upFace>
				</my:Key>
			</g:FlowPanel>
		</g:FlowPanel>
		<my:TabletKeyboardPad ui:field="pad" addStyleNames="{style.pad}" />	
	</g:HorizontalPanel>
</ui:UiBinder> 