	<ui:with type="nl.uu.fi.dwo.keyboard.client.DWOkeyboardBundle" field="resources" />
	<ui:with type="fi.wiskopdr.text.TextConstants" field="rb"/>
	<ui:style field='style' type='nl.uu.fi.dwo.keyboard.client.ResponsiveCSS'>
	@def dgrijs rgb(131,131,131);
	@def grijs rgb(180,180,180);
	@def lgrijs rgb(240,240,240);
	@def blauw #7896CA;
	@def donkerblauw #2673B6;
	@def achtergrond rgb(229,231,233);
	.normal {
	}
	.small {
	}
	.extrasmall {
	}

	.pad {
		padding-left: 5px;
		padding-right: 10px;
		background-color: achtergrond;
	}
	
	.root {
		position: relative;
		font-size: 16px;
		line-height: 33px;
		font-family: serif;
		font-style: initial;
	}
	
	.row1, .row2 {
		display: inline-block;
		margin-top: 5px;
	}
	.normal .row1 {
		width: 33.333%;
	}
	.normal .row2 {
		width: 29.167%;
	}
	
	.svgimage {
		display: inline-block;
		height: 32px;
		margin-top: 5px;
	}
	
	.row1 .svgimage {
		width: 12.5%;
	}
	.row2 .svgimage {
		width: 14.2857%;
	}
	
	.key {
		background-color: white;
		margin-left: 5px;
		border-radius: 5px;
		height: 32px;	
	}

	.lt {
		font-style: italic;
	}

	.lgr {
		background-color: lgrijs;
	}
	
	</ui:style>
