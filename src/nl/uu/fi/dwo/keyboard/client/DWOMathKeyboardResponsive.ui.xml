	@external .kbd-Key;
	@def dgrijs rgb(131,131,131);
	@def grijs rgb(180,180,180);
	@def lgrijs rgb(240,240,240);
	@def blauw #7896CA;
	@def donkerblauw #2673B6;
	@def achtergrond rgb(229,231,233);
/* sizes */
	.normal {
	}
	.small {
	}
	.extrasmall {
	}
/* state */
	.s0 {
	}
	.s1 {
	}
	.s2 {
	}

	.pad {
		padding-left: 5px;
		padding-right: 10px;
		background-color: achtergrond;
	}
	
	.root {
		position: relative;
		font-size: 16px;
		line-height: 33px;
		font-family: serif !important;
		font-style: initial;
	}

	.root .kbd-Key {
		font-family: serif;
	}
	
	.row1, .row2, .row3 {
		display: inline-block;
		margin-top: 5px;
	}
	
	.row4 {
		margin-top: 5px;
		display: inline-block;
		position: absolute;
		bottom: 0px;
		top: 0px;
		right: 0px;
	}
	.root .row4 .kbd-Key {
		font-family: sans-serif;
		margin-top: 5px;
		margin-left: 5px;
		background-color: blauw;
		color: white;
		border-radius: 5px;		
	}
	.root .row4 img {
		background-color: grijs;
		border-radius: 5px;
		margin-top: 5px;
		margin-left: 5px;
		vertical-align: top;
	}
	.root .row4 > div:first-child img {
		background-color: blauw;
	}
	.root .row4 > div:first-child > .kbd-Key:first-child {
		background-color: donkerblauw;
	}
	
	.normal .row1a, .normal .row2a, .normal .row3a, 
	.s0.small .row1a, .s0.small .row2a, .s0.small .row3, 
	.s0.extrasmall .row1a, .s0.extrasmall .row3, .s0.extrasmall .row2,
	.s2.extrasmall .row3a, .s2.extrasmall .row1, .s2.extrasmall .row2, 
	.s1.extrasmall .row2a, .s1.extrasmall .row1, .s1.extrasmall .row3,
	.s2.small .row1a, .s2.small .row2, .s2.small .row3a,
	.s1.small .row1, .s1.small .row2a, .s1.small .row3a {
		display: none;
	}
	.s0.small .row3a, .s2.small .row2a {
		display: inline-block;
		width: 5.556%;
	}

	.s0.extrasmall .row2a, .s0.extrasmall .row3a {
		display: inline-block;
		width: 8.333%;
	}
	.s2.extrasmall .row1a, .s2.extrasmall .row2a,
	.s1.extrasmall .row1a, .s1.extrasmall .row3a {
		display: inline-block;
		width: 9.091%;
	}
	
	.s1.small .row1a {
		width: 5.882%;
		display: inline-block;
	}
	.s1.small .row2, .s1.small .row3 {
		width: 41.176%;
	}
	
	
	.row1a, .row2a, .row3a {
		text-align: center;
		margin-top: 10px;
		vertical-align: top;
	}
	
	.s0.small .row1, .s2.small .row1 {
		width: 44.444%;
	}
	.s0.small .row2, .s2.small .row3 {
		width: 38.889%;
	}
	
	.s0.extrasmall .row1 {
		width: 66.667%;
	}
	.s2.extrasmall .row3, .s1.extrasmall .row2 {
		width: 65.657%;
	}
		
	.small .row4 {
		width: 11.111% !important;
	}
	.s1.small .row4 {
		width: 11.765% !important;
	}

	.s0.extrasmall .row4 {
		width: 16.667% !important;
	}
	.s2.extrasmall .row4, .s1.extrasmall .row4 {
		width: 18.181% !important;
	}

	
	.normal .row1 {
		width: 33.333%;
	}

	
	.normal .row2, .normal .row3 {
		width: 29.167%;
	}
	.normal .row4 {
		width: 8.333% !important;
	}
	
	.svgimage {
		display: inline-block;
		height: 32px;
		margin-top: 5px;
	}
	
	.row1 .svgimage {
		width: 12.5%;
	}
	.row2 .svgimage , .row3 .svgimage {
		width: 14.2857%;
	}
	
	.key {
		background-color: white;
		margin-left: 5px;
		border-radius: 5px;
		height: 32px;	
	}

	.lt {
		font-style: italic;
	}

	.lgr {
		background-color: lgrijs;
	}
	.gr {
		background-color: grijs;
		color: white;
		font-weight: bold;
		font-family: sans-serif;
	}
	
	.row4 > div {
		display: inline-block;
		width: 50%;
		vertical-align: top;
	}
	
