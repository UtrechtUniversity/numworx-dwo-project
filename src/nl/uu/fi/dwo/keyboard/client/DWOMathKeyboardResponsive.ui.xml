		<g:FlowPanel addStyleNames="{style.root}">
			<g:FlowPanel addStyleNames="{style.row1}">
				<g:SimplePanel addStyleNames="{style.svgimage}"><g:SimplePanel addStyleNames="{style.key} {style.lt}"><my:FKey ui:field="t1_1">α</my:FKey></g:SimplePanel></g:SimplePanel>
