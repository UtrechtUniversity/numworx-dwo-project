<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui"
	xmlns:my="urn:import:nl.uu.fi.dwo.keyboard.client"
	>
	<ui:with field='res' type='nl.uu.fi.dwo.keyboard.client.ResourceBase' />
	<ui:style>
	.col {
		padding-top: 7px;
	}
	.key {
		width: 42px;
		height: 32px;
		padding-top: 3px;
		padding-bottom: 3px;
		margin-left: 4px;
		margin-right: 4px;
	}
	.space {
		width: 492px;
		height: 32px;
		padding-top: 3px;
		padding-bottom: 3px;
		margin-left: 4px;
		margin-right: 4px;
	}
	
	.panel { 
		width: 886px;
		height: 166px;
		border-collapse: collapse;
		border-spacing: 0px;
		background-color: #D2D2D2
		
	}
	
	.row1 {
		padding-left: 86px;
	}
	.row2 {
		padding-left: 111px;
	}
	.pad {
		float: right;
		margin-right: 7px;
	}
	
	</ui:style>
	<g:HorizontalPanel addStyleNames="{style.panel}" >
		<g:VerticalPanel  addStyleNames="{style.col}" >
			<g:HorizontalPanel  addStyleNames="{style.row1}" >
				<my:Key addStyleNames="{style.key}" ui:field="t1_1" >
					<my:upFace><span class='alphabet' >Q</span></my:upFace>
				</my:Key>
				<my:Key addStyleNames="{style.key}" ui:field="t1_2" >
					<my:upFace><span class='alphabet' >W</span></my:upFace>
				</my:Key>
				<my:Key addStyleNames="{style.key}" ui:field="t1_3" >
					<my:upFace><span class='alphabet' >E</span></my:upFace>
				</my:Key>
				<my:Key addStyleNames="{style.key}" ui:field="t1_4" >
					<my:upFace><span class='alphabet' >R</span></my:upFace>
				</my:Key>
				<my:Key addStyleNames="{style.key}" ui:field="t1_5" >
					<my:upFace><span class='alphabet' >T</span></my:upFace>
				</my:Key>
				<my:Key addStyleNames="{style.key}" ui:field="t1_6" >
					<my:upFace><span class='alphabet' >Y</span></my:upFace>				</my:Key>
				<my:Key addStyleNames="{style.key}" ui:field="t1_7" >
					<my:upFace><span class='alphabet' >U</span></my:upFace>
				</my:Key>
				<my:Key addStyleNames="{style.key}" ui:field="t1_8" >
					<my:upFace><span class='alphabet' >I</span></my:upFace>
				</my:Key>
				<my:Key addStyleNames="{style.key}" ui:field="t1_9" >
					<my:upFace><span class='alphabet' >O</span></my:upFace>
				</my:Key>
				<my:Key addStyleNames="{style.key}" ui:field="t1_10" >
					<my:upFace><span class='alphabet' >P</span></my:upFace>
				</my:Key>
			</g:HorizontalPanel>

			<g:HorizontalPanel  addStyleNames="{style.row2}" >
				<my:Key addStyleNames="{style.key}" ui:field="t2_1" >
					<my:upFace><span class='alphabet' >A</span></my:upFace>
				</my:Key>
				<my:Key addStyleNames="{style.key}" ui:field="t2_2" >
					<my:upFace><span class='alphabet' >S</span></my:upFace>
				</my:Key>
				<my:Key addStyleNames="{style.key}" ui:field="t2_3" >
					<my:upFace><span class='alphabet' >D</span></my:upFace>
				</my:Key>
				<my:Key addStyleNames="{style.key}" ui:field="t2_4" >
					<my:upFace><span class='alphabet' >F</span></my:upFace>
				</my:Key>
				<my:Key addStyleNames="{style.key}" ui:field="t2_5" >
					<my:upFace><span class='alphabet' >G</span></my:upFace>
				</my:Key>
				<my:Key addStyleNames="{style.key}" ui:field="t2_6" >
					<my:upFace><span class='alphabet' >H</span></my:upFace>
				</my:Key>
				<my:Key addStyleNames="{style.key}" ui:field="t2_7" >
					<my:upFace><span class='alphabet' >J</span></my:upFace>
				</my:Key>
				<my:Key addStyleNames="{style.key}" ui:field="t2_8" >
					<my:upFace><span class='alphabet' >K</span></my:upFace>
				</my:Key>
				<my:Key addStyleNames="{style.key}" ui:field="t2_9" >
					<my:upFace><span class='alphabet' >L</span></my:upFace>
				</my:Key>
			</g:HorizontalPanel>
		
			<g:HorizontalPanel  addStyleNames="{style.row1}" >
				<my:Key addStyleNames="{style.key}" ui:field="t3_1" >
					<my:upFace><span class='alphabet' >SHFT</span></my:upFace>
				</my:Key>
				<my:Key addStyleNames="{style.key}" ui:field="t3_2" >
					<my:upFace><span class='alphabet' >Z</span></my:upFace>
				</my:Key>
				<my:Key addStyleNames="{style.key}" ui:field="t3_3" >
					<my:upFace><span class='alphabet' >X</span></my:upFace>
				</my:Key>
				<my:Key addStyleNames="{style.key}" ui:field="t3_4" >
					<my:upFace><span class='alphabet' >C</span></my:upFace>
				</my:Key>
				<my:Key addStyleNames="{style.key}" ui:field="t3_5" >
					<my:upFace><span class='alphabet' >V</span></my:upFace>
				</my:Key>
				<my:Key addStyleNames="{style.key}" ui:field="t3_6" >
					<my:upFace><span class='alphabet' >B</span></my:upFace>
				</my:Key>
				<my:Key addStyleNames="{style.key}" ui:field="t3_7" >
					<my:upFace><span class='alphabet' >N</span></my:upFace>
				</my:Key>
				<my:Key addStyleNames="{style.key}" ui:field="t3_8" >
					<my:upFace><span class='alphabet' >M</span></my:upFace>
				</my:Key>
				<my:Key addStyleNames="{style.key}" ui:field="t3_9" >
					<my:upFace><span class='alphabet' >!</span></my:upFace>
				</my:Key>
				<my:Key addStyleNames="{style.key}" ui:field="t3_10" >
					<my:upFace><span class='alphabet' >,</span></my:upFace>
				</my:Key>
				<my:Key addStyleNames="{style.key}" ui:field="t3_11" >
					<my:upFace><span class='alphabet' >.</span></my:upFace>
				</my:Key>
				<my:Key addStyleNames="{style.key}" ui:field="t3_12" >
					<my:upFace><span class='alphabet' >?</span></my:upFace>
				</my:Key>
			</g:HorizontalPanel>

			<g:HorizontalPanel  addStyleNames="{style.row2}" >
				<my:Key addStyleNames="{style.space}" ui:field="t4_1" >
					<my:upFace><span class='alphabet' > </span></my:upFace>
				</my:Key>
			</g:HorizontalPanel>
		</g:VerticalPanel>
		<my:TabletKeyboardPad ui:field="pad" addStyleNames="{style.pad}" />	
	</g:HorizontalPanel>
</ui:UiBinder> 