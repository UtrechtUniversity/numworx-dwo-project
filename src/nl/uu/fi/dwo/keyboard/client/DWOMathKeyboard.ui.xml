			</my:FKey>
		</g:FlowPanel>

		<g:FlowPanel addStyleNames="dclm clm-5">
			<my:FKey addStyleNames="key {style.symbol}" ui:field="t1_5" >
				〈
			</my:FKey>
			<my:FKey addStyleNames="key {style.letter}" ui:field="t2_5">
				ε
			</my:FKey>
			<my:FKey addStyleNames="key {style.letter}" ui:field="t3_5">
				ς
			</my:FKey>
			<my:FKey addStyleNames="key {style.symbol}" ui:field="t4_5">
				÷
			</my:FKey>
		</g:FlowPanel>
		<g:FlowPanel addStyleNames="dclm clm-6">
			<my:FKey addStyleNames="key {style.symbol}" ui:field="t1_6">
