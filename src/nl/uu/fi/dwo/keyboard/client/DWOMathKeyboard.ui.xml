		</g:FlowPanel>
		<g:FlowPanel addStyleNames="dclm clm-14">
			<my:FKey addStyleNames="key {style.symbol}" ui:field="t1_14">
				∀
			</my:FKey>
			<my:FKey addStyleNames="key {style.symbol}" ui:field="t2_14">
				∃
			</my:FKey>
			<my:FKey addStyleNames="key {style.symbol}" ui:field="t3_14">
				∄
			</my:FKey>
			<my:FKey addStyleNames="key {style.symbol}" ui:field="t4_14">
				∅
			</my:FKey>
		</g:FlowPanel>
		<g:FlowPanel addStyleNames="dclm clm-15">
			<my:FKey addStyleNames="key {style.symbol}" ui:field="t1_15" >
				¬
			</my:FKey>
			<my:FKey addStyleNames="key {style.symbol}" ui:field="t2_15">
				∩
			</my:FKey>
			<my:FKey addStyleNames="key {style.symbol}" ui:field="t3_15">
				∪
			</my:FKey>
			<my:FKey addStyleNames="key {style.symbol}" ui:field="t4_15">
				⊃
			</my:FKey>
		</g:FlowPanel>
	    </g:FlowPanel>
		<my:DWOTabletKeyboardPad ui:field="pad" addStyleNames="{style.pad}" />
	</g:HorizontalPanel>
</ui:UiBinder> 