<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui"
	xmlns:my="urn:import:nl.uu.fi.dwo.keyboard.client"
	>
	<ui:style>
	.pad {
		float:right;
	}
	.panel {
		float: left;
	}
	
	.dwo {
		width: auto !important;

	}
	.letter {
		font-family: serif;
		font-style: italic;
		font-weight: normal !important;
	}
	.symbol {
		font-family: monospace;
		font-style: initial;
		font-weight: normal !important;
	}
	
	</ui:style>

	<g:HorizontalPanel addStyleNames="keyboard keyboard-abc is-active {style.dwo}" >
	  <g:FlowPanel styleName="{style.panel}">
		<g:FlowPanel addStyleNames="dclm clm-1">
			<my:FKey addStyleNames="key {style.symbol}" ui:field="t1_1" >
				←
			</my:FKey>
			<my:FKey addStyleNames="key {style.letter}" ui:field="t2_1">
				α
			</my:FKey>
			<my:FKey addStyleNames="key {style.letter}" ui:field="t3_1">
				ξ
			</my:FKey>
			<my:FKey addStyleNames="key {style.symbol}" ui:field="t4_1">
				∈
			</my:FKey>
		</g:FlowPanel>
		<g:FlowPanel addStyleNames="dclm clm-2">
			<my:FKey addStyleNames="key {style.symbol}" ui:field="t1_2">
				→
			</my:FKey>
			<my:FKey addStyleNames="key {style.letter}" ui:field="t2_2">
				β
			</my:FKey>
			<my:FKey addStyleNames="key {style.letter}" ui:field="t3_2">
				Σ
			</my:FKey>
			<my:FKey addStyleNames="key {style.symbol}" ui:field="t4_2">
				∉
			</my:FKey>
		</g:FlowPanel>
		<g:FlowPanel addStyleNames="dclm clm-3">
			<my:FKey addStyleNames="key {style.symbol}" ui:field="t1_3" >
