<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui"
	xmlns:my="urn:import:nl.uu.fi.dwo.keyboard.client"
	>
	<ui:style>
	.pad {
		float: right;
		margin-right: 7px;
	}
	
	.pen {
		width: 740px;
		height: 150px;
		background-image: url('images/kb/penpad.png');
		opacity: 0.25;
	}
	
	</ui:style>
		<g:HorizontalPanel addStyleNames="keyboard keyboard-hand is-active" >
			<g:SimplePanel ui:field="writePanel" styleName="{style.pen}" />
			<my:TabletKeyboardPad ui:field="pad" styleName="{style.pad}" />	
		</g:HorizontalPanel>
</ui:UiBinder> 