<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui"
	xmlns:my="urn:import:nl.uu.fi.dwo.keyboard.client"
	>
	<ui:style>
	
	.panel { 
		width: 886px;
		height: 166px;
		border-collapse: collapse;
		border-spacing: 0px;
		background-color: #D2D2D2		
	}
	.pad {
		float: right;
		margin-right: 7px;
	}
	
	.pen {
		width: 740px;
		height: 150px;
		margin-top: 10px;
		background-image: url('images/kb/penpad.png');
		margin-left: 10px;
		opacity: 0.25;
	}
	
	</ui:style>
		<g:HorizontalPanel styleName="{style.panel}" >
			<g:SimplePanel ui:field="writePanel" styleName="{style.pen}" />
			<my:TabletKeyboardPad ui:field="pad" styleName="{style.pad}" />	
		</g:HorizontalPanel>
</ui:UiBinder> 