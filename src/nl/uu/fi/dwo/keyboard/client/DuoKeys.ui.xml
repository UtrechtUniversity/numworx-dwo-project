<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:my="urn:import:nl.uu.fi.dwo.keyboard.client"
	xmlns:g="urn:import:com.google.gwt.user.client.ui">
	<ui:style>
		.panel {
			padding-left: 16px;
			padding-right: 16px;
			background-color: #EEE;
			height: 90px;
		}
		.key {
			width: 55px !important;
			height: 50px !important;
			margin-top: 20px;
			margin-bottom: 20px;
			margin-left: 4px;
			margin-right: 4px;
			font-size: 14px;
			display: inline-block;
			float: left;
		}
		.key p {
			margin: 17px;
		}
	</ui:style>
	<g:FlowPanel addStyleNames="{style.panel} keyboard" ui:field='top'>
	  <my:FKey addStyleNames="{style.key} key bg-purple" ui:field="org" >
			x
		</my:FKey>
		<my:FKey addStyleNames="{style.key} key bg-purple" ui:field="alt" >
			y
		</my:FKey>
	</g:FlowPanel>
</ui:UiBinder> 