<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC "-//Google Inc.//DTD Google Web Toolkit 2.5.1//EN" "http://google-web-toolkit.googlecode.com/svn/tags/2.5.1/distro-source/core/src/gwt-module.dtd">
<module  rename-to='DWOplayer'>
	<inherits name="com.google.gwt.user.User" />
	<inherits name="com.google.gwt.i18n.I18N"/>
	<inherits name="nl.uu.fi.dwo.mobile.DWOplayer-module" />
	<add-linker name='xsiframe' />
	
    <inherits name="fi.graphtoolgwt.GraphToolGWT-DWO" />

	<entry-point class='nl.uu.fi.dwo.mobile.WiskOpdrPlayer'/>
	
	<replace-with class="nl.uu.fi.dwo.mobile.client.sco.SCORM_2004_API">
    	<when-type-is class="nl.uu.fi.dwo.mobile.client.sco.Scorm2004IF"/>
    </replace-with>
    
	 <replace-with class="nl.uu.fi.dwo.mobile.client.DWOPlayerMC2">
        <when-type-is class="nl.uu.fi.dwo.mobile.client.DWOplayerParameters" />
    </replace-with>
 
    <set-property name="gwt.logging.enabled" value="TRUE"/>
	<set-property name="gwt.logging.logLevel" value="FINEST"/>

<!-- English language, independent of country -->
  	<extend-property name="locale" values="en"/>
<!--   	<extend-property name="locale" values="nl"/> -->  	
  	<set-property-fallback name="locale" value="en"/> <!-- English is the default -->
	 
</module>