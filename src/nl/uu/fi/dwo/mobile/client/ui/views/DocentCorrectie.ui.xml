<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:u="urn:import:nl.uu.fi.dwo.mobile.client.ui.views.interactionviews"
	xmlns:g="urn:import:com.google.gwt.user.client.ui"
	>
	<ui:with type="nl.uu.fi.dwo.mobile.client.text.Text" field="rb" />
	<ui:style>
	.flow {
		background-color: rgb(237,239,241);
		color: rgb(49,71,112);
		font-size: 14px;
	}
	.max {
		margin-left: 10px;
		padding-top: 1em;
	}
	.score, .correctie {
		margin-left: 10px;
		margin-top: 0.4em;
	}
	.correctie {
		padding-bottom: 1em;
	}
	
	.opmerking {
		margin-left: 10px;
		margin-top: 0.4em;
		font-weight: bold;
	}
	.content {
		margin-left: 8px;
		margin-top: 0.4em;
		padding-bottom: 1em;
	}
	
	</ui:style>
	<g:FlowPanel addStyleNames="{style.flow}">
		<g:Label addStyleNames="{style.max}" ui:field='maxScore'><ui:text from="{rb.maximaleScore}"/></g:Label>
		<g:Label addStyleNames="{style.score}" ui:field='score'><ui:text from='{rb.score}' /></g:Label>
		<g:Label addStyleNames="{style.correctie}" ui:field='correctie'><ui:text from='{rb.toevoeging}' /></g:Label>
		<g:Label addStyleNames="{style.opmerking}" ui:field='opmerking'><ui:text from='{rb.opmerkingenDocent}' /></g:Label>
		<u:TekstVak addStyleNames="{style.content}" ui:field='content' />
	</g:FlowPanel>
</ui:UiBinder> 