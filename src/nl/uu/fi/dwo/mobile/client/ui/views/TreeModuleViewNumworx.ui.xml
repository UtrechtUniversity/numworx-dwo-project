<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:mgwt="urn:import:com.googlecode.mgwt.ui.client.widget"
	xmlns:cl="urn:import:com.google.gwt.user.cellview.client"
	xmlns:g="urn:import:com.google.gwt.user.client.ui">
	<ui:style>
		.rootPanel {
			height: 100%;
			width: 100%;
			font-family: "Ubuntu" !important;
		}

		.headerPanel {
			background-color: #314770; /*15*/
			color: #8eBee5;
			font-size: 13px;
			font-family: "Ubuntu" !important;
		}
		
		.navPanel {
			background-color: #DDE0E3;
			color: #314770; /*15*/
			padding-top: 40px;
			padding-left: 22px;
			font-size: 14px;
			line-height: 27px;
			font-family: "Ubuntu" !important;
			box-shadow: 2px 2px 2px #314770 inset;
		}
		.centerPanel {
			background-color: #D2E5F5;
			color: #314770; /*15*/
			font-size: 14px;
			line-height: 18px;
			padding-top: 40px;
			padding-left: 18px;
			padding-right: 22px;
			box-shadow: 2px 2px 2px #314770 inset;
			font-family: "Ubuntu" !important;
			overflow-y: scroll;
		}
		.title {
			font-size: 18px;
			margin-bottom: 20px;
			font-family: "Ubuntu" !important;
		}
		.description {
			margin-bottom: 36px;
		}
		
		.navTitle {
			border-bottom-style: solid;
			border-bottom-width: 1px;
			border-bottom-color: #A8ABB1;
			font-size: 18px;
			padding-bottom: 20px;
			margin-right: 18px;
			font-family: "Ubuntu" !important;
		}
		
		.numworx {
			font-size: 24px;
			margin-top: 10px;
			margin-left: 22px;
			margin-right: 22px;
			color: #A8ABB1;
			display: inline-block;
			font-family: Ubuntu;
			font-weight: bold;
		}
		.search {
			width: 40px;
			color: white;
			background-color: #1B75BB; /*14*/
			text-align: center;
			display: inline-block;
			
		}
		.nav {
			float: right;
			display: inline-block;
			margin-top: 10px;
			color: #798291;
			margin-right: 18px;
		}
		.loginname {
			float: right;
			display:inline-block;
			margin-top: 18px;
			color: #7297C7; /* 13 */
			font-size: 13px;
			font-family: "Ubuntu" !important;
		}
		.menu {
			float: right;
			display: inline-block;
			margin-top: 18px;
			margin-right: 22px;
			margin-left: 5px;
		}
		.search-input {
			font-family: "Ubuntu" !important;
			background-color: black;
			color: #E4F2FB;
			margin-left: 22px;
			margin-top: 18px;
			display: inline-block;
			padding-left: 4px;
			width: 400px;
		}
		.navItem {
			font-family: "Ubuntu" !important;
			line-height: 27px;
			margin-right: 18px;
			border-bottom-style: solid;
			border-bottom-width: 1px;
			border-bottom-color: #A8ABB1;
		}
		.tiles {

	
		}	
		.tile {
			width: 252px;
			height: 225px;
			margin-right: 18px;
			margin-bottom: 18px;
			display: inline-block;
			overflow: hidden;
		}
		.tileHeader {
			width: 247px;
			height: 32px;
			background-color: #AAC1DC;
			color: white;
			font-weight: bold;
			font-size: 14px;
			line-height: 16px;
			padding-left: 5px;
			font-family: Ubuntu;
		}
		.tileFooter {
			width: 252px;
			height: 27px;
			bottom: 0px;
			height: 27px;

		}
		.tileBody {
			border-bottom-style: solid;
			border-bottom-width: 6px;
			border-bottom-color: #AAC1DC;
			width: 252px;
			height: 160px;
			background-color: #E4F2FB;		
		}
		.tileResult {
			display: inline-block;
		}
		.tileScore {
			background-color: white;
			display: inline-block;
			margin-left: 10px;
			padding-left: 10px;
			padding-right: 10px;
			font-family: Ubuntu;
			font-size: 14px;
			font-weight: bold;
		}
		.tileType {
			float: right;
			display: inline-block;
			margin-top: 5px;
		}
		
	</ui:style>
	<g:DockLayoutPanel unit='PX' ui:field='root' styleName='{style.rootPanel}'>
		<g:north size="50">
			<g:FlowPanel styleName='{style.headerPanel}'>
				<g:InlineHTML styleName='{style.numworx}'>numw<i class='fa fa-cog'></i>rx</g:InlineHTML>
				<g:InlineHTML styleName='{style.search-input}'>zoek toets of lesstof</g:InlineHTML>
				<g:InlineHTML styleName='{style.search}'><i class='fa fa-search'></i></g:InlineHTML>

				<g:InlineHTML styleName='{style.menu}'><i class='fa fa-caret-down'></i></g:InlineHTML>
				<g:InlineHTML styleName='{style.loginname}'>Jolanda van den Berg</g:InlineHTML>
				<g:InlineHTML styleName='{style.nav}'><i class='fa fa-2x fa-home'></i> &#x00A0; <i class='fa fa-2x fa-star-o'></i> &#x00A0; <i class='fa fa-2x fa-square-o'></i></g:InlineHTML>
			</g:FlowPanel>
		</g:north>
		<g:west size="192">
			<g:FlowPanel styleName='{style.navPanel}'>
				<g:HTML styleName='{style.navTitle}'>Bibliotheek</g:HTML>
				<g:HTML styleName='{style.navItem}'>VMBO 1,2</g:HTML>
				<g:HTML styleName='{style.navItem}'>HAVO/VWO 1</g:HTML>
				<g:HTML styleName='{style.navItem}'>HAVO/VWO 2.3</g:HTML>
				<g:HTML styleName='{style.navItem}'>Wiskunde A</g:HTML>
				<cl:CellList ui:field='cells'></cl:CellList>
			</g:FlowPanel>
		</g:west>
		<g:center>
			<g:FlowPanel styleName='{style.centerPanel}'>
				<g:HTML styleName='{style.title}' ui:field='title' >Modules voor ....</g:HTML>
				<g:SimplePanel styleName='{style.description}' ui:field='description' />
				<g:FlowPanel> 
					<g:FlowPanel styleName='{style.tile}' >
						<g:HTML styleName='{style.tileHeader}'>Exponentiele functies</g:HTML>
						<g:HTML styleName='{style.tileBody}'>TILE BODY</g:HTML>
						<g:FlowPanel styleName='{style.tileFooter}'>
							<g:InlineHTML styleName='{style.tileResult}'><span class='fa-stack fa-lg'><i class='fa fa-circle fa-stack-1x' style='color:red;'></i><i class='fa fa-times fa-stack-1x' style='color:white;'></i></span></g:InlineHTML>
							<g:InlineHTML styleName='{style.tileScore}'>10%</g:InlineHTML>
							<g:InlineHTML styleName='{style.tileType}'><i class='fa fa-file-text-o'></i></g:InlineHTML>
						</g:FlowPanel>					
					</g:FlowPanel>

					<g:FlowPanel styleName='{style.tile}' >
						<g:HTML styleName='{style.tileHeader}'>Formules bij goniometrische functies</g:HTML>
						<g:HTML styleName='{style.tileBody}'><img style='height: 60%; margin-top: 10%; margin-left: 34%;' src='images/numworx/module-numworx.png' /></g:HTML>
						<g:FlowPanel styleName='{style.tileFooter}'>
							<g:InlineHTML styleName='{style.tileResult}'><span class='fa-stack fa-lg'><i class='fa fa-circle fa-stack-1x' style='color:red;'></i><i class='fa fa-times fa-stack-1x' style='color:white;'></i></span></g:InlineHTML>
							<g:InlineHTML styleName='{style.tileScore}'>10%</g:InlineHTML>
							<g:InlineHTML styleName='{style.tileType}'><i class='fa fa-file-text-o'></i></g:InlineHTML>
						</g:FlowPanel>					
					</g:FlowPanel>
					<g:FlowPanel styleName='{style.tile}' >
						<g:HTML styleName='{style.tileHeader}'>Exponentiele functies</g:HTML>
						<g:HTML styleName='{style.tileBody}'>TILE BODY</g:HTML>
						<g:FlowPanel styleName='{style.tileFooter}'>
							<g:InlineHTML styleName='{style.tileResult}'><span class='fa-stack fa-lg'><i class='fa fa-circle fa-stack-1x' style='color:red;'></i><i class='fa fa-times fa-stack-1x' style='color:white;'></i></span></g:InlineHTML>
							<g:InlineHTML styleName='{style.tileScore}'>100%</g:InlineHTML>
							<g:InlineHTML styleName='{style.tileType}'><i class='fa fa-file-text-o'></i></g:InlineHTML>
						</g:FlowPanel>					
					</g:FlowPanel>
					<g:FlowPanel styleName='{style.tile}' >
						<g:HTML styleName='{style.tileHeader}'>Rekenen met logarithmen en meer om twee regels te krijgen</g:HTML>
						<g:HTML styleName='{style.tileBody}'><img style='height: 60%; margin-top: 10%; margin-left: 34%;' src='images/numworx/folder-numworx.png' /></g:HTML>
						<g:FlowPanel styleName='{style.tileFooter}'>
							<g:InlineHTML styleName='{style.tileResult}'><span class='fa-stack fa-lg'><i class='fa fa-circle fa-stack-1x' style='color:red;'></i><i class='fa fa-times fa-stack-1x' style='color:white;'></i></span></g:InlineHTML>
							<g:InlineHTML styleName='{style.tileScore}'>10%</g:InlineHTML>
							<g:InlineHTML styleName='{style.tileType}'><i class='fa fa-file-text-o'></i></g:InlineHTML>
						</g:FlowPanel>					
					</g:FlowPanel>



				</g:FlowPanel>
			</g:FlowPanel>
		</g:center>
	</g:DockLayoutPanel>
</ui:UiBinder> 