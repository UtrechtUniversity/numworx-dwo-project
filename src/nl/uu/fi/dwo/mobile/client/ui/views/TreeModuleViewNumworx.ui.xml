<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:mgwt="urn:import:com.googlecode.mgwt.ui.client.widget"
	xmlns:cl="urn:import:com.google.gwt.user.cellview.client"
	xmlns:g="urn:import:com.google.gwt.user.client.ui">
	<ui:with field='pfx' type='java.lang.String'/>
	<ui:style field='style' src="TreeModuleViewNumworx.css" type='nl.uu.fi.dwo.mobile.client.ui.views.TreeModuleViewNumworxCss'/>	
	<g:DockLayoutPanel unit='PX' ui:field='root' styleName='{style.rootPanel}'>
		<g:north size="50">
			<g:FlowPanel styleName='{style.headerPanel}'>
			  	<g:FlowPanel styleName='{style.numworx}'><g:Image url="{pfx}images/numworx/logo-Numworx-grijs2.svg"></g:Image></g:FlowPanel>
				<g:TextBox ui:field='searchInput' styleName='{style.search-input}'></g:TextBox>
				<g:InlineHTML ui:field='searchBtn' styleName='{style.search}'><img src='{pfx}images/numworx/search-numworx.svg'/></g:InlineHTML>

				<g:MenuBar addStyleNames='{style.menu}'>
					<g:MenuItem ui:field='user' addStyleNames='{style.menuItem}' />
				</g:MenuBar>
				<g:Label ui:field='loginLabel' styleName='{style.loginname}'>Jolanda van den Berg</g:Label>
				<g:ToggleButton ui:field='fullBtn' styleName='{style.nav}'>
					<g:upFace><img src='{pfx}images/numworx/fullscreen-numworx.svg'/></g:upFace>
					<g:downFace><img src='{pfx}images/numworx/borderdscreen-numworx.svg'/></g:downFace>
				</g:ToggleButton>
				<g:FocusPanel styleName='{style.nav}'><g:Image url='{pfx}images/numworx/ster-grijs-numworx.svg'/></g:FocusPanel>
				<g:FocusPanel ui:field='homeBtn' styleName='{style.nav}'><g:Image url='{pfx}images/numworx/home-numworx.svg'/></g:FocusPanel>
			</g:FlowPanel>
		</g:north>
		<g:west size="192">
			<g:FlowPanel styleName='{style.navPanel}'>
				<g:HTML styleName='{style.navTitle}'>Bibliotheek</g:HTML>
				<cl:CellList ui:field='cells'></cl:CellList>
			</g:FlowPanel>
		</g:west>
		<g:center>
			<g:FlowPanel styleName='{style.centerPanel}'>
				<g:HTML styleName='{style.title}' ui:field='title' >Modules voor ....</g:HTML>
				<g:SimplePanel styleName='{style.description}' ui:field='description' />
				<cl:CellList ui:field='tiles'></cl:CellList>
			</g:FlowPanel>
		</g:center>
	</g:DockLayoutPanel>
</ui:UiBinder> 