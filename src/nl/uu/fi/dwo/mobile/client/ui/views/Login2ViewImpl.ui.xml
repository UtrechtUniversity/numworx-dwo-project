<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui" 
	xmlns:mgwt="urn:import:com.googlecode.mgwt.ui.client.widget">
	<ui:with type="nl.uu.fi.dwo.mobile.client.text.Text" field="rb" />
	<ui:with type="java.lang.String" field="back" />
	<ui:style>
	
	.login_text_field {

		width: 300px; 
		
		background-color: #eee;
	
		border: 1px solid #999;
		border-radius: 5px; 
		
		margin:auto !important; 
		display:block !important;
	}
		
	.login_text_field input {
				width: 274px;
				padding: 12px 12px !important;
				background: none;
				color: #000 !important;
 				border: none;
        		outline: none;			
	}
		
	.login_button {
		margin: 30px auto !important;
		width: 276px;
	}
	
	.login_vergeten {
		width: 276px;
	}

	</ui:style>
	<g:FocusPanel ui:field="focusPanel" focus="true">
	<mgwt:LayoutPanel height="100%" width="100%" >
		<!-- Topbar Navigation Area -->
		<mgwt:HeaderPanel >
			<mgwt:center>
				<g:Label ui:field="nav_title" ><ui:text from='{rb.login}'/></g:Label>
			</mgwt:center>
		</mgwt:HeaderPanel>
		<!-- Main interaction Area -->
	  	<g:HTMLPanel>
			<div style="width: 600px; height: 470px; display: block; margin: 20px auto;">
	    	    <img src="images/resources/filogo.png" style="float: left;" />
	    	        <div style="float: left; margin:20px;">
	    	      		<h1><ui:text from='{rb.dwo}'/></h1>
	    	      		<h4><ui:text from='{rb.fi}'/></h4>
	    	      	</div>
	    	   	<div style="clear: both; width: 300px; margin: 10px auto;"><ui:text from='{rb.gebruikersnaam}'/></div>
	    	    <mgwt:MTextBox ui:field="username" addStyleNames="{style.login_text_field}" name="userid"> </mgwt:MTextBox>
	    	    <div style="clear: both; width: 300px; margin: 10px auto;" name="passwd"><ui:text from='{rb.wachtwoord}'/></div>
	    	   
	    	    <mgwt:MPasswordTextBox ui:field="passwd" addStyleNames="{style.login_text_field}"> </mgwt:MPasswordTextBox>	
	    	    <mgwt:Button ui:field="submitbutton" addStyleNames="{style.login_button}" text="{rb.login}"></mgwt:Button>
	    	    <mgwt:Button ui:field="gastbutton" addStyleNames="{style.login_button}" text="{rb.loginAlsGast}"></mgwt:Button>
	    	    <div style="clear: both; width: 300px; margin: 10px auto;"><a href="/dwo/rest/public/user/requestNewPassword?language={rb.locale}&amp;back={back}"><ui:text from='{rb.vergeten}'/></a></div>
	    	   	
	    	</div>	 
	    </g:HTMLPanel>    
	</mgwt:LayoutPanel>
	</g:FocusPanel>

</ui:UiBinder> 