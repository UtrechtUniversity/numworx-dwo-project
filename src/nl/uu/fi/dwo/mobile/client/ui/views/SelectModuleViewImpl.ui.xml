<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui" 
	xmlns:mgwt="urn:import:com.googlecode.mgwt.ui.client.widget">
	<ui:with type="fi.wiskopdr.text.TextConstants" field="rb" />
	<ui:style>
	.outer {
		right: 0px;
		position: absolute !important;
		left: 0px;
		bottom: 0px;
		top: 41px;
		overflow: auto !important;
	}
	.body {
		width: 100%;
		height: 100%;
		position: absolute;
		margin: 0px;
		overflow: hidden;
	}
	.header {
		right: 0px;
		top: 0px;
		left: 0px;
		background-color: #314770;
	}
	.content {
		position: relative;
		width: 100%;
	}
	
	</ui:style>
	<mgwt:LayoutPanel addStyleNames="{style.body}" >
	 
		<!-- Topbar Navigation Area -->
		<mgwt:HeaderPanel ui:field="header" addStyleNames="{style.header}">
		     <mgwt:left>
		    	<mgwt:HeaderButton ui:field="backbutton" backButton="true" ><ui:text from='{rb.terugKnopLabel}'/></mgwt:HeaderButton>
		    </mgwt:left>
			<mgwt:center>
				<g:Label></g:Label>
			</mgwt:center>
		</mgwt:HeaderPanel>
		<!-- Main interaction Area -->
		<g:ScrollPanel ui:field="outer" addStyleNames="{style.outer}">
			<g:VerticalPanel addStyleNames="{style.content}" >
	  			<g:SimplePanel ui:field="description"></g:SimplePanel>    
				<mgwt:CellList ui:field="list" round="true"></mgwt:CellList>
			</g:VerticalPanel>
		</g:ScrollPanel>
	</mgwt:LayoutPanel>

</ui:UiBinder> 