<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui" 
	xmlns:mgwt="urn:import:com.googlecode.mgwt.ui.client.widget">
	<ui:style>
	.fullwidth {
		width: 100%;
	}
	</ui:style>
	<mgwt:LayoutPanel height="100%" width="100%" >
	 
		<!-- Topbar Navigation Area -->
		<mgwt:HeaderPanel ui:field="header">
		     <mgwt:left>
		    	<mgwt:HeaderButton ui:field="backbutton" backButton="true" >Terug</mgwt:HeaderButton>
		    </mgwt:left>
			<mgwt:center>
				<g:Label>Selecteer activiteit</g:Label>
			</mgwt:center>
		</mgwt:HeaderPanel>
		<!-- Main interaction Area -->
		<mgwt:ScrollPanel>
			<g:VerticalPanel addStyleNames="{style.fullwidth}" >
	  			<g:SimplePanel ui:field="description"></g:SimplePanel>    
				<mgwt:CellList ui:field="list" round="true"></mgwt:CellList>
			</g:VerticalPanel>
		</mgwt:ScrollPanel>
	</mgwt:LayoutPanel>

</ui:UiBinder> 