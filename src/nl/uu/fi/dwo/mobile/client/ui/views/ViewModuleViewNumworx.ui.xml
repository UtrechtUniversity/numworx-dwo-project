<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:v="nl.uu.fi.dwo.mobile.client.ui.views"
	xmlns:g="urn:import:com.google.gwt.user.client.ui">
	<ui:with field="pfx" type="java.lang.String" />
	<ui:style>
	@def color15 #314770;
	@def color10 #E4F2FB;
	@def color12 #AAC1DC;
	@def color13 #7297C7;
	@def color14 #1B75BB;
	@def medium 500;
	@def regular 400;
	
	.rootPanel {
		width: 100%;
		height: 100%;
	}

	.headerPanel {
		background-color: color10;
		height: 90px;
	}
	
	.headerTop {
		background-color: color15;
		height: 50px;
		color: color13;
	}
	.headerBottom {
		background-color: white;
		height: 40px;
		box-shadow: 0px 2px 2px color15 inset;
	}
	.centerPanel {
		background-color: color10;
	}
	.numworx {
		height:30px;
		margin-top: 14px;
		margin-left: 20px;
		margin-right: 20px;
		width: 140px;
		display: inline-block;
		vertical-align: top;
	}
	.kruimels {
		font-family: Ubuntu;
		color: color13;
		font-size: 16px;
		font-weight: medium;
		margin-top: 18px;
		display: inline-block;
	}
	.kruimels a {
		font-family: Ubuntu;
		font-weight: medium;
		color: color13 !important;
	}

		.nav {
			float: right;
			display: inline-block;
			margin-top: 10px;
			color: color13;
			margin-right: 10px;
			cursor: pointer;
		}
		.loginname {
			float: right;
			display:inline-block;
			margin-top: 18px;
			color: color13;
			font-size: 13px;
			font-family: "Ubuntu" !important;
			font-weight: medium;
		}
		.menu {
			float: right;
			display: inline-block;
			margin-top: 8px;
			margin-right: 22px;
			margin-left: 5px;
			background: initial !important; /* not IE */
			background: inherit !important; /* IE */
			border: initial !important; /* not IE */
			border-style: none !important; /* IE */
		}
		.menuItem {
			color: color13 !important;
			font-size: 13px;
		}	
	
		.title {
			color: color14;
			font-family: Ubuntu;
			font-weight: medium;
			font-size: 13px;
			display: inline-block;
			position: absolute;
			left: 132px;
			bottom: 18px;
		}
		.knop {
			color: white;
			background-color: color12;
			font-family: Ubuntu;
			font-size: 12px;
			font-weight: bold;
			display: inline-block;
			margin-left: 22px;
			padding-left: 10px;
			margin-top: 8px;
			padding-top: 2px;
			padding-right:10px;
		}
		.icon {
			height: 34px;
			vertical-align:top;
			margin-left: -7px;
			margin-top: 5px;
		}
		.hide {
			display:none;
		}
		
	</ui:style>
	<g:DockLayoutPanel unit='PX' styleName='{style.rootPanel}'>
		<g:north size="90">
			<g:FlowPanel styleName='{style.headerPanel}'>
			  <g:FlowPanel styleName='{style.headerTop}' >
			  	<g:FlowPanel styleName='{style.numworx}'><g:Image url="{pfx}images/numworx/logo-Numworx-grijs.svg"></g:Image></g:FlowPanel>
			  	<g:HTML styleName='{style.kruimels}'><a href="#TreeModulePlace:0">VWO/HAVO 2,3</a> &gt; <a href="#TreeModulePlace:0">Module Formules en grafieken</a></g:HTML>
				<g:MenuBar addStyleNames='{style.menu}'>
					<g:MenuItem ui:field='user' addStyleNames='{style.menuItem}' />
				</g:MenuBar>
				<g:Label ui:field='loginLabel' styleName='{style.loginname}'>Jolanda van den Berg</g:Label>
				<g:FlowPanel styleName='{style.nav}'><g:Image url='{pfx}images/numworx/fullscreen-numworx.svg'/></g:FlowPanel>
				<g:FlowPanel styleName='{style.nav}'><g:Image url='{pfx}images/numworx/ster-grijs-numworx.svg'/></g:FlowPanel>
				<g:FlowPanel ui:field='homeBtn' styleName='{style.nav}'><g:Image url='{pfx}images/numworx/home-numworx.svg'/></g:FlowPanel>
			  </g:FlowPanel>
			  <g:FlowPanel styleName='{style.headerBottom}' >
			  		<g:Label styleName='{style.knop}' addStyleNames='{style.hide}' >ZELFTOETS</g:Label>
			  		<g:Image styleName='{style.icon}' addStyleNames='{style.hide}' url="{pfx}images/numworx/zelftoets-numworx.svg"/>
			  		<g:Label styleName='{style.knop}'>LESSTOF</g:Label>
			  		<g:Image styleName='{style.icon}' url='{pfx}images/numworx/lesstof-numworx.svg' />
			  		<g:Label styleName='{style.title}'>Hypotheses en betrouwbaarheidsintervallen (activiteit)</g:Label>
				</g:FlowPanel>
			</g:FlowPanel>
		</g:north>
		<g:center>
			<g:SimplePanel ui:field='center' styleName='{style.centerPanel}'>
			</g:SimplePanel>
		</g:center>
		
	</g:DockLayoutPanel>
</ui:UiBinder> 