<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:v="nl.uu.fi.dwo.mobile.client.ui.views"
	xmlns:g="urn:import:com.google.gwt.user.client.ui">
	<ui:with field="pfx" type="java.lang.String" />
	<ui:style field='t' src='TreeModuleViewNumworx.css' type='nl.uu.fi.dwo.mobile.client.ui.views.TreeModuleViewNumworxCss' />
	<ui:style>
	@def color15 #314770;
	@def color10 #E4F2FB;
	@def color12 #AAC1DC;
	@def color13 #7297C7;
	@def color14 #1B75BB;
	@def medium 500;
	@def regular 400;
	
	.headerPanel {
		background-color: color10;
		height: 90px;
	}
	
	.headerTop {
		background-color: color15;
		height: 50px;
		color: color13;
	}
	.headerBottom {
		background-color: white;
		height: 40px;
		box-shadow: 0px 2px 2px color15 inset;
	}
	.centerPanel {
		background-color: color10;
	}
	.kruimels {
		font-family: Ubuntu;
		color: color13;
		font-size: 13px;
		font-weight: medium;
		margin-top: 18px;
		display: inline-block;
	}
	.kruimels a {
		font-family: Ubuntu;
		font-weight: medium;
		color: color13 !important;
	}
	
		.title {
			color: color14;
			font-family: Ubuntu;
			font-weight: medium;
			font-size: 13px;
			display: inline-block;
			position: absolute;
			left: 132px;
			bottom: 18px;
		}
		.knop {
			color: white;
			background-color: color12;
			font-family: Ubuntu;
			font-size: 12px;
			font-weight: bold;
			display: inline-block;
			margin-left: 22px;
			padding-left: 10px;
			margin-top: 8px;
			padding-top: 2px;
			padding-right:10px;
		}
		.icon {
			height: 34px;
			vertical-align:top;
			margin-left: -7px;
			margin-top: 5px;
		}
		.hide {
			display:none;
		}
		
	</ui:style>
	<g:DockLayoutPanel unit='PX' styleName='{t.rootPanel}'>
		<g:north size="90">
			<g:FlowPanel styleName='{style.headerPanel}'>
			  <g:FlowPanel styleName='{style.headerTop}' >
			  	<g:FlowPanel styleName='{t.numworx}'><g:Image url="{pfx}images/numworx/logo-Numworx-grijs2.svg"></g:Image></g:FlowPanel>
			  	<g:HTML ui:field='kruimels' styleName='{style.kruimels}'><a href="#TreeModulePlace:0">VWO/HAVO 2,3</a> &gt; <a href="#TreeModulePlace:0">Module Formules en grafieken</a></g:HTML>
				<g:MenuBar addStyleNames='{t.menu}'>
					<g:MenuItem ui:field='user' addStyleNames='{t.menuItem}' />
				</g:MenuBar>
				<g:Label ui:field='loginLabel' styleName='{t.loginname}'>Jolanda van den Berg</g:Label>
<!-- 				<g:ToggleButton ui:field='fullBtn' styleName='{t.nav}'> -->
<!-- 					<g:upFace><img src='{pfx}images/numworx/fullscreen-numworx.svg'></img></g:upFace> -->
<!-- 					<g:downFace><img src='{pfx}images/numworx/borderdscreen-numworx.svg'/></g:downFace> -->
<!-- 				</g:ToggleButton> -->
<!-- 				<g:FocusPanel styleName='{t.nav}'><g:Image url='{pfx}images/numworx/ster-grijs-numworx.svg'/></g:FocusPanel> -->
<!-- 				<g:ToggleButton ui:field='fullBtn' styleName='{t.nav}'> -->
<!-- 					<g:upFace><img src='{pfx}images/numworx/fullscreen-numworx.svg'></img></g:upFace> -->
<!-- 					<g:downFace><img src='{pfx}images/numworx/borderdscreen-numworx.svg'/></g:downFace> -->
<!-- 				</g:ToggleButton> -->
<!-- 				<g:FocusPanel styleName='{t.nav}'><g:Image url='{pfx}images/numworx/ster-grijs-numworx.svg'/></g:FocusPanel> -->
				<g:FocusPanel ui:field='upBtn' styleName='{t.nav}'>
					<g:InlineHTML><i class='fa fa-2x fa-arrow-up' style='color:#798291'></i></g:InlineHTML>
				</g:FocusPanel>
				<g:FocusPanel ui:field='homeBtn' styleName='{t.nav}'><g:Image url='{pfx}images/numworx/home-numworx.svg'/></g:FocusPanel>
			  </g:FlowPanel>
			  <g:FlowPanel styleName='{style.headerBottom}' >
			  		<g:Label styleName='{style.knop}' addStyleNames='{style.hide}' >ZELFTOETS</g:Label>
			  		<g:Image styleName='{style.icon}' addStyleNames='{style.hide}' url="{pfx}images/numworx/zelftoets-numworx.svg"/>
			  		<g:Label styleName='{style.knop}'>LESSTOF</g:Label>
			  		<g:Image styleName='{style.icon}' url='{pfx}images/numworx/lesstof-numworx.svg' />
			  		<g:Label ui:field='title' styleName='{style.title}'>Hypotheses en betrouwbaarheidsintervallen (activiteit)</g:Label>
				</g:FlowPanel>
			</g:FlowPanel>
		</g:north>
		<g:center>
			<g:SimplePanel ui:field='center' styleName='{style.centerPanel}'>
			</g:SimplePanel>
		</g:center>
		
	</g:DockLayoutPanel>
</ui:UiBinder> 