<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui" 
	xmlns:mgwt_tabbar="urn:import:com.googlecode.mgwt.ui.client.widget.tabbar"
	xmlns:mgwt="urn:import:com.googlecode.mgwt.ui.client.widget"
	xmlns:dwo="urn:import:nl.uu.fi.dwo.mobile.client.ui"
	>
	<ui:style>
		.important {
		font-weight: bold;
		}

		.example_area {
			background-color: #F1F0F0;
		}

		.split_left_area {
			
			width: 300px !important;
			
			border-right:1px solid  #000;
			float: left;
			background-color: #F1F0F0;
			color: #314770;

			position:absolute;
			left:0px;
	
	
			
		}

		.navigation_center_header {
				width: 260px;
				min-width: 260px;
				margin-left: -100px;
				margin-top: 8px;
				color: #758296;
		}
		
		.navigate_area_title {
			color: #314770;
			font-size: 18px;
			position: absolute !important; 
			top:    41px;
			bottom: 0px;
			left:   0px;
			right:  0px;
			margin-left:22px;
			margin-top: 30px;
		}
		
		.module_center_header {
				width: 360px;
				min-width: 360px;
				margin-left:-300px;
				margin-top: 8px;
				color: #758296;
		}

		.navigation_header_panel {
				background-color: #314770;
				color: #758296;
		}
		
		.module_header_panel {
				width: auto;
				background-color: #314770;
				color: #758296;
		}
		
		.split_right_area {
				width:auto;
				height:auto;
				color: #758296;
				position:absolute;
				
				left:300px;	
				top: 0px;
				right:0px;
				bottom:0px;
				background-color: #D1E3F3;
		}
		.tree_area {
			position: absolute !important; 
			top:    101px;
			bottom: 0px;
			left:   0px;
			width: 300px;
		}
		
		.decorate_area_module {
			position: absolute !important; 
			top:    40px;
			bottom: 0px;
			left:   0px;
			right:  0px;
			background-image: url(images/resources/gradient.png);
		}
		
		.container_area {
			position: absolute !important; 
			top:    41px;
			bottom: 0px;
			left:   0px;
			right:  0px;
			color: #758296;
			
		}	
	</ui:style>
	   <mgwt:LayoutPanel height="100%" width="100%" >
		
		<!-- Navigation Area -->
		<mgwt:LayoutPanel  ui:field="navigationPanel" addStyleNames="{style.split_left_area}" height="100%" >
		
			<mgwt:HeaderPanel ui:field="navigationHeaderPanel" addStyleNames="{style.navigation_header_panel}">
		      	<mgwt:left>
		    		<mgwt:HeaderButton ui:field="navigationBackButton" backButton="true" >Logout</mgwt:HeaderButton>
		    	</mgwt:left>
				<mgwt:center>
					 <g:HTMLPanel addStyleNames="{style.navigation_center_header}">
							<g:Label ui:field="navigationLabel"></g:Label>
					</g:HTMLPanel>
				</mgwt:center>
			</mgwt:HeaderPanel>
			<g:Label addStyleNames="{style.navigate_area_title}">Bibliotheek</g:Label>
  			<g:ScrollPanel alwaysShowScrollBars="true" addStyleNames="{style.tree_area}" >
				<g:Tree ui:field="tree"></g:Tree>
			</g:ScrollPanel>
			
		</mgwt:LayoutPanel>
		
			
		
		<!-- Module Area -->
		<mgwt:LayoutPanel  ui:field="modulePanel" addStyleNames="{style.split_right_area}" height="100%" >
			<mgwt:HeaderPanel ui:field="moduleHeaderPanel" addStyleNames="{style.module_header_panel}">
				<mgwt:left>
			   		<mgwt:HeaderButton ui:field="moduleBackButton">	</mgwt:HeaderButton>
			    </mgwt:left>
			  	<mgwt:center>
					 		<g:Label ui:field="moduleHeaderLabel" addStyleNames="{style.module_center_header}"></g:Label>
					</mgwt:center>  
				
			</mgwt:HeaderPanel>
			<g:SimplePanel ui:field="container" addStyleNames="{style.container_area}">
			 <g:SimplePanel ui:field="containerdecorator" addStyleNames="{style.decorate_area_module}"></g:SimplePanel>
			
			</g:SimplePanel>
	    </mgwt:LayoutPanel>
	 </mgwt:LayoutPanel>


</ui:UiBinder> 