<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui" 
	xmlns:mgwt_tabbar="urn:import:com.googlecode.mgwt.ui.client.widget.tabbar"
	xmlns:mgwt="urn:import:com.googlecode.mgwt.ui.client.widget"
	xmlns:dwo="urn:import:nl.uu.fi.dwo.mobile.client.ui"
	>
	<ui:style>
		.important {
		font-weight: bold;
		}

		.example_area {
			background-color: #eee;
		}

			.split_left_area {
			
			width: 350px;
			
			border-right:1px solid  #000;
			float: left;
			background-color: #b4d1e8;
			

			position:absolute;
			left:0px;
	
	
			
		}

		.navigation_center_header {
				width: 260px;
				min-width: 260px;
				margin-left: -100px;
				margin-top: 8px;
		
		}

		.split_right_area {
				width:auto;
				height:auto;

	
				position:absolute;
				
				left:350px;	
				top: 0px;
				right:0px;
				bottom:0px;
		}

	.cells_area {
		z-index: -1;
	}
		
	</ui:style>
	   <mgwt:LayoutPanel height="100%" width="100%" >
		
		<!-- Navigation Area -->
		<mgwt:LayoutPanel  ui:field="navigationPanel" addStyleNames="{style.split_left_area}" height="100%" >
		
			<mgwt:HeaderPanel ui:field="navigationHeaderPanel" >
		      	<mgwt:left>
		    		<mgwt:HeaderButton ui:field="navigationBackButton" backButton="true" >Logout</mgwt:HeaderButton>
		    	</mgwt:left>
				<mgwt:center>
					 <g:HTMLPanel addStyleNames="{style.navigation_center_header}">
							<g:Label ui:field="navigationLabel">Modules</g:Label>
					</g:HTMLPanel>
				</mgwt:center>
			</mgwt:HeaderPanel>
  				<mgwt:ScrollPanel>
					<g:Tree ui:field="tree"> </g:Tree>
				</mgwt:ScrollPanel>
			
		</mgwt:LayoutPanel>
		
		
		<!-- Module Area -->
		<mgwt:LayoutPanel  ui:field="modulePanel" addStyleNames="{style.split_right_area}" height="100%" >
			<mgwt:HeaderPanel ui:field="moduleHeaderPanel" >
				<mgwt:left>
			   		<mgwt:HeaderButton ui:field="moduleBackButton">	</mgwt:HeaderButton>
			    </mgwt:left>
			    <mgwt:center>
					<g:Label>Modules</g:Label>
				</mgwt:center>
			</mgwt:HeaderPanel>
		
			
				<g:SimplePanel ui:field="container"></g:SimplePanel>
				<mgwt:CellList ui:field="cells" round="true" addStyleNames="{style.cells_area}"></mgwt:CellList>
			
   
	    </mgwt:LayoutPanel>
	 </mgwt:LayoutPanel>


</ui:UiBinder> 