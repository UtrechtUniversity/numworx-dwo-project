<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui">
	<ui:style>
	.nooutline {
	}
	.nooutline:focus {
		outline-style: none;
	}
	</ui:style>
	<g:LayoutPanel ui:field='fp' >
		<g:layer height="40px" top='0'>
			<g:SimplePanel ui:field='headerView'/>
		</g:layer>
		<g:layer height="100px" bottom='0' >
			<g:SimpleLayoutPanel ui:field='statusView' />
		</g:layer>
		<g:layer top='40px' bottom='100px' >
			<g:SimplePanel stylePrimaryName="contentScrollPanel" ui:field='contentScrollPanel'>		 
				<g:FlowPanel
					stylePrimaryName="contentPanel"
					ui:field="content"
				 />
			</g:SimplePanel>
		</g:layer>
		<g:layer bottom='3.5em' height='2em' left='1em' width='4em' >
			<g:Label ui:field="kbd" />
		</g:layer>
	</g:LayoutPanel>
</ui:UiBinder> 