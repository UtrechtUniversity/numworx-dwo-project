<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui">
	<ui:style>
	.nooutline {
	}
	.nooutline:focus {
		outline-style: none;
	}
	</ui:style>
	<g:DockLayoutPanel ui:field='fp' unit='PX' >
		<g:north size="40">
			<g:SimplePanel ui:field='headerView'/>
		</g:north>
		<g:south size="100">
			<g:SimplePanel ui:field='statusView' />
		</g:south>
		<g:center>
			<g:FocusPanel stylePrimaryName="contentScrollPanel" ui:field='contentScrollPanel'>
				<g:FlowPanel
					stylePrimaryName="contentPanel"
					ui:field="content"
				 />
			</g:FocusPanel>
		</g:center>
	</g:DockLayoutPanel>
</ui:UiBinder> 