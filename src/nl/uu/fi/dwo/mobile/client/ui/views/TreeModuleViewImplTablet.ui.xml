<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui" 
	xmlns:mgwt_tabbar="urn:import:com.googlecode.mgwt.ui.client.widget.tabbar"
	xmlns:mgwt="urn:import:com.googlecode.mgwt.ui.client.widget"
	xmlns:dwo="urn:import:nl.uu.fi.dwo.mobile.client.ui"
	>
	<ui:style>
		.important {
		font-weight: bold;
		}

		.example_area {
			background-color: #eee;
		}
		.split_left_area {
			
			width: 350px !important;
			
			border-right:1px solid  #000;
			float: left;

			background-color: #b4d1e8;
			

			position:absolute;
			left:0px;
		
	
			
		}

		.info_area {
 				padding: 0px;
    			height: auto;
    			width: auto;
   			 	max-height: 50%;
    			border: 1px solid #abadb0;
    			overflow: scroll;
		}
		
		.navigation_center_header {
				width: 270px;
				min-width: 270px;
				margin-left: -122px;
				margin-top: 8px;
		
		}
		.split_right_area {
				width:auto;
				height:auto;

				background-color: #FFFFFF;
				
				position:absolute;
				
				left:350px;	
				top: 0px;
				right:0px;
				bottom:0px;
		}
		
		.module_container{
				width:auto;
				height:auto;
		}


		.loading_area {

   		 	background-color: gray;
    		opacity: .5;
    		left: 0;
   			bottom: 0;
    		right: 0;
    		top: 40px;
    		position: absolute;			
		}

		.full_screen_toggle {
			position: absolute;
			height:auto;
			width:auto;
			bottom:40px;
			right:0px;

		}
		
			
		
	</ui:style>
	
	   <mgwt:LayoutPanel height="100%" width="100%" >

		<!-- Interaction Area -->
		<g:HTMLPanel>
		
			    
				<mgwt:LayoutPanel  ui:field="navigationPanel" addStyleNames="{style.split_left_area}" height="100%"  >
				  <!-- Topbar Navigation Area -->
					<mgwt:HeaderPanel ui:field="navigationHeaderPanel" >
		     			 <mgwt:left>
		     			   <mgwt:HeaderButton  ui:field="navigationBackButton" backButton="true" >Back</mgwt:HeaderButton>
		    			</mgwt:left>
						<mgwt:center>
						      <g:HTMLPanel addStyleNames="{style.navigation_center_header}">
								<g:Label ui:field="navigationLabel"  >Modules</g:Label>
							</g:HTMLPanel>
						</mgwt:center>
						<mgwt:right>
						    <mgwt:HeaderButton ui:field="navigationUpButton" >Up</mgwt:HeaderButton>
						</mgwt:right>
					</mgwt:HeaderPanel>
					 <mgwt:LayoutPanel ui:field="infoArea" addStyleNames="{style.info_area}"> </mgwt:LayoutPanel>
				   	<mgwt:ScrollPanel ui:field="cellPanel">
						 <mgwt:CellList ui:field="cells" round="true"></mgwt:CellList>
				   </mgwt:ScrollPanel>
				</mgwt:LayoutPanel>

							
			    <mgwt:LayoutPanel ui:field="modulePanel" addStyleNames="{style.split_right_area}" >
			       <mgwt:HeaderPanel ui:field="moduleHeaderPanel" >
		     			 <mgwt:left>
		     			      <mgwt:HeaderButton ui:field="moduleBackButton">	
		    				  </mgwt:HeaderButton>
		    				
		    			</mgwt:left>
		    			
						<mgwt:center>
						  
								<g:Label>Modules</g:Label>
							
						</mgwt:center>
					</mgwt:HeaderPanel>
			
			       		
						<mgwt:LayoutPanel ui:field="container"  addStyleNames="{style.module_container}"></mgwt:LayoutPanel>
 					
							
					    <g:HTMLPanel ui:field="loadingArea" addStyleNames="{style.loading_area}"> 
					    	<span class="fa fa-4x fa-spinner fa-spin" style=" top: 50%; left: 50%; position: absolute;"></span>    
					    </g:HTMLPanel>
					        
					  
				
			        
			    </mgwt:LayoutPanel>
		    	  
		</g:HTMLPanel>
	    
	    </mgwt:LayoutPanel>
	



</ui:UiBinder> 