<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui" 
	xmlns:mgwt_tabbar="urn:import:com.googlecode.mgwt.ui.client.widget.tabbar"
	xmlns:mgwt="urn:import:com.googlecode.mgwt.ui.client.widget"
	xmlns:dwo="urn:import:nl.uu.fi.dwo.mobile.client.ui"
	>
	<ui:style>
		.important {
		font-weight: bold;
		}

		.example_area {
			background-color: #eee;
		}
		.split_left_area {
			width:auto;
			min-width: 200px;
			
			border-right:1px solid  #000;
			float: left;
			background-color: #b4d1e8;


			padding: 0px 10px 0px 10px; 
			
			display: flex;
			
			
		}
		@if user.agent gecko1_8  {
			.split_right_area {
					width:auto;
					padding: 0px 10px 0px 10px; 
					display: inherit;
					overflow:scroll;
			}
			
		} @else  {
			.split_right_area {
					width:auto;
					padding: 0px 10px 0px 10px; 
					overflow:scroll;	
			}
		}
		
	</ui:style>
	
	   <mgwt:LayoutPanel height="100%" width="100%" >
		<!-- Topbar Navigation Area -->
		<mgwt:HeaderPanel ui:field="headerPanel" >
		      <mgwt:left>
		    	<mgwt:HeaderButton ui:field="backButton" backButton="true" >Terug</mgwt:HeaderButton>
		    </mgwt:left>
			<mgwt:center>
				<g:Label>Modules</g:Label>
			</mgwt:center>
		</mgwt:HeaderPanel>
		<!-- Interaction Area -->
		<g:HTMLPanel>
			<div style="width: 100%; height:100%; position: absolute;">
				<mgwt:LayoutPanel addStyleNames="{style.split_left_area}" height="100%"  >
				    
				    <g:Tree ui:field="tree"> </g:Tree>
				</mgwt:LayoutPanel>
			
			    <mgwt:LayoutPanel addStyleNames="{style.split_right_area}" >
			        	<g:SimplePanel ui:field="container"></g:SimplePanel>
			        	<mgwt:CellList ui:field="cells" round="true"></mgwt:CellList>
			     </mgwt:LayoutPanel>
			     
			    <div style="clear: both;"></div>
		    </div> 
		
		  
		  
		</g:HTMLPanel>
	    
	    </mgwt:LayoutPanel>
	



</ui:UiBinder> 