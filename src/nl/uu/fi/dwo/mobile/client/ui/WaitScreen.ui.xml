<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui">
	<ui:style>
	.important {
   		 	background-color: gray;
    		opacity: .5;
    		width: 100%;
    		height: 100%;
 	}
	</ui:style>
	<g:HTMLPanel addStyleNames="{style.important}">
		<span class="fa fa-4x fa-spinner fa-spin" style=" top: 50%; left: 50%; position: absolute;"></span>
	</g:HTMLPanel>
</ui:UiBinder> 