<!--   <inherits name="fi.algebraexprgwt.AlgebraExprGWT-DWO" /> -->
<!--  <inherits name="fi.algebrapijlengwt.AlgebraPijlenGWT-DWO" />  -->
<!--  <inherits name="fi.doorziengwt.DoorzienGWT-DWO" /> -->
<!--   <inherits name="fi.geomalggwt.GeomAlgGWT-DWO" /> -->
<!-- --> <inherits name="fi.graphtoolgwt.GraphToolGWT-DWO" />
<!--  <inherits name="fi.kladjegwt.KladjeGWT-DWO" /> -->
<!-- <inherits name="fi.draaibankgwt.DraaibankGWT-DWO" /> -->
<!-- <inherits name="fi.statsimgwt.StatSimGWT"/> -->
<!--  <inherits name="fi.nabouwenaanzichtengwt.NabouwenAanzichtenGWT-DWO" /> -->
     

  <inherits name="com.google.gwt.xml.XML"/> 
  <inherits name="com.google.gwt.http.HTTP"/> 
  <inherits name="fi.wiskopdr.WiskOpdr"/>
  <inherits name="fi.dwo.gwt.lib.rest.DWO-gwt-lib"/>
  <inherits name="nl.uu.fi.dwo.rest.DWO-rest-lib"/>
  <inherits name="nl.uu.fi.dwo.account.Account-DWO" />
  
<!-- Only run test on safari, this speeds up the unit testing, should not be included in release-trunk -->
<!--  <set-property name="user.agent" value="safari" /> -->

  
	
  <!-- Specify the paths for translatable code                    -->
  <source />
  <entry-point class='nl.uu.fi.dwo.mobile.DWO2player'/>

  
   <!-- Use ClientFactoryImpl by default -->
    <replace-with class="nl.uu.fi.dwo.ui.ClientFactoryImpl">
    <when-type-is class="nl.uu.fi.dwo.ui.ClientFactory"/>
    </replace-with>

<!-- Welke scorm wil je hebben? Scorm2004, LTI?, QTI? Noordhoff API, DWO-Scorm-1.2, etc... -->    

<!--  <replace-with class="nl.uu.fi.dwo.mobile.client.sco.LocalStorage"> -->

    <replace-with class="nl.uu.fi.dwo.mobile.client.sco.SCORM_guest">
    	<when-type-is class="nl.uu.fi.dwo.mobile.client.sco.Scorm2004IF"/>
    </replace-with>
    
    <replace-with class="nl.uu.fi.dwo.mobile.client.DWOIdeasClient">
    	<when-type-is class="nl.uu.fi.dwo.ideas.client.IdeasIF" />
    </replace-with>
    
    <replace-with class="nl.uu.fi.dwo.mobile.client.DWO2playerDefaults">
        <when-type-is class="nl.uu.fi.dwo.mobile.client.DWOplayerParameters" />
    </replace-with>
    
    <replace-with class="nl.uu.fi.dwo.mobile.client.DWOIdeasClient" >
    	<when-type-is class="fi.wiskopdr.FailingIdeas" />
    </replace-with>
    
    <replace-with class="nl.uu.fi.dwo.mobile.client.DWO2playerDefaults">
    	<when-type-is class="fi.dwo.gwt.lib.rest.DwoConstants" />
    </replace-with>
    
    
<!-- Logging TRUE/FALSE FINEST/.../SEVERE -->   
    <set-property name="gwt.logging.logLevel" value="WARNING"/>
    <set-property name="gwt.logging.enabled" value="TRUE"/>

<inherits name="com.google.gwt.activity.Activity" />

<!-- English language, independent of country -->
  	<extend-property name="locale" values="en"/>
    <extend-property name="locale" values="nl"/> 	
    <extend-property name="locale" values="fr"/> 	
 <!--
    <extend-property name="locale" values="de"/> 	
    <extend-property name="locale" values="es"/> 	
    <extend-property name="locale" values="gr"/> 	
-->
