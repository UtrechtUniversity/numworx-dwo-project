<?xml version="1.0" encoding="UTF-8"?>
<module rename-to='DWOplayer'>
  <!-- Inherit the core Web Toolkit stuff.                        -->
  <inherits name='com.google.gwt.user.User'/>

  <!-- Inherit the default GWT style sheet.  You can change       -->
  <!-- the theme of your GWT application by uncommenting          -->
  <!-- any one of the following lines.                            -->
  <!--   <inherits name='com.google.gwt.user.theme.clean.Clean'/> -->
  <!-- <inherits name='com.google.gwt.user.theme.standard.Standard'/> -->
  <!-- <inherits name='com.google.gwt.user.theme.chrome.Chrome'/> -->
  <!-- <inherits name='com.google.gwt.user.theme.dark.Dark'/>     -->

  <!-- Other module inherits                                      -->

  <!-- Specify the app entry point class.                         -->

  <inherits name="com.googlecode.mgwt.MGWT"/>
   <inherits name="com.fredhat.gwt.xmlrpc.XMLRPC" />
   <inherits name="com.bouwkamp.gwt.user.User" />
   <inherits name="lx.interaction.DollarOne" />
   <inherits name="nl.uu.fi.dwo.interaction.Interaction" />
   


  <inherits name="com.google.gwt.xml.XML"/> 
   <inherits name="com.google.gwt.http.HTTP"/> 
  <inherits name="fi.wiskopdr"/>
    
<!--<set-property name="user.agent" value="gecko1_8" /> -->

  
  <!--<entry-point class='nl.uu.fi.dwo.mobile.DWOplayer'/>-->
  <entry-point class='nl.uu.fi.dwo.mobile.client.ui.views.ViewModuleViewImpl'/>

  <!-- Specify the paths for translatable code                    -->
  <source path='client'/>
  <source path='shared'/>
  
   <!-- Use ClientFactoryImpl by default -->
    <replace-with class="nl.uu.fi.dwo.ui.ClientFactoryImpl">
    <when-type-is class="nl.uu.fi.dwo.ui.ClientFactory"/>
    </replace-with>
<source ></source>


<inherits name="com.google.gwt.activity.Activity" />
</module>
