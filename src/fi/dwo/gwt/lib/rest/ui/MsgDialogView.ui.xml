<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui" 
>
    <ui:with field="dwoStyle" type='fi.dwo.gwt.lib.rest.css.DwoStyle' />
    <ui:with type="nl.uu.fi.dwo.rest.locale.DwoLocalesForGWT" field="rb" />
    <g:FlowPanel addStyleNames='{dwoStyle.dwoDialogPanel}'>
                <g:HTML ui:field="htmlText" > </g:HTML>
                <g:Button  addStyleNames="{dwoStyle.dwoButton}"  ui:field="okButton"><ui:text from="{rb.GUI_BTN_Ok}" /></g:Button>
    </g:FlowPanel>
</ui:UiBinder> 