<?xml version="1.0" encoding="utf-8"?> 
<jnlp spec="1.0+" codebase="http://localhost:8080/dwo2/" href="localWebStart.jnlp">
	<information>
		<title>DWO Application</title>
		<vendor>Freudenthal institute</vendor>
		<homepage href="http://localhost:8080/dwo2" />
		<description>local host testing</description>
	</information>
	<security>
		<all-permissions/>
	</security>
        <update check="timeout" policy="always"/>
	<resources>
		<j2se version="1.8+" />
		<jar href="jars/DWOJApplet.jar" />
                <property name="httpAuthentication" value="httpAuthentication=BASIC"/>
                <property name="serverUrlPath" value="http://dummytwo.dwo.nl/dwo/"/>
                <property name="jarUrlPath" value="https://dummytwo.dwo.nl/dwo/jars"/>
                <property name="resourceUrlPath" value="https://dummytwo.dwo.nl/dwo/resources"/>
	</resources>
	<application-desc main-class="fi.dwo.dwojapplet.domain.DWO" />
</jnlp>