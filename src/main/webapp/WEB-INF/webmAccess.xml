<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE web-app
    PUBLIC "-//Sun Microsystems, Inc.//DTD Web Application 2.3//EN"
    "http://java.sun.com/dtd/web-app_2_3.dtd">

<web-app>
   <filter>
    <filter-name>JAMonFilter</filter-name>
    <filter-class>com.jamonapi.JAMonFilter</filter-class>
  </filter>

  <filter-mapping>
    <filter-name>JAMonFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>
  
  <!-- Servlets -->
  <servlet>
    <servlet-name>DWOmAcces</servlet-name>
  	<servlet-class>fi.servlet.dwomaccess.DWOmAccess</servlet-class>
  </servlet>
  <servlet>
  	<servlet-name>dbaccess</servlet-name>
  	<servlet-class>fi.servlet.dwomaccess.DbAccessServlet</servlet-class>
  </servlet>
  <servlet>
  	<servlet-name>scormaccess</servlet-name>
  	<servlet-class>fi.servlet.dwomaccess.ScormAccess</servlet-class>
  </servlet>
    <servlet>
      <servlet-name>dwoparam</servlet-name>
      <jsp-file>/lti/dwo.jsp</jsp-file>
    </servlet>
   <servlet-mapping>
      <servlet-name>dwoparam</servlet-name>
      <url-pattern>/lti/dwo.jsp/*</url-pattern>
   </servlet-mapping>
  
  <servlet-mapping>
	<servlet-name>DWOmAcces</servlet-name>
	<url-pattern>/image.png</url-pattern>
  </servlet-mapping>
   <servlet-mapping>
	<servlet-name>DWOmAcces</servlet-name>
	<url-pattern>/partialScore</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
	<servlet-name>DWOmAcces</servlet-name>
	<url-pattern>/getLaunchData</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
	<servlet-name>DWOmAcces</servlet-name>
	<url-pattern>/getJSONLaunchData</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
	<servlet-name>DWOmAcces</servlet-name>
	<url-pattern>/getJSONLaunchDataBytes</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
	<servlet-name>DWOmAcces</servlet-name>
	<url-pattern>/getCourseDescription</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
  	<servlet-name>dbaccess</servlet-name>
  	<url-pattern>/dbaccess</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>scormaccess</servlet-name>
    <url-pattern>/scormaccess</url-pattern>
  </servlet-mapping>
  <!-- Default page to serve -->
	<welcome-file-list>
    <welcome-file>index.html</welcome-file>
  </welcome-file-list>

</web-app>
