<?xml version="1.0" encoding="UTF-8"?>
<web-app version="3.0" xmlns="http://java.sun.com/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://www.oracle.com/webfolder/technetwork/jsc/xml/ns/javaee/web-app_3_0.xsd">
    <display-name>DWOServer</display-name>
    <session-config>
        <session-timeout>
            30
        </session-timeout>
    </session-config>
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
    <!-- Allow the web application to be distributed across a Tomcat cluster -->
    <distributable/>
    <!-- Tomcat resource connection for the DWO database server -->
    <resource-ref>
        <description>DWO DB Connection</description>
        <res-ref-name>jdbc/dwodb</res-ref-name>
        <res-type>javax.sql.DataSource</res-type>
        <res-auth>Container</res-auth>
    </resource-ref>
    <filter>
    	<filter-name>xss</filter-name>
    	<filter-class>fi.dwo.server.xss.XSSFilter</filter-class>
    </filter>
    <filter-mapping>
    	<filter-name>xss</filter-name>
    	<url-pattern>/*</url-pattern>
    </filter-mapping>
    
    <!-- Servlets -->
    <servlet>
        <description>Servlet voor het genereren van de dwo.html paginaServlet voor het genereren van de dwo.html pagina</description>
        <servlet-name>DwoWebPage</servlet-name>
        <servlet-class>fi.dwo.server.persistence.DwoWebPageServlet</servlet-class>
        <!-- note that these parameters can be overridden in the server context.xml and hence should have reverse domain/package naming prefix -->
        <init-param>
            <param-name>html_source</param-name>
            <param-value>file:webapps/dwo/dwo.html</param-value>
        </init-param>
        <init-param>
            <param-name>local</param-name>
            <param-value>true</param-value>
        </init-param>
        <init-param>
            <param-name>servlet</param-name>
            <param-value>/xmlrpc</param-value>
        </init-param>
        <load-on-startup>0</load-on-startup>
    </servlet>
    <servlet>
        <description>Datasource servlet</description>
        <servlet-name>xmlrpc</servlet-name>
        <servlet-class>fi.dwo.server.persistence.DataSourceAccessServlet</servlet-class>
        <init-param>
            <param-name>datasource</param-name>
            <param-value>jdbc/dwodb</param-value>
        </init-param>
        <init-param>
            <param-name>monitor</param-name>
            <param-value>true</param-value>
        </init-param>
        <init-param>
            <param-name>threading</param-name>
            <param-value>true</param-value>
        </init-param>
        <init-param>
            <param-name>projectVersion</param-name>
            <param-value>1.0.1-SNAPSHOT</param-value>
        </init-param>
        <init-param>
            <param-name>buildnumber</param-name>
            <param-value>9537</param-value>
        </init-param>
        <load-on-startup>0</load-on-startup>
    </servlet>
    <servlet>
        <servlet-name>jersey-servlet</servlet-name>
        <servlet-class>org.glassfish.jersey.servlet.ServletContainer</servlet-class>    
        <init-param>
            <param-name>jersey.config.server.provider.packages</param-name>
            <param-value>fi.dwo.server.rest</param-value>
        </init-param>
        <load-on-startup>1</load-on-startup>
    </servlet>    
    <!--
    servlet mappings 
    -->
    <servlet-mapping>
        <!-- note that xmlrpc is a hardcoded path relative to the applet containing html page -->
        <!-- note that jars is also a hardcoded path relative to the applet containing html page -->
        <servlet-name>xmlrpc</servlet-name>
        <url-pattern>/xmlrpc</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>DwoWebPage</servlet-name>
        <url-pattern>/dwowebpage</url-pattern>
    </servlet-mapping>
    <!-- Jersey JAX_RS JAXB JSON service provider -->
    <servlet-mapping>
        <servlet-name>jersey-servlet</servlet-name>
        <url-pattern>/rest/*</url-pattern>
    </servlet-mapping>
    
    <security-constraint>
        <web-resource-collection>
            <web-resource-name>DwoJaxRsRest</web-resource-name>
            <url-pattern>/rest/secure/*</url-pattern>
            <http-method>GET</http-method>
            <http-method>POST</http-method>
            <http-method>PUT</http-method>
        </web-resource-collection>
        <auth-constraint>
            <role-name>STUDENT</role-name>
            <role-name>TEACHER</role-name>
            <role-name>SCHOOLADMIN</role-name>
            <role-name>ADMIN</role-name>
        </auth-constraint>
        <user-data-constraint>           
            <transport-guarantee>NONE</transport-guarantee>
        </user-data-constraint>
    </security-constraint>

    <!-- Required to be directly below the security constraint -->
    <login-config>
        <auth-method>DIGEST</auth-method>
        <realm-name>DWO account credentials required.</realm-name>
    </login-config>

    <!-- Security roles referenced by this web application -->
    <security-role>
        <role-name>STUDENT</role-name>
    </security-role>
    <security-role>
        <role-name>TEACHER</role-name>
    </security-role>
    <security-role>
        <role-name>SCHOOLADMIN</role-name>
    </security-role>
    <security-role>
        <role-name>ADMIN</role-name>
    </security-role>

</web-app>
