<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui">
	<ui:with type="nl.uu.fi.dwo.rest.locale.DwoLocalesForGWT" field="rb" />
	<ui:style type="nl.uu.fi.dwo.register.client.RegisterCSS" field='css'>
@def color10 #E4F2FB;
@def color11 #D2E5F5;
@def color12 #AAC1DC;
@def color122 #8eBee5;
@def color13 #7297C7;
@def color14 #1B75BB;
@def color15 #314770;
@def color21 #DDE0E3;
@def medium 500;
@def regular 400;

	.free {
	}
	
	.isfree .free {
		display: none;
	}
	
	.saml {
	}
	
	.issaml {
	}

	.notsaml {
	}
		.saml .notsaml {
			display: none;
		}
		
		.header {
			background-color: color15;
			color: color122;
			font-size: 16pt;
			font-weight: bold;
			font-family: "Ubuntu" !important;
			display: flex;
		}
		.header .title {
			margin: auto;
		}
		
		.center td {
			font-family: "Ubuntu" !important;
			font-size: 18px;
			color: white;
		}
		.center > div {
			background-color: color15
		}
		.input {
			width: 252px;
			height: 30px;
			background-color: color14;
			color: white;
			font-family: Ubuntu;
			font-size: 18px;
			-webkit-border-radius: 4px;
			-moz-border-radius: 4px;
			border-radius: 4px;
			border: 2px color14 solid;
		}
		
		.center {
				background-color: color122;
		}
		.button {
		color: white;
		background-color: color14;
		height: 26px;
		width: 126px;
		right: 25px;
		font-size: 12px;
		font-family: Ubuntu;
		font-weight: bold;
		letter-spacing: 2px;
		-webkit-border-radius: 4px;
		-moz-border-radius: 4px;
		border: 2px color14 solid;
		text-transform: uppercase;
	    border-top-left-radius: 4px;
	    border-top-right-radius: 4px;
	    border-bottom-right-radius: 4px;
	    border-bottom-left-radius: 4px;
		}
		
		.root {
			min-height:800px;
			height: 100%;
			width: 100%;
		}
		
	
	</ui:style>
	<g:DockLayoutPanel styleName='{css.root}' unit='PX' >
		<!-- Topbar Navigation Area -->
		<g:north size="50">
		<g:SimplePanel addStyleNames='{css.header}'>
				<g:Label addStyleNames='{css.title}' ui:field="nav_title" ><ui:text from='{rb.GUIR_REGISTER}' /></g:Label>
		</g:SimplePanel>
		</g:north>
		<g:center>
		<!-- Main interaction Area -->
	  	<g:HTMLPanel addStyleNames='{css.center}' >
			<div style="width: 450px; display: block; margin: 20px auto; border: solid black 1px">
	    	    <div style="padding: 10px" >
	    	    <table>
					<tr>
						<td colspan='2'>
							<g:CheckBox ui:field='account' >Ik heb al een numworx account</g:CheckBox>
						</td>
					</tr>
	    	       <tr>
	    	       	<td><ui:text from='{rb.GUI_Username}' />*</td>
	    	       	<td><g:TextBox styleName='{css.input} ' ui:field="username" /></td>
	    	       </tr>
	    	       <tr class='{css.notsaml}'>
	    	        <td><ui:text from='{rb.GUI_GivenName}' />*</td>
	    	       	<td><g:TextBox styleName='{css.input}' ui:field="givenName" /></td>
	    	       </tr>
	    	       <tr class='{css.notsaml}'>
	    	       	<td><ui:text from='{rb.GUI_Insertion}' /></td>
	    	       	<td><g:TextBox styleName='{css.input}' ui:field="insertion" /></td>
	    	       </tr>
	    	       <tr class='{css.notsaml}'>
	    	       	<td><ui:text from='{rb.GUI_FamilyName}' />*</td>
	    	       	<td><g:TextBox styleName='{css.input}' ui:field="familyName" /></td>
	    	       </tr>
	    	       <tr class='{css.notsaml}'>
	    	       	<td><ui:text from='{rb.GUI_Email}' />*</td>
	    	       	<td><g:TextBox styleName='{css.input}' ui:field="email" /></td>
	    	       </tr>	    	       
	    	       <tr>
	    	       	<td><ui:text from="{rb.GUI_Password}" />*</td>
	    	        <td><g:PasswordTextBox styleName='{css.input}' ui:field="password" /></td>
	    	       </tr>
	    	       <tr class='{css.notsaml}'>
	    	       	<td><ui:text from="{rb.GUI_NewPasswordAgain}" />*</td>
	    	        <td><g:PasswordTextBox styleName='{css.input}' ui:field="passwordAgain" /></td>
	    	       </tr>
	    	       <tr>
	    	       		<td>&#x00a0;</td>
	    	       </tr>
	    	       <tr class="{css.free} {css.notsaml}">
	    	       		<td colspan="2" ><ui:text from="{rb.GUIR_MSG_PROVIDED_SCHOOL}" /></td>
	    	       </tr>
	    	       <tr class="{css.free} {css.notsaml}">
	    	       	<td><ui:text from="{rb.GUIR_SCHOOLGROUP}" /></td>
	    	       	<td><g:ListBox styleName='{css.input}' ui:field="schoolGroup" /></td>
	    	       </tr>
	    	       <tr class="{css.free} {css.notsaml}">
	    	       	<td><ui:text from="{rb.GUI_SchoolLogin}" />*</td>
	    	        <td><g:TextBox styleName='{css.input}' ui:field="schoolLogin" /></td>
	    	       </tr>
	    	       <tr class="{css.free} {css.notsaml}">
	    	       	<td><ui:text from="{rb.SCHOOLCODE}" />*</td>
	    	        <td><g:PasswordTextBox styleName='{css.input}' ui:field="schoolCode" /></td>
	    	       </tr>
	    	       <tr class="{css.free} {css.notsaml}">
	    	       		<td>&#x00a0;</td>
	    	       </tr>
	    	       
	    	       <tr>
	    	       	<td><g:Button styleName='{css.button}' ui:field="register" text="{rb.GUI_BTN_Ok}" /></td>
	    	       	<td><g:Button styleName='{css.button}' ui:field="cancel" text="{rb.GUI_BTN_Cancel}" /></td>
	    	       </tr>
	    	    </table>
	    	   </div>
	    	</div>	 
	    </g:HTMLPanel>
	    </g:center>  
	</g:DockLayoutPanel>
		
</ui:UiBinder> 