<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:mgwt="urn:import:com.googlecode.mgwt.ui.client.widget"
	xmlns:g="urn:import:com.google.gwt.user.client.ui">
	<ui:with type="fi.dwo.rest.locale.DwoLocalesForGWT" field="rb" />
	<ui:style>
	</ui:style>
	<g:HTMLPanel>
	<mgwt:LayoutPanel height="100%" width="100%" >
		<!-- Topbar Navigation Area -->
		<mgwt:HeaderPanel >
			<mgwt:center>
				<g:Label ui:field="nav_title" >Aanmelden</g:Label>
			</mgwt:center>
		</mgwt:HeaderPanel>
		<!-- Main interaction Area -->
	  	<g:HTMLPanel>
			<div style="width: 400px; height: 470px; display: block; margin: 20px auto; border: solid black 1px">
	    	    <div style="padding: 10px" >
	    	    <table>
	    	       <tr>
	    	       	<td><ui:text from='{rb.GUI_Username}' />*</td>
	    	       	<td><g:TextBox  ui:field="username" /></td>
	    	       </tr>
	    	       <tr>
	    	        <td><ui:text from='{rb.GUI_GivenName}' />*</td>
	    	       	<td><g:TextBox  ui:field="givenName" /></td>
	    	       </tr>
	    	       <tr>
	    	       	<td><ui:text from='{rb.GUI_Insertion}' /></td>
	    	       	<td><g:TextBox  ui:field="insertion" /></td>
	    	       </tr>
	    	       <tr>
	    	       	<td><ui:text from='{rb.GUI_FamilyName}' />*</td>
	    	       	<td><g:TextBox  ui:field="familyName" /></td>
	    	       </tr>
	    	       <tr>
	    	       	<td><ui:text from='{rb.GUI_Email}' />*</td>
	    	       	<td><g:TextBox  ui:field="email" /></td>
	    	       </tr>	    	       
	    	       <tr>
	    	       	<td><ui:text from="{rb.GUI_Password}" />*</td>
	    	        <td><g:PasswordTextBox  ui:field="password" /></td>
	    	       </tr>
	    	       <tr>
	    	       	<td><ui:text from="{rb.GUI_NewPasswordAgain}" />*</td>
	    	        <td><g:PasswordTextBox  ui:field="passwordAgain" /></td>
	    	       </tr>
	    	       <tr>
	    	       		<td>&#x00a0;</td>
	    	       </tr>
	    	       <tr>
	    	       		<td colspan="2" >Gegevens verstrekt door de school</td>
	    	       </tr>
	    	       <tr>
	    	       	<td><ui:text from="{rb.GUI_SchoolLogin}" /></td>
	    	        <td><g:TextBox  ui:field="schoolLogin" /></td>
	    	       </tr>
	    	       <tr>
	    	       	<td><ui:text from="{rb.SCHOOLCODE}" /></td>
	    	        <td><g:PasswordTextBox  ui:field="schoolCode" /></td>
	    	       </tr>
	    	       <tr>
	    	       		<td>&#x00a0;</td>
	    	       </tr>
	    	       
	    	       <tr>
	    	       	<td><mgwt:Button ui:field="register" text="{rb.GUI_Button_Ok}" /></td>
	    	       	<td><mgwt:Button ui:field="cancel" text="{rb.GUI_Button_Cancel}" /></td>
	    	       </tr>
	    	    </table>
	    	   </div>
	    	</div>	 
	    </g:HTMLPanel>    
	</mgwt:LayoutPanel>
		
	</g:HTMLPanel>
</ui:UiBinder> 