<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:s="urn:import:nl.uu.fi.dwo.lms.gwtclient.gwt.studentmodel"
	xmlns:g="urn:import:com.google.gwt.user.client.ui">
	<ui:style field='style'>
	.root {
		background-color: #d2e5f5;
		padding: 18px;
	}
	.header {
		text-align: center;
		color: #1b75bb;
	}
	.footer, .header  {	
		width: 100%;
		height: 2em;
	}
    .body {
	}
	
	</ui:style>
	<g:FlowPanel addStyleNames="{style.root}">
			<g:Label stylePrimaryName='{style.header}' ui:field='title'>Filter</g:Label>
			<s:FilterMethodSettings addStyleNames="{style.body}" ui:field='settings'></s:FilterMethodSettings>
			<g:FlowPanel addStyleNames="{style.footer}">			
				<g:Button ui:field='okBtn' styleName="right">Doorgaan</g:Button>
			</g:FlowPanel>				
	</g:FlowPanel>
</ui:UiBinder> 