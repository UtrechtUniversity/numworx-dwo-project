<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui" 
>
    <ui:style field="dwoStyle" src="css/dwostyle.css" />    
    <ui:with type="nl.uu.fi.dwo.lms.gwtclient.gwt.icons.AccountImageBundle" field="icons" />
    <g:HeaderPanel addStyleNames='{dwoStyle.dwoAppPanel}'>
        <g:FlowPanel addStyleNames='{dwoStyle.dwoAppHeaderPanel}' ui:field='headerView'>
            <g:Image addStyleNames='{dwoStyle.leftLogoBox}' height = '90%' width = 'auto' ui:field="dwoLogo" resource="{icons.dwoLogo}" />            
            <g:PushButton addStyleNames='{dwoStyle.dwoAppMenuButton}'  ui:field="menuButton">
                <!--                <g:upFace>
                    <b>click me</b>
                </g:upFace>
                <g:upHoveringFace>
                    <b>Click ME!</b>
                </g:upHoveringFace>
                <g:downFace image='{downButton}'/>
                <g:downHoveringFace image='{downButton}'/>-->
                &#9776;
            </g:PushButton>            
            <!--<g:Label addStyleNames='{dwoStyle.leftFullBox}' ui:field="userLabel">gebruikernaam:</g:Label>-->
            <g:Label addStyleNames='{dwoStyle.rightHalfBox}' ui:field="presentationName"></g:Label>
            <!--<g:Label addStyleNames='{dwoStyle.leftFullBox}' ui:field="roleLabel">rol:</g:Label>-->
            <g:Label addStyleNames='{dwoStyle.rightHalfBox}' ui:field="userRole"></g:Label>
            <g:Label addStyleNames='{dwoStyle.rightHalfBox}' ui:field="schoolName"></g:Label>
            <g:Label addStyleNames='{dwoStyle.rightHalfBox}' ui:field="schoolLabel">School</g:Label>
        </g:FlowPanel>
        <!--        <g:FlowPanel addStyleNames='{dwoStyle.dwoAppMainPanel}'>
        <g:FlowPanel>-->
        <g:LayoutPanel addStyleNames='{dwoStyle.dwoAppMainPanel}'>
            <g:layer>
                <g:DeckPanel addStyleNames='{dwoStyle.dwoDeckPanel}' ui:field="mainDeckPanel" >
                    <g:Widget addStyleNames='{dwoStyle.dwoDeckWidget}' ui:field="loginView" />
                    <g:Widget addStyleNames='{dwoStyle.dwoDeckWidget}' ui:field="accountView" />
                    <g:Widget addStyleNames='{dwoStyle.dwoDeckWidget}' ui:field="switchSchoolView" />
                    <g:Widget addStyleNames='{dwoStyle.dwoDeckWidget}' ui:field="schoolclassesView"/>
                    <g:Widget addStyleNames='{dwoStyle.dwoDeckWidget}' ui:field="resultsView" />
                    <g:Widget addStyleNames='{dwoStyle.dwoDeckWidget}' ui:field="scoResultsView" />
                    <!--</g:FlowPanel>-->
                </g:DeckPanel>
            </g:layer>
            <g:layer>
                <!--addStyleNames='{dwoStyle.dwoAppMenuPanel}' ui:field="menuView"-->
                <g:FlowPanel addStyleNames='{dwoStyle.dwoAppMenuPanel}' ui:field="menuView" >
                    <g:Label ui:field="accountLabel">account</g:Label>
                    <g:Label ui:field="switchRoleLabel">switch</g:Label>
                    <g:Label ui:field="classesLabel">manage classes</g:Label>
                    <g:Label ui:field="resultsLabel">results</g:Label>
                    <g:Label ui:field="logoutLabel">logout</g:Label>
                </g:FlowPanel>
            </g:layer>
        </g:LayoutPanel>                
        <!--            </g:FlowPanel>
        </g:FlowPanel>-->
        <g:FlowPanel addStyleNames='{dwoStyle.dwoAppStatusPanel}' ui:field='statusView' >
            <g:CheckBox  addStyleNames='{dwoStyle.dwoAppStatusMsgBox}' ui:field='autoUpdateResults' checked="false">autoUpdate</g:CheckBox>
            <g:Label addStyleNames='{dwoStyle.dwoAppStatusMsgBox}'  ui:field="statusMsg"></g:Label>
        </g:FlowPanel>
    </g:HeaderPanel>            
</ui:UiBinder> 