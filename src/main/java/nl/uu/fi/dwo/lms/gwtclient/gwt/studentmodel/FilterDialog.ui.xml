<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:s="urn:import:nl.uu.fi.dwo.lms.gwtclient.gwt.studentmodel"
	xmlns:g="urn:import:com.google.gwt.user.client.ui">
	<ui:style>
	.root {
		background-color: #d2e5f5;
	}
	.header {
		text-align: center;
		width: 100%;
		height: 2em;
		padding-top: 5px;
		color: #1b75bb;
	}
	.footer {	
		width: 100%;
		height: 2em;
	}
	.button {	
		float: right;
		margin-right: 2em;
    }
    .body {
	}
	
	</ui:style>
	<g:FlowPanel  addStyleNames="{style.root}">
			<g:Label stylePrimaryName='{style.header}' ui:field='title'>Filter</g:Label>
			<s:FilterSettings addStyleNames="{style.body}" ui:field='settings'></s:FilterSettings>
			<g:FlowPanel addStyleNames="{style.footer}">			
				<g:Button ui:field='okBtn' stylePrimaryName="{style.button}">Doorgaan</g:Button>
			</g:FlowPanel>				
	</g:FlowPanel>
</ui:UiBinder> 