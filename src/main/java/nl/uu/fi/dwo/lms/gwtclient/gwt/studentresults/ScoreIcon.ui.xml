<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:s="urn:import:org.vectomatic.dom.svg.ui"
	xmlns:g="urn:import:com.google.gwt.user.client.ui">
	<ui:style>
	.p {
		fill: black;
	}
	
	.r01 {
		fill: rgb(230,220,220);
	}
	.r02 {
		fill: rgb(220,230,220);
	}
	.r03 {
		fill: rgb(200, 0, 0);
	}
	.r04 {
		fill: rgb(0, 180, 0);
	}
	.svg {
	}
	
	/* Add CSS here. See the GWT docs on UI Binder for more details */
	</ui:style>
	<g:DockLayoutPanel unit="PX" styleName="score-treeItem">
	 <g:center>
		<g:InlineLabel styleName='score-title' ui:field='title'>title</g:InlineLabel>
	 </g:center>
	 <g:east size="100">
	<s:SVGImage ui:field="image">
		<svg 	class='score-template {style.svg}'
				viewBox="-5 0 190 20" version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:svg="http://www.w3.org/2000/svg">
			<rect ui:field='r01' x='0'  y='0' width='90' height='20' class='{style.r01}'/>
			<rect ui:field='r02' x='90' y='0' width='90' height='20' class='{style.r02}'/>
			<rect ui:field='r03' x='90' y='0' width='0'  height='10' class='{style.r03}'/>
			<rect ui:field='r04' x='90' y='0' width='0'  height='10' class='{style.r04}'/>
			<g ui:field='poly' transform='translate(90,0)'>
				<polygon points='0,10 5,20 -5,20' class='{style.p}'/>
			</g>			
		</svg>
	</s:SVGImage>
	</g:east>
	</g:DockLayoutPanel>
</ui:UiBinder> 