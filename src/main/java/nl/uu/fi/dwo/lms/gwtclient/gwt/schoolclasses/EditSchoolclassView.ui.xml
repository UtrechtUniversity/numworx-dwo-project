<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui" 
>
    <ui:style field="dwoStyle" src="../css/dwostyle.css" />    
    <ui:with type="nl.uu.fi.dwo.rest.locale.DwoLocalesForGWT" field="rb" />    
    <ui:with type="nl.uu.fi.dwo.lms.gwtclient.gwt.icons.AccountImageBundle" field="icons" />
    <g:FlowPanel addStyleNames='{dwoStyle.dwoDialogPanel}'>
        <!--addStyleNames='{dwoStyle.dwoWidgetPanel}'>-->    
        <g:Grid>
            <g:row>
                <g:customCell>
                    <g:Label><ui:text from='{rb.GUI_Label_SchoolClassName}'/></g:Label>
                </g:customCell>
                <g:customCell>
                    <g:TextBox ui:field='schoolclassName'></g:TextBox>
                </g:customCell>
            </g:row>
            <g:row>
                <g:customCell>
                    <g:Label><ui:text from='{rb.GUI_Label_SchoolClassTreeShow}'/></g:Label>
                </g:customCell>
                <g:customCell>
                    <g:CheckBox ui:field='showTree' checked="false"><ui:text from='{rb.GUI_Label_SchoolClassTreeShow}'/></g:CheckBox>
                </g:customCell>
            </g:row>
            <g:row>
                <g:customCell>
                    <g:Label><ui:text from='{rb.GUI_Label_UseSchoolClassKey}'/></g:Label>
                </g:customCell>
                <g:customCell>
                    <g:CheckBox ui:field='setClassKey' checked="false"><ui:text from='{rb.GUI_Label_UseSchoolClassKey}'/></g:CheckBox>
                </g:customCell>
            </g:row>
            <g:row>
                <g:customCell>
                    <g:Label><ui:text from='{rb.GUI_Label_SchoolClassKey}'/></g:Label>
                </g:customCell>
                <g:customCell>
                    <g:TextBox ui:field='classKey'></g:TextBox>
                </g:customCell>
            </g:row>
            <g:row></g:row>
            <g:row>
                <g:customCell>
                    <g:Button  ui:field="cancelButton"><ui:text from='{rb.GUI_Button_Cancel}'/></g:Button>

                </g:customCell>
                <g:customCell>
                    <g:Button  ui:field="addButton"><ui:text from='{rb.GUI_Button_Update}'/></g:Button>
                </g:customCell>
            </g:row>
        </g:Grid>   
    </g:FlowPanel>
</ui:UiBinder> 