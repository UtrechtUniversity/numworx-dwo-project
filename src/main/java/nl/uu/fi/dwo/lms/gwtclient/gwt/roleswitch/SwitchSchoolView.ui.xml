<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui" 
             xmlns:c='urn:import:com.google.gwt.user.cellview.client'>
    <ui:style field="dwoStyle" src="../css/dwostyle.css" />
    <g:FlowPanel addStyleNames='{dwoStyle.dwoWidgetPanel}'>
       <!--<g:FlowPanel>-->
                        <c:CellTable addStyleNames='{dwoStyle.dwoDataGridWidget} {dwoStyle.dwoMinWidth}' ui:field='cellTable'/>
                        <c:SimplePager addStyleNames='{dwoStyle.dwoDataGridPager}'  ui:field='pager'/>
<!--        </g:FlowPanel>
       <g:FlowPanel>-->
       <g:Grid width="100%">
            <g:row>
                <g:customCell>
                <g:Button ui:field="cancelBtn">cancel</g:Button>
                </g:customCell>
                <g:customCell>
                <g:Button addStyleNames='{dwoStyle.floatCenter} {dwoStyle.margin5}' ui:field="switchBtn">switch</g:Button>
                </g:customCell>
            </g:row>
        </g:Grid>                
        <!--</g:FlowPanel>-->
 </g:FlowPanel>
</ui:UiBinder> 