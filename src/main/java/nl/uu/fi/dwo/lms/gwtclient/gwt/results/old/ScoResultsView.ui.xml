<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui" 
             xmlns:c='urn:import:com.google.gwt.user.cellview.client'>
    <ui:style field="dwoStyle" />
    <ui:with type="nl.uu.fi.dwo.rest.locale.DwoLocalesForGWT" field="rb" />
    <g:FlowPanel  >
     <g:FlowPanel>
        <g:FlowPanel>
            <g:Button  ui:field='backBtn'><ui:text from='{rb.GUI_Button_Back}'/></g:Button>            
            <g:Button   ui:field='sealBtn'><ui:text from='{rb.GUI_Button_Seal}'/></g:Button>            
            <g:Button  ui:field='clearResultsBtn'><ui:text from='{rb.GUI_Button_ClearAllStudentResults}'/></g:Button>            
            <c:CellTable  ui:field='dataTable'/>            
            <c:SimplePager   ui:field='pager' />
        </g:FlowPanel>
        <!-- add some wiskopdr stuff here -->
        <g:Frame ui:field="frame" ></g:Frame>
	  </g:FlowPanel>
    </g:FlowPanel>
</ui:UiBinder> 