<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui">
	<ui:style>
	.perc {
		display: inline-block;
		text-align: right;
		width: 3em;
	}
	.fullheight {
		height: 100%;
	}

	</ui:style>
	<g:SplitLayoutPanel styleName='{style.fullheight}'>
		<g:west size="400">
			<g:ScrollPanel>
				<g:Tree ui:field='tree'>
				</g:Tree>	
			</g:ScrollPanel>		
		</g:west>
		<g:center>
			<g:DockLayoutPanel unit='EM'  >
				<g:north size="2"><g:InlineLabel ui:field='title'>Kies eerst een model</g:InlineLabel></g:north>
				<g:north size='3'><g:FlowPanel>
					<g:InlineLabel ui:field='perc' styleName='{style.perc}'></g:InlineLabel>
						<g:InlineHTML ui:field='outer' />
				</g:FlowPanel></g:north>
				<g:center>
				<g:SimplePanel ui:field='description'>
					
				</g:SimplePanel>
			</g:center>
			</g:DockLayoutPanel>
		</g:center>
	</g:SplitLayoutPanel>
</ui:UiBinder> 