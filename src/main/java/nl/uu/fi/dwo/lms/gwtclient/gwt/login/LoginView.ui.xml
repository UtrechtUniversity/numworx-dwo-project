<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui" >
    <ui:style field="dwoStyle" src="../css/dwostyle.css" />
 	<ui:with type="nl.uu.fi.dwo.rest.locale.DwoLocalesForGWT" field="rb" />
    <g:FlowPanel addStyleNames='{dwoStyle.dwoWidgetPanel}'>
            <g:Grid addStyleNames='{dwoStyle.loginWidget}'>
                <g:row>
                    <g:customCell>
                        <g:Label><ui:text from='{rb.GUI_Username}'/>:</g:Label>
                    </g:customCell>
                    <g:customCell>
                        <g:TextBox addStyleNames='{dwoStyle.dwoTextBox}' ui:field='usernameText'></g:TextBox>
                    </g:customCell>
                </g:row>
                <g:row>
                    <g:customCell>
                        <g:Label><ui:text from='{rb.GUI_Password}'/>:</g:Label>
                    </g:customCell>
                    <g:customCell>
                        <g:PasswordTextBox addStyleNames='{dwoStyle.dwoTextBox}' ui:field='passwordTextBox'></g:PasswordTextBox>
                    </g:customCell>
                </g:row>
                <g:row></g:row>
                <g:row>
                    <g:customCell>
                        <g:CheckBox ui:field='switchSchoolBox' checked="false"><ui:text from='{rb.GUI_SwitchSchool}'/></g:CheckBox>
                    </g:customCell>
                    <g:customCell>
                        <g:Button ui:field='loginBtn'><ui:text from='{rb.GUI_Login}'/></g:Button>
                    </g:customCell>
                </g:row>
<!--                <g:row>
                        <g:cell>
                        <g:Label>password:</g:Label>
                    </g:cell>
                    <g:cell>
                        <g:PasswordTextBox ui:field='passwordTextBox'>passw</g:PasswordTextBox>
                    </g:cell>
                </g:row>
                <g:row>
                    <g:cell>
                        <g:CheckBox ui:field='checkBox' checked="true">switch to teacher</g:CheckBox>
                    </g:cell>
                    <g:cell>
                        <g:Button ui:field='loginBtn'>Login</g:Button>
                    </g:cell>
                </g:row>-->
            </g:Grid>            
    </g:FlowPanel>
</ui:UiBinder> 