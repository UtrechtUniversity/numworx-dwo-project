<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui" 
             xmlns:c='urn:import:com.google.gwt.user.cellview.client'>
    <ui:style field="dwoStyle" src="../../css/dwostyle.css" />
    <ui:with type="nl.uu.fi.dwo.rest.locale.DwoLocalesForGWT" field="rb" />    
    <g:FlowPanel  addStyleNames='{dwoStyle.dwoWidgetPanel}'>
        <g:FlowPanel addStyleNames="{dwoStyle.horizontalFloat}" width="100%">
            <g:Button addStyleNames='{dwoStyle.dwoButton}' ui:field="backBtn"><ui:text from='{rb.GUI_Button_Back}'/></g:Button>
            <g:Button addStyleNames='{dwoStyle.dwoButton}' ui:field="importBtn"><ui:text from='{rb.GUI_Button_Import}'/></g:Button>
            <!--<g:FileUpload ui:field="fileUploadWidget"/>--> 
            <g:Button addStyleNames='{dwoStyle.dwoButton}' ui:field="addBtn"><ui:text from='{rb.GUI_Button_AddStudents}'/></g:Button>
        </g:FlowPanel>
            <g:FlowPanel height="2em">
        </g:FlowPanel>
        <c:CellTable addStyleNames='{dwoStyle.dwoDataGridWidget}' height="auto" ui:field='dataGrid'/>
        <c:SimplePager addStyleNames='{dwoStyle.dwoDataGridPager}'  ui:field='pager'/>
    </g:FlowPanel>
</ui:UiBinder>