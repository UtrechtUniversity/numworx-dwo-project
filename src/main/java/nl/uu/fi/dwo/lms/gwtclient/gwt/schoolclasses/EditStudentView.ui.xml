<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui" >
    <ui:style field="dwoStyle" src="../css/dwostyle.css" />
    <g:FlowPanel addStyleNames='{dwoStyle.dwoDialogPanel}'>
        <g:Grid>
            <g:row>
                <g:customCell>
                    <g:Label>usernaam:</g:Label>
                </g:customCell>
                <g:customCell>
                    <g:TextBox addStyleNames='{dwoStyle.dwoTextBox}' ui:field='usernameText'></g:TextBox>
                </g:customCell>
            </g:row>
            <g:row>
                <g:customCell>
                    <g:Label>voornaam:</g:Label>
                </g:customCell>
                <g:customCell>
                    <g:TextBox addStyleNames='{dwoStyle.dwoTextBox}' ui:field='firstNameText'>
                    </g:TextBox>
                </g:customCell>
            </g:row>
            <g:row>
                <g:customCell>
                    <g:Label>tussenvoegsel:</g:Label>
                </g:customCell>
                <g:customCell>
                    <g:TextBox addStyleNames='{dwoStyle.dwoTextBox}' ui:field='insertionText'>
                    </g:TextBox>
                </g:customCell>
            </g:row>
            <g:row>
                <g:customCell>
                    <g:Label>familienaam:</g:Label>
                </g:customCell>
                <g:customCell>
                    <g:TextBox addStyleNames='{dwoStyle.dwoTextBox}' ui:field='familyNameText'>
                    </g:TextBox>
                </g:customCell>
            </g:row>
            <g:row>
                <g:customCell>
                    <g:Label>email:</g:Label>
                </g:customCell>
                <g:customCell>
                    <g:TextBox addStyleNames='{dwoStyle.dwoTextBox}' ui:field='emailText'>
                    </g:TextBox>
                </g:customCell>
            </g:row>
            <g:row></g:row>
            <g:row>
                <g:customCell>
                    <g:Label>new password:</g:Label>
                </g:customCell>
                <g:customCell>
                    <g:PasswordTextBox addStyleNames='{dwoStyle.dwoTextBox}' ui:field='newPasswordTextBox'></g:PasswordTextBox>
                </g:customCell>
            </g:row>
            <g:row>
                <g:customCell>
                    <g:Label>new password again:</g:Label>
                </g:customCell>
                <g:customCell>
                    <g:PasswordTextBox addStyleNames='{dwoStyle.dwoTextBox}' ui:field='newPasswordAgainTextBox'></g:PasswordTextBox>
                </g:customCell>
            </g:row>
            <g:row></g:row>
            <g:row>
                <g:customCell>
                    <g:Button ui:field='resetBtn'>reset</g:Button>
                </g:customCell>
                <g:customCell>
                    <g:Button ui:field='updateBtn'>update</g:Button>
                </g:customCell>
            </g:row>
            <!--                <g:row>
                    <g:cell>
                    <g:Label>password:</g:Label>
                </g:cell>
                <g:cell>
                    <g:PasswordTextBox ui:field='passwordTextBox'>passw</g:PasswordTextBox>
                </g:cell>
            </g:row>
            <g:row>
                <g:cell>
                    <g:CheckBox ui:field='checkBox' checked="true">switch to teacher</g:CheckBox>
                </g:cell>
                <g:cell>
                    <g:Button ui:field='loginBtn'>Login</g:Button>
                </g:cell>
            </g:row>-->
        </g:Grid>        
    </g:FlowPanel>
</ui:UiBinder> 