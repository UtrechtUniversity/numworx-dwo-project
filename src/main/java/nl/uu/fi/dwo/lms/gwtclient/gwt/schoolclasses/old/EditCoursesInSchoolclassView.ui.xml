<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui" 
             xmlns:c='urn:import:com.google.gwt.user.cellview.client'>
    <ui:style field="dwoStyle" src="../../css/dwostyle.css" />
    <ui:with type="nl.uu.fi.dwo.rest.locale.DwoLocalesForGWT" field="rb" />    
    <g:FlowPanel  addStyleNames='{dwoStyle.dwoWidgetPanel}'>
        <g:FlowPanel  width="100%">
            <g:Button addStyleNames='{dwoStyle.dwoButton}' ui:field="backBtn"><ui:text from='{rb.GUI_Button_Back}'/></g:Button>
            <!--<g:Button addStyleNames='{dwoStyle.dwoButton}' ui:field="saveBtn"><ui:text from='{rb.GUI_Button_AddStudents}'/></g:Button>-->           
            <!--<g:Button addStyleNames='{dwoStyle.dwoButton} float:right' ui:field="addToSchoolClass">add to schoolclass</g:Button>-->
    </g:FlowPanel>
        <g:FlowPanel addStyleNames="{dwoStyle.horizontalFloat}" width="100%" height="100%" >
            <g:Tree addStyleNames='{dwoStyle.dwoTextBox} float:right' ui:field="courseTree" />
                <c:CellTable addStyleNames='{dwoStyle.dwoDataGridWidget}' width="50%" height="100%" ui:field='courseTable'/>
        <c:SimplePager addStyleNames='{dwoStyle.dwoDataGridPager}'  ui:field='pager'/>
        </g:FlowPanel>
    </g:FlowPanel>
</ui:UiBinder>