<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui" >
    <ui:style field="dwoStyle" src="../css/dwostyle.css" />
    <g:FlowPanel addStyleNames='{dwoStyle.dwoDialogPanel}'>
        <g:Grid>
            <g:row>
                <g:customCell>
                    <g:Label>Selecteer een file</g:Label>
                </g:customCell>
                <g:customCell>
                    <g:FileUpload addStyleNames='{dwoStyle.dwoTextBox}' ui:field='fileUpload'/>
                </g:customCell>
            </g:row>
            <g:row>
<!--                <g:customCell>
                    
                </g:customCell>-->
                <g:customCell>
                    <g:PushButton ui:field='loadBtn'>load</g:PushButton>
                </g:customCell>
            </g:row>
            <g:row></g:row>
            <g:row>
                <g:customCell>
                    <g:PushButton ui:field='cancelBtn'>cancel</g:PushButton>
                </g:customCell>
                <g:customCell>
                    <g:PushButton ui:field='importBtn'>import</g:PushButton>
                </g:customCell>
            </g:row>
            <!--                <g:row>
                    <g:cell>
                    <g:Label>password:</g:Label>
                </g:cell>
                <g:cell>
                    <g:PasswordTextBox ui:field='passwordTextBox'>passw</g:PasswordTextBox>
                </g:cell>
            </g:row>
            <g:row>
                <g:cell>
                    <g:CheckBox ui:field='checkBox' checked="true">switch to teacher</g:CheckBox>
                </g:cell>
                <g:cell>
                    <g:Button ui:field='loginBtn'>Login</g:Button>
                </g:cell>
            </g:row>-->
        </g:Grid>        
    </g:FlowPanel>
</ui:UiBinder> 