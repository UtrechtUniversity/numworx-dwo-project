<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:c='urn:import:com.google.gwt.user.cellview.client'>
    <ui:style field="dwoStyle" src="../css/dwostyle.css" />
    <!--        <g:ScrollPanel styleName="{dwoStyle.fullPanel}">
        <g:FlowPanel>
            <g:FlexTable styleName="{dwoStyle.flexTable}" ui:field="resultTable"/>
        </g:FlowPanel>
    </g:ScrollPanel>-->
    <g:DockLayoutPanel  unit="EM" addStyleNames='{dwoStyle.dwoWidgetPanel}'>
        <g:north addStyleNames="{dwoStyle.horizontalFloat}" size='3'>
            <g:Button addStyleNames='{dwoStyle.dwoButton}' ui:field="exportBtn">export</g:Button>
        </g:north>
        <g:center>
            <g:DockLayoutPanel addStyleNames='{dwoStyle.dwoFlowPanel}'>
                    <g:north  size='20'>
                        <c:SimplePager addStyleNames='{dwoStyle.dwoDataGridPager}' width='90%'  ui:field='pager'/>
                    </g:north>
                <g:center>
                    <!--<g:ScrollPanel  addStyleNames='{dwoStyle.dwoDataGridWidget}' height="auto" >-->
                        <c:DataGrid addStyleNames='{dwoStyle.dwoDataGridWidget}' width="100%"  ui:field='dataGrid'/>
                        <!--</g:ScrollPanel>-->
                </g:center>
            </g:DockLayoutPanel>
        </g:center>
    </g:DockLayoutPanel>            
</ui:UiBinder>