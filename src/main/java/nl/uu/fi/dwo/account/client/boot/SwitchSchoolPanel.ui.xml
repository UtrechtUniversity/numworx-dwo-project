<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui" 
             xmlns:mgwt="urn:import:com.googlecode.mgwt.ui.client.widget">
    <ui:style field="resultapp" src="resultapp.css" />
    <g:FlowPanel>
        <g:FlexTable ui:field="table" styleName="{resultapp.flexTable}" borderWidth="2" />
        <g:Button addStyleNames='{resultapp.leftHalfBox}' ui:field="cancelBtn">cancel</g:Button>
        <g:Button addStyleNames='{resultapp.leftFullBox}' ui:field="switchBtn">switch</g:Button>

    </g:FlowPanel>
</ui:UiBinder> 