<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui" 
>
    <ui:style field="resultApp" src="resultapp.css" />    
    <ui:with type="nl.uu.fi.dwo.account.client.icons.AccountImageBundle" field="icons" />
    <g:HeaderPanel addStyleNames='{resultApp.appPanel}'>
        <g:FlowPanel addStyleNames='{resultApp.header}'>
            <g:Image addStyleNames='{resultApp.leftLogoBox}' height = '90%' width = 'auto' ui:field="dwoLogo" resource="{icons.dwoLogo}" />            
            <!--<g:Label addStyleNames='{resultApp.leftFullBox}' ui:field="schoolLabel">School:</g:Label>-->
            <g:Label addStyleNames='{resultApp.leftHalfBox}' ui:field="schoolName"></g:Label>
            <!--<g:Label addStyleNames='{resultApp.leftFullBox}' ui:field="roleLabel">rol:</g:Label>-->
            <g:Label addStyleNames='{resultApp.leftHalfBox}' ui:field="userRole"></g:Label>
            <!--<g:Label addStyleNames='{resultApp.leftFullBox}' ui:field="userLabel">gebruikernaam:</g:Label>-->
            <g:Label addStyleNames='{resultApp.leftHalfBox}' ui:field="presentationName"></g:Label>
            <g:PushButton addStyleNames='{resultApp.menuButton}' height = '90%' width = 'auto' ui:field="menuButton">
                <!--                <g:upFace>
                    <b>click me</b>
                </g:upFace>
                <g:upHoveringFace>
                    <b>Click ME!</b>
                </g:upHoveringFace>
                <g:downFace image='{downButton}'/>
                <g:downHoveringFace image='{downButton}'/>-->
                menu
            </g:PushButton>            
        </g:FlowPanel>
        <g:FlowPanel addStyleNames='{resultApp.mainPanel}'>
            <g:FlowPanel>
                <g:DeckPanel addStyleNames='{resultApp.deckPanel}' ui:field="mainDeckPanel" >
                    <g:Widget ui:field="loginWidget" />
                    <g:Widget ui:field="switchSchoolWidget" />
                    <g:Widget ui:field="resultWidget" />
                    <!--</g:FlowPanel>-->
                </g:DeckPanel>
                <g:FlowPanel addStyleNames='{resultApp.menuPanel}' ui:field="menuPanel" >
                    <g:Label >test</g:Label>
                </g:FlowPanel>
            </g:FlowPanel>
        </g:FlowPanel>
        <g:FlowPanel addStyleNames='{resultApp.statusPanel}' ui:field='statusPanel' >
            <g:CheckBox  addStyleNames='{resultApp.statusMsgBox}' ui:field='autoUpdateResults' checked="false">autoUpdate</g:CheckBox>
            <g:Label addStyleNames='{resultApp.statusMsgBox}'  ui:field="statusMsg"></g:Label>
        </g:FlowPanel>
    </g:HeaderPanel>            
</ui:UiBinder> 