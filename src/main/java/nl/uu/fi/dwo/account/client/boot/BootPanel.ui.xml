<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui" 
             xmlns:mgwt="urn:import:com.googlecode.mgwt.ui.client.widget">
    <ui:style field="accountnav" src="accountnav.css" />    
    
    <g:HeaderPanel addStyleNames='{accountnav.appPanel}'>
        <g:FlowPanel addStyleNames='{accountnav.header}'>
                <g:Label addStyleNames='{accountnav.leftbox}' ui:field="schoolLabel">School&nbsp;</g:Label>
                <g:Label addStyleNames='{accountnav.leftbox}' ui:field="schoolName"></g:Label>
                <g:Label addStyleNames='{accountnav.leftbox}'>&nbsp;</g:Label>
                <g:Label addStyleNames='{accountnav.leftbox}' ui:field="userRole"></g:Label>
                <g:Label addStyleNames='{accountnav.leftbox}'>&nbsp;</g:Label>
                <g:Label addStyleNames='{accountnav.leftbox}' ui:field="presentationName"></g:Label>
                <g:Button addStyleNames='{accountnav.rightbox}' ui:field="logoutBtn">Logout</g:Button>
        </g:FlowPanel>
        <g:FlowPanel addStyleNames='{accountnav.deckpanel}'>
            <g:DeckPanel  ui:field="mainDeckPanel" >
                <g:Widget ui:field="loginWidget" />
                <g:Widget ui:field="switchSchoolWidget" />
                <g:Widget ui:field="resultWidget" />
                
                <!--</g:FlowPanel>-->
            </g:DeckPanel>
        </g:FlowPanel>
        <g:FlowPanel addStyleNames='{accountnav.status}'>
            <g:HTML horizontalAlignment="ALIGN_CENTER" width="100%" >
                <div>status panel</div>
            </g:HTML>
        </g:FlowPanel>
        <!--</g:FlowPanel>-->
    </g:HeaderPanel>            
</ui:UiBinder> 