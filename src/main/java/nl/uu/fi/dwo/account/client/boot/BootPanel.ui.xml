<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui" 
>
    <ui:style field="dwoStyle" src="dwostyle.css" />    
    <ui:with type="nl.uu.fi.dwo.account.client.icons.AccountImageBundle" field="icons" />
    <g:HeaderPanel addStyleNames='{dwoStyle.dwoAppPanel}'>
        <g:FlowPanel addStyleNames='{dwoStyle.dwoAppHeaderPanel}'>
            <g:Image addStyleNames='{dwoStyle.leftLogoBox}' height = '90%' width = 'auto' ui:field="dwoLogo" resource="{icons.dwoLogo}" />            
            <g:PushButton addStyleNames='{dwoStyle.dwoAppMenuButton}'  ui:field="menuButton">
                <!--                <g:upFace>
                    <b>click me</b>
                </g:upFace>
                <g:upHoveringFace>
                    <b>Click ME!</b>
                </g:upHoveringFace>
                <g:downFace image='{downButton}'/>
                <g:downHoveringFace image='{downButton}'/>-->
                menu
            </g:PushButton>            
            <!--<g:Label addStyleNames='{dwoStyle.leftFullBox}' ui:field="userLabel">gebruikernaam:</g:Label>-->
            <g:Label addStyleNames='{dwoStyle.rightHalfBox}' ui:field="presentationName"></g:Label>
            <!--<g:Label addStyleNames='{dwoStyle.leftFullBox}' ui:field="roleLabel">rol:</g:Label>-->
            <g:Label addStyleNames='{dwoStyle.rightHalfBox}' ui:field="userRole"></g:Label>
            <g:Label addStyleNames='{dwoStyle.rightHalfBox}' ui:field="schoolName"></g:Label>
            <g:Label addStyleNames='{dwoStyle.rightHalfBox}' ui:field="schoolLabel">School</g:Label>
        </g:FlowPanel>
        <g:FlowPanel addStyleNames='{dwoStyle.dwoAppMainPanel}'>
            <g:FlowPanel>
                <g:DeckPanel addStyleNames='{dwoStyle.dwoDeckPanel}' ui:field="mainDeckPanel" >
                    <g:Widget ui:field="loginWidget" />
                    <g:Widget ui:field="switchSchoolWidget" />
                    <g:Widget ui:field="resultWidget" />
                    <!--</g:FlowPanel>-->
                </g:DeckPanel>
                <g:FlowPanel addStyleNames='{dwoStyle.dwoAppMenuPanel}' ui:field="menuPanel" >
                    <g:Label >menu a</g:Label>
                    <g:Label >menu b</g:Label>
                    <g:Label >menu c</g:Label>
                </g:FlowPanel>
            </g:FlowPanel>
        </g:FlowPanel>
        <g:FlowPanel addStyleNames='{dwoStyle.dwoAppStatusPanel}' ui:field='statusPanel' >
            <g:CheckBox  addStyleNames='{dwoStyle.dwoAppStatusMsgBox}' ui:field='autoUpdateResults' checked="false">autoUpdate</g:CheckBox>
            <g:Label addStyleNames='{dwoStyle.dwoAppStatusMsgBox}'  ui:field="statusMsg"></g:Label>
        </g:FlowPanel>
    </g:HeaderPanel>            
</ui:UiBinder> 