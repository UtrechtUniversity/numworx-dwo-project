<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui" 
             xmlns:mgwt="urn:import:com.googlecode.mgwt.ui.client.widget">
    <ui:style field="accountnav" src="accountnav.css" />    
    
    <g:HeaderPanel addStyleNames='{accountnav.appPanel}'>
        <!--<g:FlowPanel size='2'>-->
        <g:FlowPanel addStyleNames='{accountnav.header}'>
            <g:HTML horizontalAlignment="ALIGN_CENTER">
                <div>
                    <div align="left">DWO - My School, my schoolclass - myrole, my name</div>
                    <div align="left">version xx</div>
                </div>
            </g:HTML>
        </g:FlowPanel>
        <g:FlowPanel addStyleNames='{accountnav.body}'>
            <g:DeckPanel  ui:field="mainDeckPanel" >
                <g:Widget ui:field="loginWidget" />
                <g:Widget ui:field="resultWidget" />
                <!--</g:FlowPanel>-->
            </g:DeckPanel>
        </g:FlowPanel>
        <g:FlowPanel addStyleNames='{accountnav.status}'>
            <g:HTML horizontalAlignment="ALIGN_CENTER" width="100%" >
                <div>status panel</div>
            </g:HTML>
        </g:FlowPanel>
        <!--</g:FlowPanel>-->
    </g:HeaderPanel>            
</ui:UiBinder> 