<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui" 
             xmlns:mgwt="urn:import:com.googlecode.mgwt.ui.client.widget">
    <ui:style field="accountnav" src="accountnav.css" />    
    
    <g:DockLayoutPanel unit='EM'>
        <g:north size='5'>
            <g:HTML addStyleNames='{accountnav.header}'>
                <div class='{accountnav.header}' align="left">
                    <div>DWO - My School, my schoolclass - myrole, my name</div>
                    <div align="right">version xx</div>
                </div>
            </g:HTML>
        </g:north>
        <g:south size='5'>
            <g:HTML addStyleNames='{accountnav.status}'>
                <div class='{accountnav.status}'>status panel</div>
            </g:HTML>
        </g:south>
        <g:center>
            <g:FlowPanel><div>
                <g:Widget addStyleNames='{accountnav.body}' ui:field="loginWidget" />
            </div>
            </g:FlowPanel>
        </g:center>
        <g:west size='10'>
            <g:HTML addStyleNames='{accountnav.navi}'>
                <div class='{accountnav.navi}'>
                    <ul>
                        <li>Sidebar</li>
                        <li>Sidebar</li>
                        <li>Sidebar</li>
                    </ul>
                </div>
            </g:HTML>
        </g:west>
    </g:DockLayoutPanel>    
</ui:UiBinder> 