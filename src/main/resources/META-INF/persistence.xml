<?xml version="1.0" encoding="UTF-8"?>
<persistence version="2.1" xmlns="http://xmlns.jcp.org/xml/ns/persistence" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/persistence http://xmlns.jcp.org/xml/ns/persistence/persistence_2_1.xsd">
  <persistence-unit name="DWO_MySQLDB" transaction-type="RESOURCE_LOCAL">
    <!-- include all and any required persistent entity in here exclude-unlisted-classes is being ignored!-->
    <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>
    <non-jta-data-source>java:comp/env/jdbc/dwodb</non-jta-data-source>
    <class>fi.dwo.commons.persistence.entities.PersistentHasRole</class>
    <class>fi.dwo.commons.persistence.entities.PersistentUser</class>
    <class>fi.dwo.commons.persistence.entities.PersistentStudentScoContext</class>
    <class>fi.dwo.commons.persistence.entities.PersistentScoData</class>
    <class>fi.dwo.commons.persistence.entities.PersistentAppletConfig</class>
    <class>fi.dwo.commons.persistence.entities.PersistentSchoolClass</class>
    <class>fi.dwo.commons.persistence.entities.PersistentApplet</class>
    <class>fi.dwo.commons.persistence.entities.PersistentRole</class>
    <class>fi.dwo.commons.persistence.entities.PersistentDwoProfile</class>
    <class>fi.dwo.commons.persistence.entities.PersistentDwoSystemParameters</class>
    <class>fi.dwo.commons.persistence.entities.PersistentTeacherOfClass</class>
    <class>fi.dwo.commons.persistence.entities.PersistentSchoolGroup</class>
    <class>fi.dwo.commons.persistence.entities.PersistentImage</class>
    <class>fi.dwo.commons.persistence.entities.PersistentStudentScoData</class>
    <class>fi.dwo.commons.persistence.entities.PersistentScoContext</class>
    <class>fi.dwo.commons.persistence.entities.PersistentSamlUser</class>
    <class>fi.dwo.commons.persistence.entities.PersistentStudentOfClass</class>
    <class>fi.dwo.commons.persistence.entities.PersistentCourseSequence</class>
    <class>fi.dwo.commons.persistence.entities.PersistentJars</class>
    <class>fi.dwo.commons.persistence.entities.PersistentCourse</class>
    <class>fi.dwo.commons.persistence.entities.PersistentSchool</class>
    <class>fi.dwo.commons.persistence.entities.PersistentClassCourse</class>
    <class>fi.dwo.commons.persistence.entities.PersistentFromTo</class>
    <exclude-unlisted-classes>false</exclude-unlisted-classes>
    <shared-cache-mode>ENABLE_SELECTIVE</shared-cache-mode>
    <properties>
    <!--    Alternative data-nucleus config, required additional and unknown tomcat configs
            <provider>org.datanucleus.api.jpa.PersistenceProviderImpl</provider>
            <non-jta-data-source>java:comp/env/jdbc/dwodb</non-jta-data-source>
            <property name="datanucleus.ConnectionUserName" value="dwo"/>
            <property name="datanucleus.ConnectionPassword" value="E=mc2Dwo"/>
            <property name="datanucleus.autoCreateSchema" value="false"/>
            <property name="datanucleus.validateTables" value="false"/>
            <property name="datanucleus.validateConstraints" value="false"/>
            -->
      <property name="eclipselink.weaving" value="static"/>
      <property name="eclipselink.weaving.lazy" value="true"/>
      <property name="eclipselink.allow-zero-id" value="true"/>
<!-- logging all on -->
      <property name="eclipselink.logging.logger" value="JavaLogger"/>      
      <property name="eclipselink.logging.level.sql" value="FINE"/>
	  <property name="eclipselink.logging.parameters" value="true"/>
    </properties>
  </persistence-unit>
</persistence>
