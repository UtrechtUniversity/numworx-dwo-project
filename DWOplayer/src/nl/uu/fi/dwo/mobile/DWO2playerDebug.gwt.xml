  <!-- Other module inherits                                      -->

  <!-- Specify the app entry point class.                         -->

  <inherits name="com.google.gwt.json.JSON" />
  <inherits name="com.fredhat.gwt.xmlrpc.XMLRPC" />

   <inherits name="nl.uu.fi.dwo.mobile.DWOplayer-module"/>
	<inherits name="nl.uu.fi.dwo.keyboard.KeyboardGWT-DWO" />
   <inherits name='nl.numworx.gwtpatch.GWTPatch' />
   <inherits name="dagger.Dagger" />

