<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui">
	<ui:style>
	.image {
			margin-left: 0px;
			margin-right: 0px;
			margin-top: -2px; 
			margin-bottom: -7px;
	}
	
	.label {
			font-size: 11px;
			font-weight: bold;
			padding: 0px;
			margin-top: -1px;
			margin-left: 1px;
			padding-left: 2px;
			display: inline-block;
			vertical-align: top;
			width: 10px;
	}
	
	.flow {
			display: inline-block;
			padding-left: 5px;
			vertical-align: top;
			margin-top: -3px;
			height: 29px;
			width: 15px;
			cursor: pointer;

			position: absolute;
			top: 0px;
			right: 0px;
	}
	
	</ui:style>
	<g:FlowPanel styleName="{style.flow}">
	    <g:Image styleName="{style.image}" ui:field='checkimg'/>
		<g:Label styleName="{style.label}" ui:field="feedbackLabel" >?</g:Label>
	</g:FlowPanel>
</ui:UiBinder> 