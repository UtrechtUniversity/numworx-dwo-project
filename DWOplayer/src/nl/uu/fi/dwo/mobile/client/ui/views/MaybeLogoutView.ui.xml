<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
	xmlns:g="urn:import:com.google.gwt.user.client.ui">
	<ui:with type='nl.uu.fi.dwo.rest.locale.DwoLocalesForGWT' field='instance' />
	<ui:style>
@def color15 #314770;
@def color10 #E4F2FB;
@def color11 #D2E5F5;
@def color12 #AAC1DC;
@def color122 #8eBee5;
@def color13 #7297C7;
@def color14 #1B75BB;
@def color15 #314770;
@def color21 #DDE0E3;
@def medium 500;
@def regular 400;

		.body {
			background-color: color11;
			color: color15; /*15*/
			font-size: 14px;
			line-height: 18px;			
		}
	
		.panel {
			background-color: color15;
			width: 306px;
			height: 100px;
			margin-top: 200px;
			margin-left: 100px;
			border: solid 1px black;
			font-family: Ubuntu, sans-serif;
			font-size: 24px;
		-webkit-border-radius: 3px;
		-moz-border-radius: 3px;
		border-radius: 3px;
		}
	.button {
		color: white;
		background-color: color14;
		height: 26px;
		width: 126px;
		font-size: 12px;
		font-family: Ubuntu, sans-serif;
		font-weight: bold;
		letter-spacing: 2px;
		-webkit-border-radius: 3px;
		-moz-border-radius: 3px;
		border-radius: 3px;
		border-style: none;
		margin-left: inherit;
		margin-right: 25px;
		text-transform: uppercase;
	}
	.text {
		margin-top: 1em;
		margin-left: 1em;
		margin-bottom: 1em;
		color: color12;
	}
	</ui:style>
	<g:HTMLPanel styleName='{style.body}'>
	  	<div class='{style.panel}'>
			<div class='{style.text}'><ui:text from='{instance.NUM_LBL_LOGGEDIN}' /></div>
			<g:Button styleName='{style.button}' ui:field='btn'><ui:text from='{instance.NUM_BTN_Confirm}' /></g:Button>
		</div>
	</g:HTMLPanel>
</ui:UiBinder> 