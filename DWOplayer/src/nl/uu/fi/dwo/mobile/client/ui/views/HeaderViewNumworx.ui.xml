				<g:FocusPanel ui:field='upBtn' styleName='{style.nav}'>
					<g:InlineHTML><i  class='fa fa-2x fa-arrow-up {style.navIcon} profile-headerIcon' ></i></g:InlineHTML>
				</g:FocusPanel>
<!-- 				<g:FocusPanel ui:field='homeBtn' styleName='{style.nav}'><g:Image url='{pfx}images/numworx/home-numworx.svg'/></g:FocusPanel> -->
			</g:FlowPanel>
</ui:UiBinder> 