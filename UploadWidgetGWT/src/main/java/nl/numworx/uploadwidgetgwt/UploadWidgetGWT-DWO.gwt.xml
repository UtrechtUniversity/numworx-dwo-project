<?xml version="1.0" encoding="UTF-8"?>
<module rename-to='UploadWidgetGWT'>
  <!-- Inherit the core Web Toolkit stuff.                        -->
  <inherits name='com.google.gwt.user.User' />

  <!-- Inherit the default GWT style sheet.  You can change       -->
  <!-- the theme of your GWT application by uncommenting          -->
  <!-- any one of the following lines.                            -->
  <inherits name='com.google.gwt.user.theme.standard.Standard' />
  <!-- <inherits name='com.google.gwt.user.theme.chrome.Chrome'/> -->
  <!-- <inherits name='com.google.gwt.user.theme.dark.Dark'/>     -->

  <!-- Other module inherits                                      -->
   <inherits name="nl.uu.fi.dwo.interaction.Interaction" />
   <inherits name="gwtupload.GWTUpload" />
   <inherits name="nl.numworx.uploadwidget.UploadWidget" />

    <replace-with class="nl.numworx.uploadwidgetgwt.client.UploadSession">
        <when-type-is class="gwtupload.client.ISession.CORSSession" />
    </replace-with>
    <replace-with class="nl.numworx.uploadwidgetgwt.client.UploadSession">
        <when-type-is class="gwtupload.client.ISession.Session" />
    </replace-with>


  <!-- Specify the paths for translatable code                    -->
  <source path='client' />
  <source path='shared' />

</module>
