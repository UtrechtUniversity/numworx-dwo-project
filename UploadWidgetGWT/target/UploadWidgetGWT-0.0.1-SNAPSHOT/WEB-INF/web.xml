<?xml version="1.0" encoding="UTF-8"?>
<web-app>
  <servlet>
  	<servlet-name>upload</servlet-name>
  	<servlet-class>nl.numworx.uploadwidgetgwt.server.Upload</servlet-class>
  </servlet>
  <servlet>
  	<servlet-name>javaupload</servlet-name>
  	<servlet-class>nl.numworx.uploadwidgetgwt.server.JavaUpload</servlet-class>
  </servlet>
  
  <servlet-mapping>
  	<servlet-name>upload</servlet-name>
    <url-pattern>*.gupld</url-pattern>  
  </servlet-mapping>

  <servlet-mapping>
  	<servlet-name>javaupload</servlet-name>
    <url-pattern>/feed.xml</url-pattern>  
  </servlet-mapping>

  <!-- Default page to serve -->
  <welcome-file-list>
    <welcome-file>UploadWidgetGWT.html</welcome-file>
  </welcome-file-list>


</web-app>
