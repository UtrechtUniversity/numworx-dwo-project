<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://java.sun.com/xml/ns/j2ee"
     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:schemaLocation="http://java.sun.com/xml/ns/j2ee http://java.sun.com/xml/ns/j2ee/web-app_2_4.xsd"
     version="2.4">
 <!-- ${comment} -->
  <context-param>
  	<param-name>dbaccess.url</param-name>
	<param-value>${dsaccess.url}</param-value>  
  </context-param>
  <context-param>
  	<param-name>SERVLET</param-name>
  	<param-value>${dsaccess}</param-value>
  </context-param>
  <context-param>
  	<param-name>IDEAS</param-name>
  	<param-value>${ideas}</param-value>
  </context-param>
  
   <filter>
    <filter-name>JAMonFilter</filter-name>
    <filter-class>com.jamonapi.JAMonFilter</filter-class>
  </filter>

  <filter-mapping>
    <filter-name>JAMonFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>
  
  
  <!-- Servlets -->
  <servlet>
    <servlet-name>image.png</servlet-name>
  	<servlet-class>fi.servlet.dwomaccess.DWOmAccess</servlet-class>
  </servlet>
  <servlet>
  	<servlet-name>dbaccess</servlet-name>
  	<servlet-class>fi.servlet.dwomaccess.DbAccessServlet</servlet-class>
  </servlet>
  <servlet>
  	<servlet-name>scormaccess</servlet-name>
  	<servlet-class>fi.servlet.dwomaccess.ScormAccess</servlet-class>
  </servlet>

  	<servlet>
      <servlet-name>ProviderServlet</servlet-name>
      <servlet-class>fi.servlet.lti.ProviderServlet</servlet-class>
    </servlet>
    <servlet>
      <servlet-name>ServiceServlet</servlet-name>
      <servlet-class>fi.servlet.lti.ServiceServlet</servlet-class>
    </servlet>
    
    <servlet>
      <servlet-name>dwoparam</servlet-name>
      <jsp-file>/lti/dwo.jsp</jsp-file>
    </servlet>
    <servlet>
    	<servlet-name>appname</servlet-name>
    	<jsp-file>/lti/app.jsp</jsp-file>
    </servlet>
    
   <servlet-mapping>
      <servlet-name>dwoparam</servlet-name>
      <url-pattern>/lti/dwo.jsp/*</url-pattern>
   </servlet-mapping>
   <servlet-mapping>
      <servlet-name>appparam</servlet-name>
      <url-pattern>/lti/app.jsp/*</url-pattern>
   </servlet-mapping>
  
  <servlet-mapping>
	<servlet-name>image.png</servlet-name>
	<url-pattern>/image.png</url-pattern>
  </servlet-mapping>
   <servlet-mapping>
	<servlet-name>image.png</servlet-name>
	<url-pattern>/partialScore</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
	<servlet-name>image.png</servlet-name>
	<url-pattern>/getLaunchData</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
	<servlet-name>image.png</servlet-name>
	<url-pattern>/getJSONLaunchData</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
	<servlet-name>image.png</servlet-name>
	<url-pattern>/getJSONLaunchDataBytes</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
	<servlet-name>image.png</servlet-name>
	<url-pattern>/getCourseDescription</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
  	<servlet-name>dbaccess</servlet-name>
  	<url-pattern>/dbaccess</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>scormaccess</servlet-name>
    <url-pattern>/scormaccess</url-pattern>
  </servlet-mapping>
      <servlet-mapping>
      <servlet-name>ProviderServlet</servlet-name>
      <url-pattern>/lti/provider/*</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
      <servlet-name>ServiceServlet</servlet-name>
      <url-pattern>/lti/service/*</url-pattern>
    </servlet-mapping>
  
  
  <!-- Default page to serve -->
	<welcome-file-list>
    <welcome-file>index.html</welcome-file>
  </welcome-file-list>

</web-app>
