<?xml version="1.0" encoding="UTF-8"?>
<module>
  <inherits name="com.google.gwt.logging.Logging"/>
  <inherits name="com.google.gwt.user.User" />
  <inherits name="com.google.gwt.user.theme.clean.Clean" />
  <inherits name="com.google.gwt.json.JSON" />
  <inherits name="com.stanziq.strophe.Strophe" />
  
  <inherits name="com.googlecode.mgwt.MGWTMin" />
  <inherits name="fi.wiskopdr.WiskOpdr" />
  <inherits name="nl.uu.fi.dwo.keyboard.KeyboardGWT-DWO" />

  <source path="" />

  <entry-point class="nl.uu.fi.dwo.lms.chatgwt.ChatGWT" />

  <set-property name="gwt.logging.enabled" value="TRUE"/>
  <set-property name="gwt.logging.logLevel" value="FINEST"/>

  <!-- Only support recent browsers -->
  <set-property name="user.agent" value="gecko1_8,safari" />
</module>
