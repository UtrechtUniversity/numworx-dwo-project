<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee 
              http://java.sun.com/xml/ns/javaee/web-app_2_5.xsd"
         version="2.5"
         xmlns="http://java.sun.com/xml/ns/javaee">

  <context-param>
  	<param-name>dbrest.url</param-name>
	<param-value>http://localhost:8080/dwox/</param-value>  
  </context-param>
  <filter>
  	<filter-name>authz</filter-name>
  	<filter-class>nl.numworx.oauth2client.server.OAuth2Filter</filter-class>
  	<init-param>
  		<param-name>authz</param-name>
  		<param-value>http://localhost:8080/dwo/oauth2/entree</param-value>
  	</init-param>
  	<init-param>
  		<param-name>client_id</param-name>
  		<param-value>secret_client_id</param-value>
  	</init-param>
  </filter>
  <filter-mapping>
  	<filter-name>authz</filter-name>
  	<url-pattern>/upload.jsp</url-pattern>
  </filter-mapping>

  <!-- Servlets -->
  <servlet>
    <servlet-name>oauth2</servlet-name>
    <servlet-class>nl.numworx.oauth2client.server.OAuth2Server</servlet-class>
  </servlet>
  
  <servlet>
  	<servlet-name>login</servlet-name>
  	<servlet-class>nl.numworx.oauth2client.server.LoginServlet</servlet-class> 	
  </servlet>

  <servlet>
    <servlet-name>oauth2-entree</servlet-name>
    <servlet-class>nl.numworx.oauth2client.server.LoginServlet</servlet-class>
    <init-param>
    	<param-name>config</param-name>
    	<param-value>nl.numworx.oauth2client.server.WAYFLogin</param-value>
    </init-param>
  </servlet>
  
  <servlet>
  	<servlet-name>redirect</servlet-name>
  	<servlet-class>nl.numworx.oauth2client.server.JavaSamlRedirect</servlet-class>
  </servlet>
  
  <servlet>
  	<servlet-name>dwo-redirect</servlet-name>
  	<servlet-class>nl.numworx.oauth2client.server.DwoRedirect</servlet-class>
  </servlet>
  
  <servlet>
  	<servlet-name>entrees-redirect</servlet-name>
  	<servlet-class>nl.numworx.oauth2client.server.EntreeSRedirect</servlet-class>
  </servlet>
  
  <servlet-mapping>
    <servlet-name>oauth2</servlet-name>
    <url-pattern>/dwo/saml/login</url-pattern>
  </servlet-mapping>
  
  <servlet-mapping>
  	<servlet-name>dwo-redirect</servlet-name>
  	<url-pattern>/dwo-redirect</url-pattern>
  	<url-pattern>/dwo/oauth2/dwo-redirect</url-pattern>
  </servlet-mapping>
  
  
  <servlet-mapping>
  	<servlet-name>login</servlet-name>
	<url-pattern>/login</url-pattern>
	<url-pattern>/mfalogin</url-pattern>
	<url-pattern>/dwo/oauth2/login</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
  	<servlet-name>entrees-redirect</servlet-name>
	<url-pattern>/redirect</url-pattern>
	<url-pattern>/dwo/oauth2/redirect</url-pattern>
  </servlet-mapping>
 <servlet-mapping>
  	<servlet-name>oauth2-entree</servlet-name>
 	<url-pattern>/dwo/oauth2/entree</url-pattern>
 </servlet-mapping>
  
  
  <!-- Default page to serve -->
  <welcome-file-list>
    <welcome-file>OAuth2Client.html</welcome-file>
  </welcome-file-list>

</web-app>
