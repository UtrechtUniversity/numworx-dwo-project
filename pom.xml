<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>fi.dwo</groupId>
        <artifactId>DWO2</artifactId>
        <version>2.0-SNAPSHOT</version>
        <relativePath>../../../DWO2/branches/working-gert/pom.xml</relativePath>
    </parent>

    <groupId>fi.dwo.gwt.lib.rest</groupId>
    <artifactId>DWO-gwt-lib</artifactId>
    <version>2.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>DWO-gwt-lib trunk</name>
    <build>
        <finalName>${project.artifactId}</finalName>
        <outputDirectory>target/${project.build.finalName}/WEB-INF/classes</outputDirectory>
        <sourceDirectory>src</sourceDirectory>
        <testSourceDirectory>test</testSourceDirectory>
        <resources>
            <resource>
                <directory>src</directory>
            </resource>
        </resources>
        <plugins>
            <!-- Order is important ! Execution follows the declaration order -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.2</version>
                <configuration>
                    <source>1.7</source>
                    <target>1.7</target>
                    <executable>${jdk}/bin/javac</executable>
                    <fork>false</fork>
                    <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>
            </plugin>            
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>2.7</version>
                <configuration>
                    <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>
            </plugin>   
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>2.4</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>            
            <plugin>
                <artifactId>maven-war-plugin</artifactId>
                <configuration>
                    <warSourceDirectory>war</warSourceDirectory>
                    <attachClasses>true</attachClasses>
                    <packagingIncludes>*.css,*gwt/**,${project.artifactId}.html</packagingIncludes>
                </configuration>
            </plugin>
<!--             jetty stuff -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>gwt-maven-plugin</artifactId>
                <version>2.6.0</version>
                <configuration>
                    <module>${project.groupId}.${project.artifactId}</module>
                    <runTarget>${project.artifactId}.html</runTarget>
<!--                    <warSourceDirectory>war</warSourceDirectory>        -->
                    <compileSourcesArtifacts> 
                        <compileSourcesArtifact>fi.dwo.rest:DWO-rest-lib-working-gert</compileSourcesArtifact>
                        <!--                        <compileSourcesArtifact>fi.dwo.rest:DWO-gwt-lib</compileSourcesArtifact> -->
                    </compileSourcesArtifacts> 

                        <i18nMessagesBundles>
                        <i18nMessagesBundle>fi.dwo.rest.locale.Dwo2ExceptionMessages</i18nMessagesBundle>                          
                        <i18nMessagesBundle>fi.dwo.rest.locale.DwoLocaleMessages</i18nMessagesBundle>                          
                    </i18nMessagesBundles>
                    <!-- And the generated sources should be generated in our src dir -->
                    <generateDirectory>${basedir}/src</generateDirectory>
            </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>compile</goal>
                            <goal>i18n</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
<!--            <plugin>
                 usage: jetty:run-war of jetty:run-exploded 
                <groupId>org.eclipse.jetty</groupId>
                <artifactId>jetty-maven-plugin</artifactId>
                <version>9.0.0.v20130308</version>
            </plugin> -->
       </plugins>
    </build>
    <dependencies>
        <dependency>
            <groupId>fi.dwo.rest</groupId>
            <artifactId>DWO-rest-lib</artifactId>
            <version>2.0-SNAPSHOT</version>
        </dependency>      
        <dependency>
            <groupId>fi.dwo.rest</groupId>
            <artifactId>DWO-rest-lib</artifactId>
            <version>2.0-SNAPSHOT</version>
            <classifier>sources</classifier>
        </dependency>
        <dependency>
            <groupId>com.google.gwt</groupId>
            <artifactId>gwt-user</artifactId>
            <version>2.6.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.fusesource.restygwt</groupId>
            <artifactId>restygwt</artifactId>
            <version>2.0.3</version>
        </dependency>
        <dependency>
            <groupId>org.fusesource.restygwt</groupId>
            <artifactId>restygwt</artifactId>
            <version>2.0.3</version>
            <classifier>sources</classifier>
        </dependency>
        <dependency>
            <groupId>javax.ws.rs</groupId>
            <artifactId>javax.ws.rs-api</artifactId>
            <version>2.0.1</version>
        </dependency>
    </dependencies>
