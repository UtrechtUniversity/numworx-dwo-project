		</dependency>
		<dependency>
			<groupId>nl.tue.win.riaca.mathematica</groupId>
			<artifactId>mathematica-phrasebook</artifactId>
			<version>1.3.7</version>
		</dependency>
		<dependency>
			<groupId>fi.servlet</groupId>
			<artifactId>openmath</artifactId>
