<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>nl.uu.fi.dwo</groupId>
        <artifactId>DWO</artifactId>
        <version>2.1.15</version>
        <relativePath>../DWO/pom.xml</relativePath>
    </parent>

    <!--<groupId>nl.uu.fi.dwo.gwt</groupId>-->
    <artifactId>DWO-gwt-lib</artifactId>
    <name>${project.build.finalName}</name>
        <version>2.1.15</version>
    
    <packaging>jar</packaging>
    <developers>
        <developer>
            <id>Gert van der Plas</id>
            <name>plas0006</name>
            <email>g.a.j.vanderplas@uu.nl</email>
            <organization>Freudenthal Institute</organization>
            <organizationUrl>http://www.uu.nl/onderzoek/freudenthal-instituut</organizationUrl>
            <roles>
                <role>Java Developer</role>
            </roles>
        </developer>
        <developer>
            <id>Wim van Velthoven</id>
            <name>velth101</name>
            <email>w.p.g.vanvelthoven@uu.nl</email>
            <organization>Freudenthal Institute</organization>
            <organizationUrl>http://www.uu.nl/onderzoek/freudenthal-instituut</organizationUrl>
            <roles>
                <role>Java Developer</role>
            </roles>
        </developer>
    </developers>
    
    <properties>
        <maven.javadoc.failOnError>false</maven.javadoc.failOnError>
    </properties>
    
    <scm>
        <connection>scm:svn:https://svn.science.uu.nl/repos/project.fisme.java/DWOProject/DWO-LMS/DWO/tags/DWO-2.1.15/trunk</connection>
        <developerConnection>scm:svn:https://svn.science.uu.nl/repos/project.fisme.java/DWOProject/DWO-LMS/DWO/tags/DWO-2.1.15/trunk</developerConnection>
    </scm>
        
    <build>
        <finalName>${project.artifactId}-${project.version}</finalName>
        <outputDirectory>target/${project.build.finalName}/WEB-INF/classes</outputDirectory>
        <sourceDirectory>src</sourceDirectory>
        <testSourceDirectory>test</testSourceDirectory>
        <resources>
            <resource>
                <directory>src</directory>
            </resource>
        </resources>
        <plugins>
            <!-- Order is important ! Execution follows the declaration order -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.2</version>
                <configuration>
                    <source>1.6</source>
                    <target>1.6</target>
                    <executable>${jdk}/bin/javac</executable>
                    <fork>false</fork>
                    <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>
            </plugin>            
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>2.7</version>
                <configuration>
                    <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>
            </plugin>   
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>2.4</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>            
            <plugin>
                <artifactId>maven-war-plugin</artifactId>
                <configuration>
                    <warSourceDirectory>war</warSourceDirectory>
                    <attachClasses>true</attachClasses>
                    <packagingIncludes>*.css,*gwt/**,${project.artifactId}.html</packagingIncludes>
                </configuration>
            </plugin>
            <!--             jetty stuff -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>gwt-maven-plugin</artifactId>
                <version>2.6.0</version>
                <configuration>
                    <module>fi.dwo.gwt.lib.rest.${project.artifactId}</module>
                    <runTarget>${project.artifactId}.html</runTarget>
                    <!--                    <warSourceDirectory>war</warSourceDirectory>        -->
                    <compileSourcesArtifacts> 
                        <!--<compileSourcesArtifact>nl.uu.fi.dwo.rest:DWO-rest-lib</compileSourcesArtifact>--> 
                        <!--<compileSourcesArtifact>fi.dwo.rest:DWO-gwt-lib</compileSourcesArtifact> -->
                    </compileSourcesArtifacts> 

                    <i18nConstantsWithLookupBundles>
                        <i18nConstantsWithLookupBundle>nl.uu.fi.dwo.rest.locale.Dwo2ExceptionMessages</i18nConstantsWithLookupBundle>
                        <i18nConstantsWithLookupBundle>nl.uu.fi.dwo.rest.locale.DwoLocaleMessages</i18nConstantsWithLookupBundle>
                    </i18nConstantsWithLookupBundles>
                    <!-- And the generated sources should be generated in our src dir -->
                    <generateDirectory>${basedir}/src</generateDirectory>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>compile</goal>
                            <!--                             <goal>i18n</goal> -->
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-release-plugin</artifactId>
                <version>2.5.3</version>
                <configuration>
                    <preparationGoals>clean verify install</preparationGoals>
                    <tagBase>https://svn.science.uu.nl/repos/project.fisme.java/DWOProject/DWO-LMS/DWO-gwt-lib/tags/</tagBase>
                </configuration>            
            </plugin>            
            
            <!--            <plugin>
                 usage: jetty:run-war of jetty:run-exploded 
                <groupId>org.eclipse.jetty</groupId>
                <artifactId>jetty-maven-plugin</artifactId>
                <version>9.0.0.v20130308</version>
            </plugin> -->
        </plugins>
    </build>
    <dependencies>
        <dependency>
            <groupId>nl.uu.fi.dwo.rest</groupId>
            <artifactId>DWO-rest-lib</artifactId>
            <version>${project.version}</version>
        </dependency>      
        <dependency>
            <groupId>nl.uu.fi.dwo.rest</groupId>
            <artifactId>DWO-rest-lib</artifactId>
            <version>${project.version}</version>
            <classifier>sources</classifier>
        </dependency>
        <dependency>
            <groupId>com.google.gwt</groupId>
            <artifactId>gwt-user</artifactId>
            <version>2.6.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.fusesource.restygwt</groupId>
            <artifactId>restygwt</artifactId>
            <version>2.2.0</version>
        </dependency>
        <dependency>
            <groupId>org.fusesource.restygwt</groupId>
            <artifactId>restygwt</artifactId>
            <version>2.2.0</version>
            <classifier>sources</classifier>
        </dependency>
        <dependency>
            <groupId>javax.ws.rs</groupId>
            <artifactId>javax.ws.rs-api</artifactId>
            <version>2.0.1</version>
        </dependency>
        <dependency>
            <groupId>nl.uu.fi.dwo.mobile</groupId>
            <artifactId>promise-api</artifactId>
            <version>0.0.1</version>
        </dependency>
        <dependency>
            <groupId>nl.uu.fi.dwo.mobile</groupId>
            <artifactId>promise-api</artifactId>
            <version>0.0.1</version>
            <classifier>sources</classifier>
        </dependency>        
    </dependencies>
