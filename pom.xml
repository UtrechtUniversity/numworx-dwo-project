<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>nl.uu.fi.dwo.mobile</groupId>
  <artifactId>DWOplayer</artifactId>
  <packaging>war</packaging>
  <name>DWO player</name>
  <build>
  	<finalName>${finalName}</finalName>
	<sourceDirectory>src</sourceDirectory>
  	<testSourceDirectory>test</testSourceDirectory>
    <resources>
    	<resource>
    	   <directory>src</directory>
    	   <excludes><exclude>**/*.java</exclude></excludes>  
    	</resource>
    </resources>
  	<plugins>
      <plugin>
        <artifactId>maven-war-plugin</artifactId>
        <configuration>
        	<warSourceDirectory>war</warSourceDirectory>
        	<warSourceIncludes>KeyboardGWT.css,DWOplayer.css,DWOplayer.html,GeoGebra.html,MCSquared.jsp,images/**,scripts/**,WEB-INF/lib/*,WEB-INF/web.xml</warSourceIncludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>gwt-maven-plugin</artifactId>
        <version>${gwtVersion}</version>
         <configuration>
              <module>${gwtModule}</module>
              <runTarget>${project.artifactId}.html</runTarget>
        	  <warSourceDirectory>war</warSourceDirectory>
        	  <extraJvmArgs>-Xms768m -Xmx1024m</extraJvmArgs>        
             </configuration>
        <executions>
          <execution>
            <goals>
              <goal>compile</goal>
             </goals>
          </execution>
          </executions>
      </plugin>
      <plugin>
<!-- usage: jetty:run-war of jetty:run-exploded -->
  		<groupId>org.eclipse.jetty</groupId>
 		<artifactId>jetty-maven-plugin</artifactId>
  			<version>9.0.0.v20130308</version>
  	  </plugin>
    </plugins>
  </build>
  <dependencies>
  	<dependency>
  		<groupId>com.google.gwt</groupId>
  		<artifactId>gwt-user</artifactId>
  		<version>${gwtVersion}</version>
  		<scope>provided</scope>
  	</dependency>
  	<dependency>
  		<groupId>nl.uu.fi.dwo.mobile</groupId>
  		<artifactId>interaction</artifactId>
  		<scope>provided</scope>
  	</dependency>
  	<dependency>
  		<groupId>fi.wiskopdrgwt</groupId>
  		<artifactId>WiskOpdrGWT</artifactId>
  		<version>0.0.1</version>
  		<scope>provided</scope>
  	</dependency>
  	<dependency>
  		<groupId>com.googlecode.mgwt</groupId>
  		<artifactId>MGWT</artifactId>
   		<scope>provided</scope>
  	</dependency>
  	<dependency>
  		<groupId>nl.uu.fi.dwo.mobile</groupId>
  		<artifactId>formule</artifactId>
  		<version>0.0.1</version>
  		<scope>provided</scope>
  	</dependency>
  	<dependency>
  		<groupId>nl.uu.fi.dwo.keyboard</groupId>
  		<artifactId>KeyboardGWT</artifactId>
  		<version>0.0.1</version>
  		<scope>provided</scope>
  	</dependency>
  	<dependency>
  		<groupId>com.fredhat.gwt.xmlrpc</groupId>
  		<artifactId>XmlRpcGWT</artifactId>
  		<version>1.1.1</version>
   		<scope>provided</scope>
  	</dependency>
  	<dependency>
  		<groupId>fi.graphtoolgwt</groupId>
  		<artifactId>GraphToolGWT</artifactId>
  		<version>0.0.1</version>
  		<classifier>classes</classifier>
  		<scope>provided</scope>
  	</dependency>
  	<dependency>
  		<groupId>junit</groupId>
  		<artifactId>junit</artifactId>
  		<version>4.11</version>
  		<scope>test</scope>
  	</dependency>
  	<dependency>
  		<groupId>com.google.gwt</groupId>
  		<artifactId>gwt-dev</artifactId>
  		<version>${gwtVersion}</version>
  		<scope>test</scope>
  	</dependency>
  </dependencies>
  <parent>
  	<groupId>fi.parentgwt</groupId>
  	<artifactId>ParentGWT</artifactId>
  	<version>0.0.1</version>
  	<relativePath>../ParentGWT</relativePath>
  </parent>
  <properties>
  	<maven.test.skip>true</maven.test.skip>
  	<gwtModule>${project.groupId}.${project.artifactId}</gwtModule>
  	<finalName>${project.artifactId}</finalName>
  </properties>
  <profiles>
  	<profile>
  		<id>WiskOpdrPlayer</id>
  		<properties>
  			<finalName>WiskOpdrPlayer</finalName>
  			<gwtModule>${project.groupId}.WiskOpdrPlayer</gwtModule>
  		</properties>
  	</profile>
  	<profile>
  		<id>NoordhoffPlayer</id>
  		<properties>
  			<gwtModule>${project.groupId}.NoordhoffPlayer</gwtModule>
  			<finalName>NoordhoffPlayer</finalName>
  		</properties>
  	</profile>
  	<profile>
  		<id>CDPLogicaPlayer</id>
  		<properties>
  			<gwtModule>${project.groupId}.CDPLogicaPlayer</gwtModule>
  			<finalName>CDPLogicaPlayer</finalName>
  		</properties>
  	</profile>
  <!-- MC Squared profiles -->
   	<profile>
  		<id>MC2Player</id>
  		<properties>
  			<finalName>MC2Player</finalName>
  			<gwtModule>${project.groupId}.MC2Player</gwtModule>
  		</properties>
  	</profile>
   	<profile>
  		<id>MC2LMS</id>
  		<properties>
  			<finalName>MC2LMS</finalName>
  			<gwtModule>${project.groupId}.MC2LMS</gwtModule>
  		</properties>
  	</profile> 
  </profiles>
</project>
