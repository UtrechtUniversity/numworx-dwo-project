            <plugin>
                <artifactId>maven-war-plugin</artifactId>
                <version>2.1.1</version>
                <configuration>
                    <warSourceDirectory>WebContent</warSourceDirectory>
                    <filteringDeploymentDescriptors>true</filteringDeploymentDescriptors>
                    <archive> <!-- add the manifest to the war -->
                        <manifestFile>WebContent/META-INF/MANIFEST.MF</manifestFile>
                    </archive>
                    <attachClasses>true</attachClasses>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.1</version>
            </plugin>
            <plugin>
                <groupId>org.eclipse.jetty</groupId>
                <artifactId>jetty-maven-plugin</artifactId>
                <version>9.3.7.v20160115</version>
                <configuration>
                    <webAppSourceDirectory>WebContent</webAppSourceDirectory>
                    <webApp>
                        <contextPath>/DWOmAccess</contextPath>
                        <descriptor>target/${project.build.finalName}/WEB-INF/web.xml</descriptor>
                    </webApp>
                    <httpConntector>
                        <port>8081</port>
                        <host>127.0.0.1</host>
                    </httpConntector>          
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>com.jamonapi</groupId>
                        <artifactId>jamon</artifactId>
                        <version>2.75</version>
                    </dependency>            
                </dependencies>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>2.18.1</version>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                    <skipTests>true</skipTests> 
                    <!--                   <systemProperties>
                        <property>
