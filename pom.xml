<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>nl.uu.fi.dwo.account</groupId>
    <artifactId>Account</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>war</packaging>

    <name>Account</name>
    <url>http://www.dwo.nl</url>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <webappDirectory>${project.build.directory}/${project.build.finalName}</webappDirectory>
    </properties>
    <build>
        <outputDirectory>target/${project.build.finalName}/WEB-INF/classes</outputDirectory>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-war-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>compile</phase>
                        <goals>
                            <goal>exploded</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <warSourceDirectory>war</warSourceDirectory>
                    <attachClasses>true</attachClasses>
                    <webappDirectory>${webappDirectory}</webappDirectory> 
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>gwt-maven-plugin</artifactId>
                <version>${gwtVersion}</version>
                <configuration>
                    <module>nl.uu.fi.dwo.account.Account</module>
                    <runTarget>${project.artifactId}.html</runTarget>
                    <warSourceDirectory>war</warSourceDirectory>
                    <extraJvmArgs>-Xms768m -Xmx1024m</extraJvmArgs>
                    <hostedWebapp>${webappDirectory}</hostedWebapp>  
                    <compileSourcesArtifacts> 
<!--                        <compileSourcesArtifact>nl.uu.fi.dwo.rest:DWO-rest-lib</compileSourcesArtifact> -->
<!--                        <compileSourcesArtifact>nl.uu.fi.dwo.rest:DWO-gwt-lib</compileSourcesArtifact> -->
                    </compileSourcesArtifacts> 
                    <i18nConstantsWithLookupBundles>
                        <i18nConstantsWithLookupBundle>nl.uu.fi.dwo.rest.locale.Dwo2Exceptions</i18nConstantsWithLookupBundle>                          
                    </i18nConstantsWithLookupBundles>
                    <!-- generate in generated sources, why not? -->
                    <generateDirectory>${basedir}/src/main/java</generateDirectory> 
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>compile</goal>
                            <!-- <goal>i18n</goal> -->
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.tomcat.maven</groupId>
                <artifactId>tomcat7-maven-plugin</artifactId>
                <version>2.2</version>
                <configuration>
                    <server>TomcatServer</server>
                    <username>${tomcat.local.deploy.username}</username>
                    <password>${tomcat.local.deploy.password}</password>
                    <url>${tomcat.local.deploy.url}</url>
                    <path>/Account</path>
                    <warSourceDirectory>target/${project.build.finalName}</warSourceDirectory>
                    <!--                    <warFile>target/${project.artifactId}-${project.version}.war</warFile>-->
                    <!--                   <archiveClasses>true</archiveClasses>                    -->
                </configuration>
            </plugin>            
            <!--            <plugin>
                <groupId>org.mortbay.jetty</groupId>
                <artifactId>maven-jetty-plugin</artifactId>
                <version>6.1.14</version>
                <configuration>
                    <httpConnector>
                        host>localhost</host
                        <port>9999</port>
                    </httpConnector>
                    <webAppSourceDirectory>${project.basedir}/war</webAppSourceDirectory>
                    <scanIntervalSeconds>5</scanIntervalSeconds>
                </configuration>
            </plugin>                       -->
        </plugins>
    </build>
