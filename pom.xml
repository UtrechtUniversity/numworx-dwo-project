<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>nl.uu.fi.dwo.mobile</groupId>
	<artifactId>DWOplayer</artifactId>
	<packaging>war</packaging>
	<name>DWO player</name>
	<build>
		<extensions>
			<extension>
				<groupId>org.kuali.maven.wagons</groupId>
				<artifactId>maven-s3-wagon</artifactId>
				<version>1.2.1</version>
			</extension>
			<extension>
				<groupId>org.apache.maven.wagon</groupId>
				<artifactId>wagon-ssh</artifactId>
				<version>2.8</version>
			</extension>
		</extensions>
		<finalName>${finalName}</finalName>
		<sourceDirectory>src</sourceDirectory>
		<testSourceDirectory>test</testSourceDirectory>
		<resources>
			<resource>
				<directory>src</directory>
				<excludes>
					<exclude>**/*.java</exclude>
				</excludes>
			</resource>
		</resources>
		<plugins>
			<plugin>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.6.1</version>
				<configuration>
		<annotationProcessorPaths>
			<path>
			<groupId>com.google.dagger</groupId>
			<artifactId>dagger-compiler</artifactId>
			<version>${daggerVersion}</version>
			</path>
		</annotationProcessorPaths>
				</configuration>
			</plugin>			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>buildnumber-maven-plugin</artifactId>
				<version>1.3</version>
				<executions>
					<execution>
						<phase>generate-sources</phase>
						<goals>
							<goal>create</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<!-- doCheck and doUpdate actually talk to repository if it's true, 
						Check would check that there are no local changes. Update would update it -->
					<doCheck>false</doCheck>
					<doUpdate>false</doUpdate>
					<!-- This ensures that even if we are not connected to scm than also 
						take the version from local .svn file -->
					<revisiononscmfailure>

						<!-- Generate sequence build number based on: build number and timestamp -->
						<format>Build: #{0} ({1,date})</format>
						<items>
							<item>buildNumber\d*</item>
							<item>timestamp</item>
						</items>
					</revisiononscmfailure>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>templating-maven-plugin</artifactId>
				<version>1.0.0</version>
				<executions>
					<execution>
						<id>filter-src</id>
						<goals>
							<goal>filter-sources</goal>
						</goals>
						<configuration>
							<sourceDirectory>${basedir}/java-templates</sourceDirectory>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<artifactId>maven-war-plugin</artifactId>
				<version>3.0.0</version>
				<configuration>
					<warSourceDirectory>war</warSourceDirectory>
					<warSourceIncludes>DWOplayer.jsp,KeyboardGWT.css,DWOplayer.css,${runTarget},GeoGebra.html,MCSquared.jsp,images/**,scripts/**,WEB-INF/lib/*,WEB-INF/web.xml</warSourceIncludes>
					<classifier>${warClassifier}</classifier>
					<failOnMissingWebXml>false</failOnMissingWebXml>
					<packagingIncludes>**</packagingIncludes>
					<packagingExcludes>WEB-INF/classes/**,WEB-INF/lib/**,WEB-INF/deploy/**</packagingExcludes>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>gwt-maven-plugin</artifactId>
				<version>${gwtVersion}</version>
				<configuration>
					<module>${gwtModule}</module>
					<runTarget>${runTarget}</runTarget>
					<warSourceDirectory>war</warSourceDirectory>
					<extraJvmArgs>-Xms768m -Xmx2048m</extraJvmArgs>
					<webXml>war/WEB-INF/web.xml</webXml>
					<i18nConstantsWithLookupBundles>
						<i18nConstantsWithLookupBundle>nl.uu.fi.dwo.mobile.client.ui.views.interactionviews.mapperconstants.Hint</i18nConstantsWithLookupBundle>
						<i18nConstantsWithLookupBundle>nl.uu.fi.dwo.mobile.client.ui.views.interactionviews.mapperconstants.Feedback</i18nConstantsWithLookupBundle>
					</i18nConstantsWithLookupBundles>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>i18n</goal>
							<goal>compile</goal>
							<goal>test</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<!-- usage: jetty:run-war of jetty:run-exploded -->
				<groupId>org.eclipse.jetty</groupId>
				<artifactId>jetty-maven-plugin</artifactId>
				<version>9.0.0.v20130308</version>
			</plugin>
		</plugins>
	</build>
	<dependencies>
		<dependency>
			<groupId>com.google.gwt</groupId>
			<artifactId>gwt-user</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>nl.uu.fi.dwo.mobile</groupId>
			<artifactId>interaction</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>nl.uu.fi.dwo.mobile</groupId>
			<artifactId>interaction</artifactId>
			<scope>provided</scope>
			<classifier>sources</classifier>
		</dependency>
		<dependency>
			<groupId>com.googlecode.mgwt</groupId>
			<artifactId>MGWT</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>nl.uu.fi.dwo.keyboard</groupId>
			<artifactId>KeyboardGWT</artifactId>
			<version>2.4.7</version>
			<exclusions>
				<exclusion>
					<groupId>fi.wiskopdrgwt</groupId>
					<artifactId>WiskOpdrGWT</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<version>4.12</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.google.gwt</groupId>
			<artifactId>gwt-dev</artifactId>
			<version>${gwtVersion}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.mitre.dsmiley.httpproxy</groupId>
			<artifactId>smiley-http-proxy-servlet</artifactId>
			<version>1.7</version>
			<scope>runtime</scope>
		</dependency>

		<dependency>
			<groupId>nl.uu.fi.dwo.account</groupId>
			<artifactId>Account</artifactId>
			<version>${accountVersion}</version>
			<classifier>classes</classifier>
		</dependency>
		<dependency>
			<groupId>nl.uu.fi.dwo.account</groupId>
			<artifactId>Account</artifactId>
			<version>${accountVersion}</version>
			<classifier>sources</classifier>
		</dependency>
		<dependency>
			<groupId>nl.uu.fi.dwo.ideas</groupId>
			<artifactId>IdeasGWT</artifactId>
			<version>0.1.1</version>
		</dependency>
		<dependency>
			<groupId>nl.uu.fi.dwo.mobile</groupId>
			<artifactId>formule</artifactId>
			<version>0.1.12</version>
		</dependency>
		<dependency>
			<groupId>nl.numworx.gwtpatch</groupId>
			<artifactId>gwtpatch</artifactId>
			<version>0.0.3</version>
		</dependency>
		<dependency>
			<groupId>nl.numworx.gwtpatch</groupId>
			<artifactId>gwtpatch</artifactId>
			<version>0.0.3</version>
			<classifier>sources</classifier>
		</dependency>
		<dependency>
			<groupId>javax.xml.bind</groupId>
			<artifactId>jaxb-api</artifactId>
			<version>2.3.0</version>
			<classifier>sources</classifier>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>com.google.dagger</groupId>
			<artifactId>dagger-gwt</artifactId>
			<version>${daggerVersion}</version>
		</dependency>
		<dependency>
		    <groupId>com.vaadin.addon</groupId>
		    <artifactId>pointer-events</artifactId>
		    <version>1.0</version>
		</dependency>
        <dependency>
            <groupId>com.owlike</groupId>
            <artifactId>genson</artifactId>
            <version>1.4</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.owlike</groupId>
            <artifactId>genson</artifactId>
            <version>1.4</version>
			<classifier>sources</classifier>
            <scope>provided</scope>
        </dependency> 
        <dependency>
       		<groupId>com.google.code.findbugs</groupId>
			<artifactId>jsr305</artifactId>
			<version>1.3.9</version>
        	<scope>provided</scope>
        </dependency>
<!-- 		<dependency> -->
<!-- 			<groupId>fi.graphtoolgwt</groupId> -->
<!-- 			<artifactId>GraphToolGWT</artifactId> -->
<!-- 			<version>2.3.3-SNAPSHOT</version> -->
<!-- 			<classifier>classes</classifier> -->
<!-- 		</dependency> -->
	</dependencies>
	<parent>
		<groupId>nl.uu.fi.dwo</groupId>
		<artifactId>DWO-GWT</artifactId>
		<version>1.1</version>
		<relativePath>../DWO-GWT</relativePath>
	</parent>
	<properties>
		<daggerVersion>2.11</daggerVersion>
		<maven.test.skip>true</maven.test.skip>
		<gwtModule>${project.groupId}.DWO2playerDebug</gwtModule>
		<finalName>${project.artifactId}</finalName>
		<runTarget>${project.artifactId}.html</runTarget>
		<warClassifier />
		<gwt.copyWebapp>true</gwt.copyWebapp>
		<accountVersion>2.4.18</accountVersion>
		<gwtVersion>2.8.2</gwtVersion>
        <maven.javadoc.failOnError>false</maven.javadoc.failOnError>
        <maven.javadoc.skip>true</maven.javadoc.skip>
	</properties>
	<profiles>
		<profile>
			<id>WiskOpdrPlayerDebug</id>
			<properties>
				<finalName>WiskOpdrPlayerDebug</finalName>
				<gwtModule>${project.groupId}.WiskOpdrPlayerDebug</gwtModule>
				<gwt.style>PRETTY</gwt.style>
			</properties>
		</profile>
		<profile>
			<id>WiskOpdrPlayer</id>
			<properties>
				<finalName>WiskOpdrPlayer</finalName>
				<gwtModule>${project.groupId}.WiskOpdrPlayer</gwtModule>
				<wagonPhase>none</wagonPhase>
				<s3>s3://ebs-dev-dwo-nl</s3>
				<gwt.style>OBFUSCATED</gwt.style>
			</properties>
		<build>
			<plugins>
			  <plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>wagon-maven-plugin</artifactId>
				<version>1.0</version>
				<executions>
					<execution>
						<id>upload</id>
						<goals>
							<goal>upload</goal>
						</goals>
						<phase>${wagonPhase}</phase>
					</execution>
				</executions>
				<configuration>
					<fromDir>${project.build.directory}/${finalName}/</fromDir>
					<includes>DWOplayer.css,images/**,DWOplayer/**</includes>
					<!-- <serverId>staff</serverId> -->
					<!-- <url>scp://gemini.science.uu.nl/home/staff/velth101/tmp</url> -->
					<serverId>ubuntu</serverId>
					<url>${s3}</url>
					<toDir>apps</toDir>
				</configuration>

			</plugin>
			
			</plugins>
		</build>
		</profile>
		<profile>
			<id>WidgetPlayer</id>
			<properties>
				<warClassifier>widget</warClassifier>
				<maven.war.webxml>war/WEB-INF/web-dwo2.xml</maven.war.webxml>
				<finalName>WidgetPlayer</finalName>
				<gwtModule>${project.groupId}.WidgetPlayer</gwtModule>
				<wagonPhase>none</wagonPhase>
				<gwt.copyWebapp>false</gwt.copyWebapp>
				<s3>s3://ebs-dev-dwo-nl</s3>
			</properties>
		</profile>
		<profile>
			<id>NoordhoffPlayer</id>
			<properties>
				<gwtModule>${project.groupId}.NoordhoffPlayer</gwtModule>
				<finalName>NoordhoffPlayer</finalName>
			</properties>
		</profile>
		<profile>
			<id>CDPLogicaPlayer</id>
			<properties>
				<gwtModule>${project.groupId}.CDPLogicaPlayer</gwtModule>
				<finalName>CDPLogicaPlayer</finalName>
			</properties>
		</profile>
		<profile>
			<id>TinCanPlayer</id>
			<properties>
				<gwtModule>${project.groupId}.TinCanPlayer</gwtModule>
				<finalName>TinCanPlayer</finalName>
				<warClassifier>xapi</warClassifier>
				<maven.war.webxml>war/WEB-INF/web-dwo2.xml</maven.war.webxml>
				<gwt.copyWebapp>false</gwt.copyWebapp>
				<gwt.style>PRETTY</gwt.style>
			</properties>
		</profile>
		<profile>
			<id>DWO2player</id>
			<properties>
				<finalName>DWO2player</finalName>
				<gwtModule>${project.groupId}.DWO2player</gwtModule>
				<warClassifier>dwo2</warClassifier>
				<maven.war.webxml>war/WEB-INF/web-dwo2.xml</maven.war.webxml>
				<gwt.copyWebapp>false</gwt.copyWebapp>
				<!-- <gwt.style>PRETTY</gwt.style> -->
				<gwt.compiler.force>true</gwt.compiler.force>
				<gwt.compiler.localWorkers>3</gwt.compiler.localWorkers>
        		<maven.javadoc.failOnError>false</maven.javadoc.failOnError>
			</properties>
			<build>
				<plugins>
					<plugin>
                		<groupId>org.apache.maven.plugins</groupId>
                		<artifactId>maven-release-plugin</artifactId>
                		<version>2.5.3</version>         
            		</plugin>
				</plugins>
			</build>
		</profile>
		<profile> <!-- gebruik deze voor gwt:run -->
			<id>DWO2player-run</id>
			<properties>
				<finalName>DWO2player</finalName>
				<gwtModule>${project.groupId}.DWO2player</gwtModule>
				<gwt.copyWebapp>true</gwt.copyWebapp>
			</properties>
		</profile>
		<profile>
			<id>Trifork</id>
			<properties>
				<gwtModule>${project.groupId}.Trifork</gwtModule>
				<finalName>Trifork</finalName>
				<gwt.style>PRETTY</gwt.style>
			</properties>
		</profile>
	</profiles>
	<version>2.4.20-SNAPSHOT</version>
	<scm>
		<developerConnection>scm:svn:https://svn.science.uu.nl/repos/project.fisme.java/DwoPlayer/GWT/trunk</developerConnection>
	</scm>
</project>
