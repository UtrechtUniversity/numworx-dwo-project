<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>nl.uu.fi.dwo.mobile</groupId>
	<artifactId>DWOplayer</artifactId>
	<packaging>war</packaging>
	<name>DWO player</name>
	<build>
		<finalName>${finalName}</finalName>
		<sourceDirectory>src</sourceDirectory>
		<testSourceDirectory>test</testSourceDirectory>
		<resources>
			<resource>
				<directory>src</directory>
				<excludes>
					<exclude>**/*.java</exclude>
				</excludes>
			</resource>
		</resources>
		<plugins>
           <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>buildnumber-maven-plugin</artifactId>
                <version>1.3</version>
                <executions>
                    <execution>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>create</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <!--
                     doCheck and doUpdate actually talk to repository if it's true,
                     Check would check that there are no local changes.
                     Update would update it
                    -->
                    <doCheck>false</doCheck>
                    <doUpdate>false</doUpdate>
                    <!--
                     This ensures that even if we are not connected to scm than also
                     take the version from local .svn file
                    -->
                    <revisiononscmfailure>
       
                        <!--
                         Generate sequence build number based on:
                         build number and timestamp     
                        -->
                        <format>Build: #{0} ({1,date})</format>
                        <items>
                            <item>buildNumber\d*</item>
                            <item>timestamp</item>
                        </items>
                    </revisiononscmfailure>
                </configuration>
            </plugin>    
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>templating-maven-plugin</artifactId>
				<version>1.0.0</version>
				<executions>
					<execution>
						<id>filter-src</id>
						<goals>
							<goal>filter-sources</goal>
						</goals>
						<configuration>
							<sourceDirectory>${basedir}/java-templates</sourceDirectory>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<artifactId>maven-war-plugin</artifactId>
				<configuration>
					<warSourceDirectory>war</warSourceDirectory>
					<warSourceIncludes>KeyboardGWT.css,DWOplayer.css,${runTarget},GeoGebra.html,MCSquared.jsp,images/**,scripts/**,WEB-INF/lib/*,WEB-INF/web.xml</warSourceIncludes>
					<classifier>${warClassifier}</classifier>
					<failOnMissingWebXml>false</failOnMissingWebXml>
					<packagingIncludes>**</packagingIncludes>
					<packagingExcludes>WEB-INF/classes/**,WEB-INF/lib/**,WEB-INF/deploy/**</packagingExcludes>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>gwt-maven-plugin</artifactId>
				<version>${gwtVersion}</version>
				<configuration>
					<module>${gwtModule}</module>
					<runTarget>${runTarget}</runTarget>
					<warSourceDirectory>war</warSourceDirectory>
					<extraJvmArgs>-Xms768m -Xmx1024m</extraJvmArgs>
					<webXml>war/WEB-INF/web.xml</webXml>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>compile</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<!-- usage: jetty:run-war of jetty:run-exploded -->
				<groupId>org.eclipse.jetty</groupId>
				<artifactId>jetty-maven-plugin</artifactId>
				<version>9.0.0.v20130308</version>
			</plugin>
		</plugins>
	</build>
	<dependencies>
		<dependency>
			<groupId>com.google.gwt</groupId>
			<artifactId>gwt-user</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>nl.uu.fi.dwo.mobile</groupId>
			<artifactId>interaction</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>com.googlecode.mgwt</groupId>
			<artifactId>MGWT</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>nl.uu.fi.dwo.keyboard</groupId>
			<artifactId>KeyboardGWT</artifactId>
			<version>2.1.15</version>
		</dependency>
		<dependency>
			<groupId>com.fredhat.gwt.xmlrpc</groupId>
			<artifactId>XmlRpcGWT</artifactId>
			<version>1.1.1</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>fi.graphtoolgwt</groupId>
			<artifactId>GraphToolGWT</artifactId>
			<version>0.0.3</version>
			<classifier>classes</classifier>
			<exclusions>
				<exclusion>
					<artifactId>WiskOpdrGWT</artifactId>
					<groupId>fi.wiskopdrgwt</groupId>
				</exclusion>
				<exclusion>
					<groupId>nl.uu.fi.dwo.mobile</groupId>
					<artifactId>formule</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<version>4.11</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.google.gwt</groupId>
			<artifactId>gwt-dev</artifactId>
			<version>${gwtVersion}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.mitre.dsmiley.httpproxy</groupId>
			<artifactId>smiley-http-proxy-servlet</artifactId>
			<version>1.7</version>
			<scope>runtime</scope>
		</dependency>

		<dependency>
			<groupId>nl.uu.fi.dwo.account</groupId>
			<artifactId>Account</artifactId>
			<version>${accountVersion}</version>
			<classifier>classes</classifier>
		</dependency>
		<dependency>
			<groupId>nl.uu.fi.dwo.account</groupId>
			<artifactId>Account</artifactId>
			<version>${accountVersion}</version>
			<classifier>sources</classifier>
		</dependency>
		<dependency>
			<groupId>nl.uu.fi.dwo.ideas</groupId>
			<artifactId>IdeasGWT</artifactId>
			<version>0.0.2</version>
		</dependency>
		<dependency>
			<groupId>nl.uu.fi.dwo.mobile</groupId>
			<artifactId>formule</artifactId>
			<version>0.0.4</version>
		</dependency>
	</dependencies>
	<parent>
		<groupId>fi.parentgwt</groupId>
		<artifactId>ParentGWT</artifactId>
		<version>0.0.3</version>
		<relativePath>../ParentGWT</relativePath>
	</parent>
	<properties>
		<maven.test.skip>true</maven.test.skip>
		<gwtModule>${project.groupId}.DWO2player</gwtModule>
		<finalName>${project.artifactId}</finalName>
		<runTarget>${project.artifactId}.html</runTarget>
		<warClassifier />
		<gwt.copyWebapp>true</gwt.copyWebapp>
		<accountVersion>0.0.9</accountVersion>
	</properties>
	<profiles>
		<profile>
			<id>WiskOpdrPlayer</id>
			<properties>
				<finalName>WiskOpdrPlayer</finalName>
				<gwtModule>${project.groupId}.WiskOpdrPlayer</gwtModule>
			</properties>
		</profile>
		<profile>
			<id>NoordhoffPlayer</id>
			<properties>
				<gwtModule>${project.groupId}.NoordhoffPlayer</gwtModule>
				<finalName>NoordhoffPlayer</finalName>
			</properties>
		</profile>
		<profile>
			<id>CDPLogicaPlayer</id>
			<properties>
				<gwtModule>${project.groupId}.CDPLogicaPlayer</gwtModule>
				<finalName>CDPLogicaPlayer</finalName>
			</properties>
		</profile>
		<profile>
			<id>TinCanPlayer</id>
			<properties>
				<gwtModule>${project.groupId}.TinCanPlayer</gwtModule>
				<finalName>TinCanPlayer</finalName>
			</properties>
		</profile>
		<!-- MC Squared profiles -->
		<profile>
			<id>MC2Player</id>
			<properties>
				<finalName>MC2Player</finalName>
				<gwtModule>${project.groupId}.MC2Player</gwtModule>
			</properties>
		</profile>
		<profile>
			<id>MC2LMS</id>
			<properties>
				<finalName>MC2LMS</finalName>
				<gwtModule>${project.groupId}.MC2LMS</gwtModule>
			</properties>
		</profile>
		<profile>
			<id>DWO2player</id>
			<properties>
				<finalName>DWO2player</finalName>
				<gwtModule>${project.groupId}.DWO2player</gwtModule>
				<warClassifier>dwo2</warClassifier>
				<maven.war.webxml>war/WEB-INF/web-dwo2.xml</maven.war.webxml>
				<gwt.copyWebapp>false</gwt.copyWebapp>
<!-- 				<gwt.style>PRETTY</gwt.style> -->
				<gwt.compiler.force>true</gwt.compiler.force>	
			</properties>
		</profile>
		<profile> <!-- gebruik deze voor gwt:run -->
			<id>DWO2player-run</id>
			<properties>
				<finalName>DWO2player</finalName>
				<gwtModule>${project.groupId}.DWO2player</gwtModule>
				<gwt.copyWebapp>true</gwt.copyWebapp>
			</properties>
		</profile>
		<profile>
			<id>Trifork</id>
			<properties>
				<gwtModule>${project.groupId}.Trifork</gwtModule>
				<finalName>Trifork</finalName>
				<gwt.style>PRETTY</gwt.style>
			</properties>
		</profile>
	</profiles>
	<version>2.1.16</version>
	<scm>
		<developerConnection>scm:svn:https://svn.science.uu.nl/repos/project.fisme.java/DwoPlayer/GWT/DWOplayer</developerConnection>
	</scm>
</project>
