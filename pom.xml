<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
 
    <!-- Adjust artifact, name and description for new projects -->
    <parent>
        <groupId>fi.dwo</groupId>
        <artifactId>DWO2</artifactId>
        <version>2.0-SNAPSHOT</version>
        <relativePath>../../../DWO2/branches/working/pom.xml</relativePath>
    </parent>
    <!-- Adjust artifact, name and description for new projects -->
    <artifactId>DWOJApplet</artifactId>
    <version>2.0-SNAPSHOT</version>
    <name>DWOJApplet - working</name>
    <url>http://www.dwo.nl</url>
    <packaging>jar</packaging>
    <!-- Update year to current when starting a new project -->
    <inceptionYear>2015</inceptionYear> 
    <organization>
        <name>Freudenthal Institute</name>
        <url>http://www.uu.nl/onderzoek/freudenthal-instituut</url>
    </organization>

    <developers>
        <developer>
            <id>Gert van der Plas</id>
            <name>plas0006</name>
            <email>g.a.j.vanderplas@uu.nl</email>
            <organization>Freudenthal Institute</organization>
            <organizationUrl>http://www.uu.nl/onderzoek/freudenthal-instituut</organizationUrl>
            <roles>
                <role>Administrator</role>
                <role>Java Developer</role>
            </roles>
        </developer>
    </developers>

    <!-- update the https path for a different branch or tag! -->
    <scm>
        <developerConnection>scm:svn:https://svn.science.uu.nl/repos/project.fisme.java/DWOJApplet/trunk</developerConnection>
        <tag>HEAD</tag>
    </scm>

    <!-- dependencies -->
    <dependencies>        
        <dependency>
            <groupId>fi.dwo</groupId>
            <artifactId>DWO-commons-lib</artifactId>
            <version>2.0-SNAPSHOT</version>
            <type>jar</type>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.12</version>
            <scope>test</scope>
        </dependency>  
        <dependency>
            <groupId>com.googlecode.json-simple</groupId>
            <artifactId>json-simple</artifactId>
            <version>1.1.1</version>
        </dependency>        
        <!-- Jcalendar spinoff with time-zone support -->
        <dependency>
            <groupId>com.toedter</groupId>
            <artifactId>jcalendar</artifactId>
            <version>1.4</version>
        </dependency>
<!--        <dependency>
            <groupId>fi</groupId>
            <artifactId>WiskOpdr</artifactId>
            <version>0.0.0</version>
        </dependency>-->
        <dependency>
            <groupId>jre.plugin</groupId>
            <artifactId>plugin</artifactId>
            <version>1.8.0_31</version>
            <type>jar</type>
            <classifier>deprecated</classifier>
            <scope>provided</scope>
        </dependency>
        <!-- is required for unmarshalling json stuff -->         
       <dependency>
            <groupId>org.eclipse.persistence</groupId>
            <artifactId>eclipselink</artifactId>
            <version>2.5.2</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.persistence</groupId>
            <artifactId>org.eclipse.persistence.jpa.modelgen.processor</artifactId>
            <version>2.5.2</version>
        </dependency>
        
        <!-- Required only when you are using JAX-RS Client -->
        <dependency>
            <groupId>org.glassfish.jersey.core</groupId>
            <artifactId>jersey-client</artifactId>
            <version>2.17</version>
        </dependency>
        <!-- json support -->
        <dependency>
            <groupId>org.glassfish.jersey.media</groupId>
            <artifactId>jersey-media-moxy</artifactId>
            <version>2.17</version>
        </dependency>
        <dependency>
            <groupId>org.jdesktop</groupId>
            <artifactId>beansbinding</artifactId>
            <version>1.2.1</version>
        </dependency>
    </dependencies>

    <build>
        <!-- order is relevant -->
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.2</version>
                <configuration>
                    <source>1.6</source>
                    <target>1.6</target>
                    <encoding>${project.build.sourceEncoding}</encoding>
                    <showDeprecation>true</showDeprecation>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>2.7</version>
                <configuration>
                    <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>
            </plugin>      
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>2.18.1</version>
                <configuration>
                    <skipTests>true</skipTests>
                </configuration>
            </plugin>
            <!-- ensure the build number is available as ${buildNumber} -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>buildnumber-maven-plugin</artifactId>
                <version>1.3</version>
                <executions>
                    <execution>
                        <phase>validate</phase>
                        <goals>
                            <goal>create</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <doCheck>false</doCheck>
                    <doUpdate>true</doUpdate>
                </configuration>
            </plugin>    
            
            <!-- put the build number in the manifest -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>2.5</version>
                <configuration>
                    <archive>
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                            <addClasspath>true</addClasspath>
                        </manifest>
                        <manifestEntries>
                            <DWOJApplet-Implementation-Version>${project.version}</DWOJApplet-Implementation-Version>
                            <Implementation-Build>${buildNumber}</Implementation-Build>
                            <DWOJApplet-Implementation-Build>${buildNumber}</DWOJApplet-Implementation-Build>
                            <Main-Class>fi.dwo.dwojapplet.domain.DWO</Main-Class>
                            <Trusted-Only>true</Trusted-Only>
                            <Permissions>all-permissions</Permissions>
                            <Codebase>*.uu.nl spindle.fisme.uu.nl *.fi.uu.nl dme.colorado.edu *.appspot.com *.dwo.nl localhost dme.mathhouse.org</Codebase>
                            <Caller-Allowable-Codebase>*.uu.nl spindle.fisme.uu.nl *.fi.uu.nl dme.colorado.edu *.appspot.com *.dwo.nl localhost dme.mathhouse.org</Caller-Allowable-Codebase>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <Main-Class>fi.dwo.dwojapplet.domain.DWO</Main-Class>
                        </manifest>
                    </archive>
                    <descriptorRefs>
                        <descriptorRef>jar-with-dependencies</descriptorRef>
                    </descriptorRefs>
                </configuration>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>       
        </plugins>
        <finalName>${project.artifactId}-${project.version}-r${buildNumber}</finalName>
    </build>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>1.6</maven.compiler.source>
        <maven.compiler.target>1.6</maven.compiler.target>
    </properties>
    
<!--    <repositories>
        <repository>
            <id>maven-pack200-plugin</id>
            <url>https://oss.sonatype.org/content/repositories/releases/com/github/batkinson/plugins/maven-pack200-plugin/</url>
        </repository>
            <repository>
            <id>xmlrpc</id>
            <url>http://ws.apache.org/xmlrpc/</url>
        </repository>
    </repositories> -->
    
    <profiles>
        <profile>
            <id>dwo-obfuscate</id> 
            <activation>
                <property>
                    <name>profile.dwo-obfuscate-pack-sign</name>
                </property>
            </activation>            
            <build>
                <plugins>
                    <!-- proguard obfuscation -->            
                    <plugin>
                        <groupId>com.github.wvengen</groupId>
                        <artifactId>proguard-maven-plugin</artifactId>
                        <version>2.0.8</version>
                        <executions>
                            <execution>
                                <phase>package</phase>
                                <goals>
                                    <goal>proguard</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <proguardVersion>5.2</proguardVersion>
                            <options>
                                <option>-verbose</option>
                                <option>-dontwarn</option> 
                                <option>-printconfiguration mapping.txt</option>
                            </options>
                            <obfuscate>true</obfuscate>                    
                            <inputDirectory>${project.build.directory}</inputDirectory>
                            <injar>${project.build.finalName}.jar</injar>
                            <!-- uncomment to change the output file
                            <outputDirectory>${project.build.directory}</outputDirectory>
                            <outjar>${project.build.finalName}-proguarded.jar</outjar>
                            -->
                            <proguardInclude>config.pro</proguardInclude>
                            <libs>
                                <lib>${java.home}/lib/rt.jar</lib>
                                <lib>${java.home}/lib/jsse.jar</lib>
                                <lib>${java.home}/lib/jfxrt.jar</lib>                       
                            </libs>
                            <addMavenDescriptor>false</addMavenDescriptor>
                        </configuration>
                        <dependencies>
                            <dependency>
                                <groupId>net.sf.proguard</groupId>
                                <artifactId>proguard-base</artifactId>
                                <version>5.2</version>
                                <scope>runtime</scope>
                            </dependency>
                        </dependencies>
                    </plugin>
                </plugins>      
            </build>
        </profile>
        <profile>
            <id>dwo-pack-sign</id> 
            <activation>
                <property>
                    <name>profile.dwo-obfuscate-pack-sign</name>
                </property>
            </activation>              
            <build>
                <plugins>
                    <!-- repack as pack200 -->
                    <plugin>
                        <groupId>com.github.batkinson.plugins</groupId>
                        <artifactId>maven-pack200-plugin</artifactId>
                        <version>1.0.1</version>
                        <executions>
                            <execution>
                                <id>normalize-jars</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>pack</goal>
                                </goals>
                                <configuration>
                                    <normalizeOnly>true</normalizeOnly>
                                </configuration>
                            </execution>
                            <execution>
                                <id>pack-jars</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>pack</goal>
                                </goals>
                                <configuration>
                                    <normalizeOnly>false</normalizeOnly>
                                </configuration>
                            </execution>
                        </executions>
                        <configuration>
                            <processMainArtifact>true</processMainArtifact>
                            <includeClassifiers>
                                <includeClassifier>all-in-one</includeClassifier>
                            </includeClassifiers>
                        </configuration>                
                        <dependencies>
                            <dependency>
                                <groupId>com.github.batkinson.plugins</groupId>
                                <artifactId>maven-pack200-plugin</artifactId>
                                <version>1.0.1</version>
                                <type>maven-plugin</type>
                            </dependency>
                        </dependencies>                
                    </plugin>        
                    <!-- jar signing TODO -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jarsigner-plugin</artifactId>
                        <version>1.4</version>
                        <executions>
                            <execution>
                                <phase>package</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>verify</id>
                                <goals>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <keystore>${dwoKeyStore}</keystore>
                            <alias>${dwoCertKeyAlias}</alias>
                            <storepass>${dwoCertKeyStorePassword}</storepass>
                            <keypass>${dwoCertKeyPassword}</keypass>
                            <sigfile>UU</sigfile>
                            <tsa>https://timestamp.geotrust.com/tsa</tsa>
                        </configuration>            
                    </plugin>  
                </plugins>      
            </build>
        </profile>
    </profiles>
</project>
