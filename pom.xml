<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>nl.uu.fi.dwo.account</groupId>
    <artifactId>Account</artifactId>
    <version>0.0.7-SNAPSHOT</version>
    <packaging>war</packaging>

    <name>${project.build.finalName}</name>
    <url>http://www.dwo.nl</url>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <webappDirectory>${project.build.directory}/${project.build.finalName}</webappDirectory>
        <dwoVersion>2.1.9-SNAPSHOT</dwoVersion>
        <maven.javadoc.failOnError>false</maven.javadoc.failOnError>
        <maven.test.skip>true</maven.test.skip>
    </properties>
    <build>
        <outputDirectory>target/${project.build.finalName}/WEB-INF/classes</outputDirectory>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-war-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>compile</phase>
                        <goals>
                            <goal>exploded</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <warSourceDirectory>war</warSourceDirectory>
                    <attachClasses>true</attachClasses>
                    <webappDirectory>${webappDirectory}</webappDirectory> 
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>gwt-maven-plugin</artifactId>
                <version>${gwtVersion}</version>
                <configuration>
                    <module>nl.uu.fi.dwo.account.boot</module>
                    
                    <runTarget>boot.html</runTarget>
                    <hostedWebapp>${webappDirectory}</hostedWebapp>
                    <warSourceDirectory>war</warSourceDirectory>
                    <extraJvmArgs>-Xms768m -Xmx1024m</extraJvmArgs>
                    <hostedWebapp>${webappDirectory}</hostedWebapp>  
                    <compileSourcesArtifacts> 
                        <!--                        <compileSourcesArtifact>nl.uu.fi.dwo.rest:DWO-rest-lib</compileSourcesArtifact> -->
                        <!--                        <compileSourcesArtifact>nl.uu.fi.dwo.rest:DWO-gwt-lib</compileSourcesArtifact> -->
                    </compileSourcesArtifacts> 
                    <i18nConstantsWithLookupBundles>
                        <i18nConstantsWithLookupBundle>nl.uu.fi.dwo.rest.locale.Dwo2Exceptions</i18nConstantsWithLookupBundle>                          
                    </i18nConstantsWithLookupBundles>
                    <!-- generate in generated sources, why not? -->
                    <generateDirectory>${basedir}/src/main/java</generateDirectory> 
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>compile</goal>
                            <!-- <goal>i18n</goal> -->
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.tomcat.maven</groupId>
                <artifactId>tomcat7-maven-plugin</artifactId>
                <version>2.2</version>
                <configuration>
                    <server>TomcatServer</server>
                    <path>/Account</path>
                    <warFile>target/${project.artifactId}-${project.version}.war</warFile>
                    <tomcat.local.deploy.url>http://127.0.0.1:8080/manager/text</tomcat.local.deploy.url> 
                    <warSourceDirectory>target/${project.artifactId}-${project.version}</warSourceDirectory>
                    <archiveClasses>true</archiveClasses> 
<!--                    <webapps> 
                        <webapp> 
                            <groupId>nl.uu.fi.dwo</groupId>
                            <artifactId>DWOServer</artifactId>
                            <version>2.1.8-SNAPSHOT</version>
                            <type>war</type>
                            <asWebapp>true</asWebapp> 
                        </webapp> 
                    </webapps>
                            <dependencies>
                                <dependency>
                                    <groupId>mysql</groupId>
                                    <artifactId>mysql-connector-java</artifactId>
                                    <version>5.1.34</version>
                                </dependency>
                                <dependency>
                                    <groupId>com.jamonapi</groupId>
                                    <artifactId>jamon</artifactId>
                                    <version>2.80</version>
                                </dependency>        
                            </dependencies>                    -->
                </configuration>                                        
            </plugin>            
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-release-plugin</artifactId>
                <version>2.5.3</version>
                <configuration>
                    <goals>deploy</goals>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <dependencies>
        <dependency>
            <groupId>nl.uu.fi.dwo</groupId>
            <artifactId>DWO-gwt-lib</artifactId>
            <version>${dwoVersion}</version>
        </dependency>
        <dependency>
            <groupId>nl.uu.fi.dwo</groupId>
            <artifactId>DWO-gwt-lib</artifactId>
            <version>${dwoVersion}</version>
            <classifier>sources</classifier>
        </dependency>
        <dependency>
            <groupId>com.owlike</groupId>
            <artifactId>genson</artifactId>
            <version>1.3</version>
            <scope>provided</scope>
        </dependency> 

        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>3.8.1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.google.gwt</groupId>
            <artifactId>gwt-user</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.googlecode.mgwt</groupId>
            <artifactId>MGWT</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fredhat.gwt.xmlrpc</groupId>
            <artifactId>XmlRpcGWT</artifactId>
            <version>1.1.1</version>
        </dependency>
        <dependency>
        	<groupId>com.google.gwt</groupId>
        	<artifactId>gwt-dev</artifactId>
        	<version>${gwtVersion}</version>
        	<scope>test</scope>
        </dependency>
    </dependencies>
    <description>Gebruiker: profiel en klas panels</description>
    <parent>
        <groupId>fi.parentgwt</groupId>
        <artifactId>ParentGWT</artifactId>
        <version>0.0.2</version>
        <relativePath>../ParentGWT</relativePath>
    </parent>
</project>
