<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>nl.uu.fi.dwo</groupId>
    <artifactId>dwo.master.pom</artifactId>
    <version>2.5.49-SNAPSHOT</version>
    <packaging>pom</packaging>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jdk.version>8</jdk.version>
        <jdk>${env.JAVA_HOME_8}</jdk>
        <buildVersion>${project.version}</buildVersion>
    </properties>
    <name>${project.build.finalName}</name>
    
    <organization>
        <name>Freudenthal Institute</name>
        <url>http://www.uu.nl/onderzoek/freudenthal-instituut</url>
    </organization>
    <modules>
<!--		<module>MicroIndex</module>-->
<!--		<module>xapiserver</module>-->
		<module>DWO</module>
<!--		<module>async-lib</module>-->
<!--		<module>eawt</module>-->
<!--		<module>promise-api</module>-->
<!--		<module>numworxlf</module>-->
<!--		<module>beans_lineairealgebra</module>-->
	</modules>    

    <!-- automagically use snapshot/release -->
    <distributionManagement>
	    <repository>
	      <id>github</id>
	      <name>GitHub Packages</name>
	      <url>https://maven.pkg.github.com/UtrechtUniversity/numworx-dwo-project</url>
	    </repository>
        <snapshotRepository>
          <id>github</id>
          <name>GitHub Packages</name>
          <url>https://maven.pkg.github.com/UtrechtUniversity/numworx-dwo-project</url>
        </snapshotRepository>
    </distributionManagement>           
    <repositories>
 	    <repository>
	      <id>numworx-dwo-project</id>
	      <name>GitHub Packages</name>
	      <url>https://maven.pkg.github.com/UtrechtUniversity/numworx-dwo-project</url>
	      <snapshots>
			  <enabled>true</enabled>
		  </snapshots>
	    </repository>		
    </repositories>
    <pluginRepositories>
    </pluginRepositories>    
    <build>
	<plugins>
                <plugin>
                <groupId>external.atlassian.jgitflow</groupId>
                <artifactId>jgitflow-maven-plugin</artifactId>
                <version>1.0-m5.1</version>
                <configuration>
                        <!-- see goals wiki page for configuration options -->
                        <flowInitContext>
                                <developBranchName>develop</developBranchName>
                                <masterBranchName>main</masterBranchName>
                        </flowInitContext>
                        <localOnly>false</localOnly>
                        <allowSnapshots>false</allowSnapshots>
                        <enableSshAgent>true</enableSshAgent>
                        <noDeploy>true</noDeploy>
                        <autoVersionSubmodules>true</autoVersionSubmodules>
                </configuration>
                          <dependencies>
                            <dependency>
                              <groupId>com.jcraft</groupId>
                              <artifactId>jsch</artifactId>
                              <version>0.1.54</version>
                            </dependency>
                                <dependency>
                                  <groupId>net.java.dev.jna</groupId>
                                  <artifactId>jna-platform</artifactId>
                                  <version>5.12.1</version>
                                </dependency>
                          </dependencies>
                </plugin>
<plugin>
  <groupId>org.apache.maven.plugins</groupId>
  <artifactId>maven-site-plugin</artifactId>
  <version>3.7.1</version>
</plugin>
<plugin>
  <groupId>org.apache.maven.plugins</groupId>
  <artifactId>maven-project-info-reports-plugin</artifactId>
  <version>3.0.0</version>
</plugin>
	</plugins>
   </build>
</project>
