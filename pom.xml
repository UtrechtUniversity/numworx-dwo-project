<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>nl.uu.fi.dwo</groupId>
        <artifactId>DWO-GWT</artifactId>
        <relativePath>../DWO-GWT</relativePath>
        <version>1.0</version>
    </parent>
	<groupId>nl.uu.fi.dwo.keyboard</groupId>
	<artifactId>KeyboardGWT</artifactId>
	<name>Keyboard</name>
	<dependencies>
		<dependency>
			<groupId>com.google.gwt</groupId>
			<artifactId>gwt-user</artifactId>
		</dependency>
		<dependency>
			<groupId>com.google.gwt</groupId>
			<artifactId>gwt-dev</artifactId>
			<version>${gwtVersion}</version>
			<scope>test</scope>
		</dependency>
<!-- 		<dependency>
			<groupId>nl.uu.fi.dwo.mobile</groupId>
			<artifactId>interaction</artifactId>
		</dependency>
 -->		<dependency>
			<groupId>nl.uu.fi.dwo.mobile</groupId>
			<artifactId>interaction</artifactId>
			<version>0.1.4</version>
			<scope>provided</scope>
		</dependency>

		<dependency>
			<groupId>fi.writemathgwt</groupId>
			<artifactId>WriteMathGWT</artifactId>
			<version>2.4.2</version>
		</dependency>
		<dependency>
			<groupId>fi.wiskopdrgwt</groupId>
			<artifactId>WiskOpdrGWT</artifactId>
			<version>0.0.5</version>
			<exclusions>
				<exclusion>
					<artifactId>IdeasGWT</artifactId>
					<groupId>nl.uu.fi.dwo.ideas</groupId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>com.googlecode.mgwt</groupId>
			<artifactId>MGWT</artifactId>
			<scope>provided</scope>
		</dependency>
	</dependencies>
	<build>
		<resources>
			<resource>
				<directory>src</directory>
			</resource>
		</resources>
		<sourceDirectory>src</sourceDirectory>
		<plugins>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>gwt-maven-plugin</artifactId>
				<version>${gwtVersion}</version>
				<configuration>
					<module>${project.groupId}.${project.artifactId}</module>
					<i18nConstantsBundles>
						<i18nConstantsBundle>nl.uu.fi.dwo.keyboard.client.i18n.Key</i18nConstantsBundle>
					</i18nConstantsBundles>
				</configuration>
				<executions>
					<execution>
						<id>i18n</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>i18n</goal>
						</goals>
					</execution>
				</executions>			
			</plugin>
      <plugin>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.0.2</version>
        <executions>
          <execution>
            <id>copy-resources</id>
            <phase>process-classes</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}</outputDirectory>
              <resources>          
                <resource>
                  <directory>${basedir}/target/generated-sources/gwt</directory>
                  <filtering>false</filtering>
                </resource>
              </resources>              
            </configuration>            
          </execution>
        </executions>
      </plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-release-plugin</artifactId>
				<version>2.5.3</version>
			</plugin>
		</plugins>
	</build>
	<description>Keyboard voor desktop en tablet
DWO en Noordhoff/Plantyn variant</description>
	<version>2.4.5-SNAPSHOT</version>
	<scm>
		<developerConnection>scm:svn:https://svn.science.uu.nl/repos/project.fisme.java/KeyboardGWT/trunk</developerConnection>
	</scm>
	<properties>
		<maven.javadoc.failOnError>false</maven.javadoc.failOnError>
		<interactionVersion>0.1.4</interactionVersion>
  		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
	</properties>
</project>