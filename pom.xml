		</dependency>
		<dependency>
			<groupId>fi.mpreduce</groupId>
			<artifactId>mpreduce-phrasebook</artifactId>
			<version>0.0.3</version>
		</dependency>
		<dependency>
			<groupId>nl.tue.win.riaca.mathml</groupId>
			<artifactId>mathml-phrasebook</artifactId>
			<version>1.3.2</version>
		</dependency>
		<dependency>
			<groupId>org.geogebra</groupId>
			<artifactId>geogebra_cas</artifactId>
			<version>4.0.29</version>
		</dependency>
		<dependency>
			<groupId>org.geogebra</groupId>
			<artifactId>geogebra_main</artifactId>
			<version>4.0.29</version>
		</dependency>
		<dependency>
			<groupId>org.geogebra</groupId>
			<artifactId>geogebra</artifactId>
			<version>4.0.29</version>
		</dependency>
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-lang3</artifactId>
			<version>3.1</version>
		</dependency>
		<dependency>
			<groupId>net.oauth.core</groupId>
			<artifactId>oauth-provider</artifactId>
			<version>20100601</version>
		</dependency>
		<dependency>
			<groupId>commons-lang</groupId>
			<artifactId>commons-lang</artifactId>
			<version>2.6</version>
		</dependency>
		<dependency>
			<groupId>nl.uu.fi.dwo</groupId>
			<artifactId>DWOJClient</artifactId>
			<version>2.2.8-SNAPSHOT</version>
		</dependency>
		<dependency>
			<groupId>fi.dwo</groupId>
			<artifactId>DWO-apps</artifactId>
			<version>2.0.5</version>
			<scope>runtime</scope>
			<type>war</type>
		</dependency>
	<dependency>
		<groupId>nl.uu.fi.dwo.mobile</groupId>
		<artifactId>DWOplayer</artifactId>
		<version>${DWOplayerVersion}</version>
		<type>war</type>
		<classifier>dwo2</classifier>
		<scope>runtime</scope>
	</dependency>
	<dependency>
		<groupId>nl.uu.fi.dwo.lms</groupId>
		<artifactId>DWOGwtClient</artifactId>
		<version>0.10.16-SNAPSHOT</version>
		<type>war</type>
		<scope>runtime</scope>
	</dependency>
	<dependency>
		<groupId>nl.uu.fi.dwo.register</groupId>
		<artifactId>Register</artifactId>
		<version>${RegisterVersion}</version>
		<type>war</type>
		<scope>runtime</scope>
	</dependency>
	<dependency>
		<groupId>fi.servlet</groupId>
		<artifactId>DWOmAccess</artifactId>
		<version>${DWOmAccessVersion}</version>
		<type>war</type>
		<scope>runtime</scope>
	</dependency>
	</dependencies>
	<build>
		<resources>
			<resource>
				<directory>src/main/resources</directory>
				<filtering>true</filtering>
			</resource>
		</resources>
		<plugins>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>buildnumber-maven-plugin</artifactId>
				<version>1.3</version>
				<executions>
					<execution>
						<phase>validate</phase>
						<goals>
							<goal>create</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<!-- doCheck and doUpdate actually talk to repository if it's true, 
						Check would check that there are no local changes. Update would update it -->
					<doCheck>false</doCheck>
					<doUpdate>false</doUpdate>
					<!-- This ensures that even if we are not connected to scm than also 
						take the version from local .svn file -->
					<revisiononscmfailure>

						<!-- Generate sequence build number based on: build number and timestamp -->
						<format>Build: #{0} ({1,date})</format>
						<items>
							<item>buildNumber\d*</item>
							<item>timestamp</item>
						</items>
					</revisiononscmfailure>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<version>2.10</version>
				<executions>
					<execution>
						<id>copy</id>
						<phase>process-resources</phase>
						<goals>
							<goal>copy</goal>
						</goals>
						<configuration>
							<artifactItems>
								<artifactItem>
									<groupId>${project.groupId}</groupId>
									<artifactId>DWOJClient</artifactId>
									<version>${project.version}</version>
									<classifier>jar-with-dependencies</classifier>
									<overWrite>true</overWrite>
									<destFileName>dwo/DWOJApplet.jar</destFileName>
								</artifactItem>
								<artifactItem>
									<groupId>${project.groupId}</groupId>
									<artifactId>DWOJClient</artifactId>
									<version>${project.version}</version>
									<classifier>jar-with-dependencies</classifier>
									<type>jar.pack.gz</type>
									<overWrite>true</overWrite>
									<destFileName>dwo/DWOJApplet.jar.pack.gz</destFileName>
								</artifactItem>
								<artifactItem>
									<groupId>${project.groupId}</groupId>
									<artifactId>dwo1compat</artifactId>
									<version>2.1.11</version>
									<destFileName>dwo/dwo1compat.jar</destFileName>
								</artifactItem>
							</artifactItems>
							<outputDirectory>${project.build.directory}/${project.build.finalName}/</outputDirectory>
							<overWriteReleases>false</overWriteReleases>
							<overWriteSnapshots>true</overWriteSnapshots>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- cargo plugin to run tomcat 8 for testing - configuration under construction -->
			<plugin>
				<groupId>org.codehaus.cargo</groupId>
				<artifactId>cargo-maven2-plugin</artifactId>
				<version>1.6.4</version>
				<configuration>
					<container>
						<containerId>tomcat8x</containerId>
						<output>target/catalina-output.log</output>
						<artifactInstaller>
							<groupId>org.apache.tomcat</groupId>
							<artifactId>tomcat</artifactId>
							<version>8.0.47</version>
						</artifactInstaller>
					</container>
					<dependencies>
						<!-- https://mvnrepository.com/artifact/commons-dbcp/commons-dbcp -->
						<!-- <dependency> <groupId>commons-dbcp</groupId> <artifactId>commons-dbcp</artifactId> 
							<version>1.4</version> </dependency> -->
						<dependency>
							<groupId>mysql</groupId>
							<artifactId>mysql-connector-java</artifactId>
							<version>6.0.6</version>
						</dependency>
						<!-- https://mvnrepository.com/artifact/oracle/ojdbc6 -->
					</dependencies>
					<configuration>
						<type>standalone</type>
						<home>
							${project.build.directory}/apache-tomcat
						</home>
						<properties>
							<cargo.servlet.port>8080</cargo.servlet.port>
							<cargo.logging>low</cargo.logging>
						</properties>

					</configuration>
					<deployables>
						<deployable>
							<groupId>${project.groupId}</groupId>
							<artifactId>${project.artifactId}</artifactId>
							<type>war</type>
							<properties>
								<context>/</context>
							</properties>
						</deployable>
					</deployables>
					<configfiles>
						<configfile>
							<file>${project.directory}/src/test/tomcat/context-dwo_devel.xml</file>
							<todir>conf/Catalina/localhost/</todir>
							<tofile>context.xml.default</tofile>
						</configfile>
					</configfiles>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.apache.tomcat.maven</groupId>
				<artifactId>tomcat7-maven-plugin</artifactId>
				<version>2.2</version>
				<!--<artifactId>tomcat8-maven-plugin</artifactId> -->
				<!--<version>3.0-r1756463</version> -->
				<configuration>
					<server>TomcatServer</server>
					<path>/</path>
					<warSourceDirectory>${project.build.directory}/${project.build.finalName}</warSourceDirectory>
					<contextFile>src/test/tomcat/context-dwo_devel.xml</contextFile>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-war-plugin</artifactId>
				<version>3.0.0</version>
				<configuration>
					<archive>
						<manifest>
							<addDefaultImplementationEntries>true</addDefaultImplementationEntries>
						</manifest>
						<manifestEntries>
							<Implementation-Build>${buildNumber}</Implementation-Build>
							<JavaClient-Version>${project.version}</JavaClient-Version>
							<HtmlClient-Version>${DWOGwtClientVersion}</HtmlClient-Version>
							<DWOplayer-Version>${DWOplayerVersion}</DWOplayer-Version>
							<Implementation-Timestamp>${timestamp}</Implementation-Timestamp>
							<Implementation-ScmBranch>${buildScmBranch}</Implementation-ScmBranch>
						</manifestEntries>
					</archive>
					<overlays>
						<overlay>
							<groupId>fi.dwo</groupId>
							<artifactId>DWO-apps</artifactId>
							<targetPath>/dwo/apps</targetPath>
						</overlay>
						<overlay>
							<groupId>nl.uu.fi.dwo.mobile</groupId>
							<artifactId>DWOplayer</artifactId>
							<classifier>dwo2</classifier>
							<targetPath>/dwo/tablet</targetPath>		
						</overlay>
						<overlay>
							<groupId>nl.uu.fi.dwo.lms</groupId>
							<artifactId>DWOGwtClient</artifactId>
							<targetPath>/gwtclient</targetPath>
						</overlay>
						<overlay>
							<groupId>nl.uu.fi.dwo.register</groupId>
							<artifactId>Register</artifactId>
							<targetPath>/dwo/register</targetPath>
						</overlay>
						<overlay>
							<groupId>fi.servlet</groupId>
							<artifactId>DWOmAccess</artifactId>
							<targetPath>/DWOmAccess</targetPath>
							<excludes>
								<exclude>WEB-INF/**</exclude>
								<exclude>META-INF/**</exclude>
							</excludes>
						</overlay>
					</overlays>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-release-plugin</artifactId>
				<version>2.5.3</version>
				<configuration>
					<preparationGoals>clean verify install</preparationGoals>
					<tagBase>https://svn.science.uu.nl/repos/project.fisme.java/DWOProject/DWO-LMS/EBServer/tags/</tagBase>
				</configuration>
			</plugin>
			<plugin> <!-- NIET ZOMAAR WEGGOOIEN! -->
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>1.6.0</version>
				<executions>
					<execution>
						<id>local-index</id>
						<goals>
							<goal>java</goal>
						</goals>
						<phase>process-resources</phase>
					</execution>
				</executions>
				<dependencies>
					<dependency>
						<groupId>fi.microserver</groupId>
						<artifactId>MicroIndex</artifactId>
						<version>0.0.1-SNAPSHOT</version>
					</dependency>
				</dependencies>
				<configuration>
					<mainClass>fi.microserver.microindex.Main</mainClass>
					<includeProjectDependencies>false</includeProjectDependencies>
					<includePluginDependencies>true</includePluginDependencies>
					<addOutputToClasspath>false</addOutputToClasspath>
					<addResourcesToClasspath>false</addResourcesToClasspath>
					<arguments>
						<argument>${project.build.directory}/${project.build.finalName}/dwo</argument>
					</arguments>
				</configuration>
			</plugin>
			<plugin>
				<groupId>com.github.davidmoten</groupId>
				<artifactId>aws-maven-plugin</artifactId>
				<version>0.2.18</version>
				<configuration>
					<serverId>${aws.serverId}</serverId>
					<artifact>${project.build.directory}/${project.build.finalName}.war</artifact>
					<applicationName>${aws.applicationName}</applicationName>
					<environmentName>${aws.environmentName}</environmentName>
					<region>eu-west-1</region>
				</configuration>
			</plugin>
		</plugins>
	</build>
	<properties>
		<maven.compiler.source>1.8</maven.compiler.source>
		<maven.compiler.target>1.8</maven.compiler.target>
		<DWOplayerVersion>2.2.8-SNAPSHOT</DWOplayerVersion>
		<DWOmAccessVersion>0.0.9</DWOmAccessVersion>
		<RegisterVersion>2.2.8-SNAPSHOT</RegisterVersion>
		<DWOGwtClientVersion>0.10.16-SNAPSHOT</DWOGwtClientVersion>
		<aws.serverId>prod</aws.serverId>
		<aws.applicationName>DWO-EBServer</aws.applicationName>
		<aws.environmentName>testebserver</aws.environmentName>
	</properties>
	<scm>
		<developerConnection>scm:svn:https://svn.science.uu.nl/repos/project.fisme.java/DWOProject/DWO-LMS/EBServer/trunk</developerConnection>
		<connection>scm:svn:https://svn.science.uu.nl/repos/project.fisme.java/DWOProject/DWO-LMS/EBServer/trunk</connection>
	</scm>
	<profiles>
		<profile>
			<id>teuniz</id>
			<properties>
				<aws.serverId>dev</aws.serverId>
				<aws.applicationName>teuniz</aws.applicationName>
				<aws.environmentName>teuniz2</aws.environmentName>
			</properties>
		</profile>
	</profiles>
</project>
