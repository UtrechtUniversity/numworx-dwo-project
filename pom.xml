<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>nl.uu.fi.dwo</groupId>
    <artifactId>DWO-GWT</artifactId>
    <version>1.0</version>
  </parent>
  <groupId>fi.wiskopdrgwt</groupId>
  <artifactId>WiskOpdrGWT</artifactId>
  <name>WiskOpdrGWT</name>
  <properties>
  	<gwtVersion>2.8.2</gwtVersion>
  	<mgwtVersion>1.1.2</mgwtVersion>
  	<maven.compiler.source>1.8</maven.compiler.source>
  	<maven.compiler.target>1.8</maven.compiler.target>
  	<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  	<interactionVersion>0.0.6</interactionVersion>
  </properties>
  <dependencies>
  	<dependency>
  		<groupId>com.google.gwt</groupId>
  		<artifactId>gwt-user</artifactId>
  		<scope>provided</scope>
  	</dependency>
  	<dependency>
  		<groupId>nl.uu.fi.dwo.mobile</groupId>
  		<artifactId>interaction</artifactId>
  	</dependency>

  	<dependency>
  		<groupId>nl.uu.fi.dwo.ideas</groupId>
  		<artifactId>IdeasGWT</artifactId>
  		<version>0.1.1</version>
  	</dependency>
  </dependencies>
  <build>
	<finalName>wiskopdrexpressies</finalName>
  	<resources>
  		<resource>
  			<directory>src</directory>
  		</resource>
  	</resources>
  	<sourceDirectory>src</sourceDirectory>
    <plugins>
    	<plugin>
    		<artifactId>maven-compiler-plugin</artifactId>
    		<version>3.1</version>   	
    	</plugin>
    </plugins>
  </build>
  <description></description>
  <version>0.0.6-SNAPSHOT</version>
  <scm>
  	<developerConnection>scm:svn:https://svn.science.uu.nl/repos/project.fisme.java/DWOProject/GWT/WiskOpdrGWT/trunk</developerConnection>
  </scm>
</project>
