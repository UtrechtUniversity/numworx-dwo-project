                            <name>jersey.config.test.container.port</name>
                            <value>8080</value>
                        </property>
                    </systemProperties>  -->
                </configuration>
            </plugin>                       
			<plugin>
        		<groupId>org.apache.maven.plugins</groupId>
        		<artifactId>maven-release-plugin</artifactId>
        		<version>2.5.3</version>
        	</plugin>
        </plugins>
    </build>
    <distributionManagement>
        <repository>
            <id>release</id>
            <name>libs-release-local</name>
            <url>https://repos.dwo.nl/artifactory/libs-release-local</url>
        </repository>
        <snapshotRepository>
            <id>snapshots</id>
            <name>libs-snapshot-local</name>
            <url>https://repos.dwo.nl/artifactory/libs-snapshot-local</url>
        </snapshotRepository>
    </distributionManagement>
    <profiles>
        <profile>
            <id>ws</id>
            <build>
                <finalName>${project.artifactId}</finalName>
            </build>
            <properties>
                <comment>speciaal for ws.fisme.science.uu.nl</comment>
                <dsaccess>//app.dwo.nl/dwo/dsaccess</dsaccess>
                <dsaccess.url>https://app.dwo.nl/dwo/dsaccess</dsaccess.url>
                <dsrest.url>https://app.dwo.nl/dwo/rest/</dsrest.url>
                <ideas>/servlet/IdeasServlet</ideas>
            </properties>
        </profile>
        <profile>
            <id>dummytwo</id>
            <build>
                <finalName>${project.artifactId}_local</finalName>
            </build>
            <properties>
                <comment>speciaal for localhost met dummytwo.dwo.nl als database</comment>
                <dsaccess>https://dummytwo.dwo.nl/dwo/xmlrpc</dsaccess>
                <dsaccess.url>http://dummytwo.dwo.nl/dwo/xmlrpc</dsaccess.url>
                <dsrest.url>http://dummytwo.dwo.nl/dwo/rest/</dsrest.url>
            </properties>
        </profile>
        <profile>
            <id>local</id>
            <build>
<!--                <finalName>${project.artifactId}_local</finalName>-->
            </build>
            <properties>
                <comment>speciaal for localhost met dummytwo.dwo.nl als database</comment>
                <dsaccess>http://127.0.0.1:8080/dwo/xmlrpc</dsaccess>
                <dsaccess.url>http://127.0.0.1:8080/dwo/xmlrpc</dsaccess.url>
                <dsrest.url>http://127.0.0.1:8080/dwo/rest/</dsrest.url>
            </properties>
        </profile>
    </profiles>
    <scm>
        <developerConnection>scm:svn:https://svn.science.uu.nl/repos/project.fisme.java/DWOmAccess/branches/dwo2</developerConnection>
    </scm>
    <parent>
    	<groupId>nl.uu.fi.dwo</groupId>
    	<artifactId>DWO</artifactId>
    	<version>2.0-SNAPSHOT</version>
