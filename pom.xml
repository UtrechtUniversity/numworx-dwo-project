        </dependency>
	</dependencies>
	<build>
	 <plugins>
	<plugin>
		<groupId>org.apache.maven.plugins</groupId>
		<artifactId>maven-dependency-plugin</artifactId>
		<version>2.10</version>
		<executions>
			<execution>
				<id>copy</id>
				<phase>process-resources</phase>
				<goals>
					<goal>copy</goal>
				</goals>
				<configuration>
					<artifactItems>
						<artifactItem>
							<groupId>${project.groupId}</groupId>
							<artifactId>DWOJClient</artifactId>
							<version>${project.version}</version>
							<classifier>jar-with-dependencies</classifier>
							<overWrite>true</overWrite>
							<destFileName>dwo/DWOJApplet.jar</destFileName>
						</artifactItem>
						<!-- <artifactItem> <groupId>${project.groupId}</groupId> <artifactId>DWOJClient</artifactId> 
							<version>${project.version}</version> <classifier>jar-with-dependencies</classifier> 
							<type>jar.pack.gz</type> <overWrite>true</overWrite> <destFileName>DWOJApplet.jar.pack.gz</destFileName> 
							</artifactItem> -->
					</artifactItems>
					<outputDirectory>${project.build.directory}/${project.build.finalName}/</outputDirectory>
					<overWriteReleases>false</overWriteReleases>
					<overWriteSnapshots>true</overWriteSnapshots>
				</configuration>
			</execution>
			<execution>
				<id>unpack</id>
				<goals>
					<goal>unpack</goal>
				</goals>
				<configuration>
					<artifactItems>
						<artifactItem>
							    <groupId>fi.dwo</groupId>
    							<artifactId>DWO-apps</artifactId>
    							<version>2.0-SNAPSHOT</version>
    							<type>war</type>
								<outputDirectory>${project.build.directory}/${project.build.finalName}/dwo/apps/</outputDirectory>
						</artifactItem>
						<artifactItem>
								<groupId>nl.uu.fi.dwo.mobile</groupId>
								<artifactId>DWOplayer</artifactId>
								<version>2.1.7</version>
								<type>war</type>
								<classifier>dwo2</classifier>
								<outputDirectory>${project.build.directory}/${project.build.finalName}/dwo/tablet/</outputDirectory>								
						</artifactItem>
						<artifactItem>
								<groupId>nl.uu.fi.dwo.register</groupId>
								<artifactId>Register</artifactId>
								<version>0.0.1</version>
								<type>war</type>
								<outputDirectory>${project.build.directory}/${project.build.finalName}/dwo/register</outputDirectory>
						</artifactItem>
						<artifactItem>
								<groupId>com.jamonapi</groupId>
								<artifactId>jamon_war</artifactId>
								<version>2.80</version>
								<type>war</type>
								<excludes>WEB-INF/lib/**</excludes>
								<outputDirectory>${project.build.directory}/${project.build.finalName}/jamon</outputDirectory>
						</artifactItem>
						<artifactItem>
								<groupId>com.jamonapi</groupId>
								<artifactId>jamon_war</artifactId>
								<version>2.80</version>
								<type>war</type>
								<outputDirectory>${project.build.directory}/${project.build.finalName}</outputDirectory>
								<includes>WEB-INF/lib/**</includes>
						</artifactItem>
						<artifactItem>
				        	<groupId>fi.servlet</groupId>
        					<artifactId>DWOmAccess</artifactId>
        					<version>0.0.8-SNAPSHOT</version>
							<type>war</type>
							<outputDirectory>${project.build.directory}/${project.build.finalName}/DWOmAccess</outputDirectory>
						</artifactItem>
					</artifactItems>
					<overWriteReleases>false</overWriteReleases>
					<overWriteSnapshots>true</overWriteSnapshots>				
				</configuration>
			</execution>
		</executions>
	</plugin>
        <plugin>
                <groupId>org.apache.tomcat.maven</groupId>
                <artifactId>tomcat7-maven-plugin</artifactId>
                <version>2.2</version>
                    <configuration>
                        <server>TomcatServer</server>
                        <path>/</path>
                        <warFile>target/${project.artifactId}-${project.version}.war</warFile>
                        <warSourceDirectory>target/${project.artifactId}-${project.version}</warSourceDirectory>
                    </configuration>
            </plugin> 
	</plugins>
	</build>
	<properties>
		<maven.compiler.source>1.8</maven.compiler.source>
		<maven.compiler.target>1.8</maven.compiler.target>
	</properties>
</project>