                            <outjar>${project.build.finalName}.jar</outjar>
                            -->
                            <proguardInclude>config.pro</proguardInclude>
                            <libs>
                                <lib>${java.home}/lib/rt.jar</lib>
                                <lib>${java.home}/lib/jsse.jar</lib>
                                <!--                               <lib>${java.home}/lib/jfxrt.jar</lib>                       -->
                            </libs>
                            <addMavenDescriptor>false</addMavenDescriptor>
                        </configuration>
                        <dependencies>
                            <dependency>
                                <groupId>net.sf.proguard</groupId>
                                <artifactId>proguard-base</artifactId>
                                <version>5.2</version>
                                <scope>runtime</scope>
                            </dependency>
                        </dependencies>
                    </plugin>
                    <!-- repack as pack200 -->
                    <plugin>
                        <groupId>com.github.batkinson.plugins</groupId>
                        <artifactId>maven-pack200-plugin</artifactId>
                        <version>1.0.1</version>
                        <executions>
                            <execution>
                                <id>normalize-jars</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>pack</goal>
                                </goals>
                                <configuration>
                                    <normalizeOnly>true</normalizeOnly>
                                </configuration>
                            </execution>
                            <execution>
                                <id>pack-jars</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>pack</goal>
                                </goals>
                                <configuration>
                                    <normalizeOnly>false</normalizeOnly>
                                </configuration>
                            </execution>
                        </executions>
                        <configuration>
                            <processMainArtifact>false</processMainArtifact>
                            <includeClassifiers>
                                <includeClassifier>jar-with-dependencies</includeClassifier>
                            </includeClassifiers>
                        </configuration>                
                        <dependencies>
                            <dependency>
                                <groupId>com.github.batkinson.plugins</groupId>
                                <artifactId>maven-pack200-plugin</artifactId>
                                <version>1.0.1</version>
                                <type>maven-plugin</type>
                            </dependency>
                        </dependencies>                
                    </plugin>        
                    <!-- jar signing -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jarsigner-plugin</artifactId>
                        <version>1.4</version>
                        <executions>
                            <execution>
                                <phase>package</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>verify</id>
                                <goals>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration> <!--  Alleen jar-with-dependencies wordt getekend. -->
                            <processMainArtifact>false</processMainArtifact>
                            <keystore>${dwoKeyStore}</keystore>
                            <alias>${dwoCertKeyAlias}</alias>
                            <storepass>${dwoCertKeyStorePassword}</storepass>
                            <keypass>${dwoCertKeyPassword}</keypass>
                            <sigfile>UU</sigfile>
                            <tsa>https://timestamp.geotrust.com/tsa</tsa>
                        </configuration>            
                    </plugin>  
                </plugins>      
            </build>        
