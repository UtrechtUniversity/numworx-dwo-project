<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>nl.uu.fi.dwo</groupId>
        <artifactId>DWO.master.pom</artifactId>
        <version>1.1</version>
    </parent>
  <groupId>nl.numworx.uploadwidget</groupId>
  <artifactId>UploadWidget-parent</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>UploadWidget parent</name>
  <modules>
  	<module>uploadwidget-common</module>
  	<module>uploadwidget</module>
  	<module>UploadWidgetGWT</module>
  </modules>
  <properties>
  	<maven.compiler.target>1.8</maven.compiler.target>
  	<maven.compiler.source>1.8</maven.compiler.source>
	<autoVersionSubmodules>true</autoVersionSubmodules>
	<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-release-plugin</artifactId>
				<version>2.5.3</version>
				<configuration>
					<tagNameFormat>@{project.version}</tagNameFormat>
					<autoVersionSubmodules>true</autoVersionSubmodules>
				</configuration>
			</plugin>
		</plugins>
	</build>
	<distributionManagement>
		<repository>
			<id>release</id>
			<url>https://repos.dwo.nl/artifactory/libs-release-local</url>
		</repository>

		<snapshotRepository>
			<id>snapshots</id>
			<name>libs-snapshot</name>
			<url>https://repos.dwo.nl/artifactory/libs-snapshot-local</url>
		</snapshotRepository>
	</distributionManagement>

	<scm>
		<developerConnection>scm:svn:https://svn.science.uu.nl/repos/sci.velth101.numworx/UploadWidget/trunk</developerConnection>
	</scm>
</project>