<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>fi.restrpcgwt</groupId>
  <artifactId>RestRpcGWT</artifactId>
  <packaging>war</packaging>
  <name>Login test</name>
  <build>
  	<finalName>${project.artifactId}</finalName>
  	<outputDirectory>target/${project.build.finalName}/WEB-INF/classes</outputDirectory>
	<sourceDirectory>src</sourceDirectory>
  	<testSourceDirectory>test</testSourceDirectory>
    <resources>
    	<resource>
    	   <directory>src</directory>
    	</resource>
    </resources>
  	<plugins>
      <plugin>
        <artifactId>maven-war-plugin</artifactId>
        <configuration>
        	<warSourceDirectory>war</warSourceDirectory>
        	<attachClasses>true</attachClasses>
        	<packagingIncludes>*.css,*gwt/**,${project.artifactId}.html</packagingIncludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>gwt-maven-plugin</artifactId>
        <version>${gwtVersion}</version>
         <configuration>
              <module>${project.groupId}.${project.artifactId}</module>
              <runTarget>${project.artifactId}.html</runTarget>
        	  <warSourceDirectory>war</warSourceDirectory>        
             </configuration>
        <executions>
          <execution>
            <goals>
              <goal>compile</goal>
             </goals>
          </execution>
          </executions>
      </plugin>
      <plugin>
<!-- usage: jetty:run-war of jetty:run-exploded -->
  		<groupId>org.eclipse.jetty</groupId>
 		<artifactId>jetty-maven-plugin</artifactId>
  			<version>9.0.0.v20130308</version>
  	  </plugin>
    </plugins>
  </build>
  <dependencies>
  	<dependency>
  		<groupId>com.google.gwt</groupId>
  		<artifactId>gwt-user</artifactId>
  		<version>${gwtVersion}</version>
  		<scope>provided</scope>
  	</dependency>
		<dependency>
		    <groupId>org.fusesource.restygwt</groupId>
		    <artifactId>restygwt</artifactId>
		    <version>2.0.3</version>
		</dependency>
		<dependency>
			<groupId>javax.ws.rs</groupId>
			<artifactId>javax.ws.rs-api</artifactId>
			<version>2.0.1</version>
		</dependency>
  </dependencies>
  <parent>
  	<groupId>fi.parentgwt</groupId>
  	<artifactId>ParentGWT</artifactId>
  	<version>0.0.1</version>
  	<relativePath>../ParentGWT</relativePath>
  </parent>
</project>
