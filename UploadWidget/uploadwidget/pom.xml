<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>nl.numworx.uploadwidget</groupId>
    <artifactId>UploadWidget-parent</artifactId>
    <version>2.5.29</version>
    <relativePath>../</relativePath>
  </parent>
  <artifactId>uploadwidget</artifactId>
  <name>UploadWidget applet</name>
  <dependencies>
  	<dependency>
  		<groupId>nl.numworx.uploadwidget</groupId>
  		<artifactId>uploadwidget-common</artifactId>
  		<version>2.5.29</version>
  	</dependency>
		<dependency>
			<groupId>javax.inject</groupId>
			<artifactId>javax.inject</artifactId>
			<version>1</version>
		</dependency>
		<dependency>
			<groupId>com.google.dagger</groupId>
			<artifactId>dagger</artifactId>
			<version>${daggerVersion}</version>
		</dependency>
		<dependency>
			<groupId>com.google.dagger</groupId>
			<artifactId>dagger-compiler</artifactId>
			<version>${daggerVersion}</version>
			<scope>provided</scope>
		</dependency>
  	<dependency>
  		<groupId>fi.wiskopdr</groupId>
  		<artifactId>wiskopdr</artifactId>
  		<version>0.3.0</version>
  		<scope>provided</scope>
  	</dependency>
  	<dependency>
  		<groupId>junit</groupId>
  		<artifactId>junit</artifactId>
  		<version>4.13.1</version>
  		<scope>test</scope>
  	</dependency>
  	<dependency>
    		<groupId>fi.beans</groupId>
    		<artifactId>numworxlf</artifactId>
    		<scope>provided</scope>
  	</dependency>
  	<dependency>
  		<groupId>nl.uu.fi.dwo</groupId>
  		<artifactId>DWO-commons-lib</artifactId>
  		<scope>provided</scope>
  	</dependency>
		<dependency>
			<groupId>org.c-book</groupId>
			<artifactId>cbookeditor</artifactId>
			<version>0.0.1</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>uploadwidgetrm</artifactId>
			<version>2.5.29</version>
		</dependency>
  </dependencies>
  <packaging>bundle</packaging>
  <properties>
  		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  		<maven.compiler.source>1.8</maven.compiler.source>
  		<maven.compiler.target>1.8</maven.compiler.target>
		<maven.build.timestamp.format>yyyyMMddHHmm</maven.build.timestamp.format>
		<osgi.qualifier>${maven.build.timestamp}</osgi.qualifier>
		<daggerVersion>2.42</daggerVersion>
		<maven.test.skip>false</maven.test.skip>
  </properties>
  <build>
  	<finalName>${project.artifactId}</finalName>
    <plugins>
			<plugin>
				<groupId>org.apache.felix</groupId>
				<artifactId>maven-bundle-plugin</artifactId>
				<version>3.5.0</version>
				<extensions>true</extensions>
				<configuration>
					<createDependencyReducedPom>true</createDependencyReducedPom>
					<niceManifest>true</niceManifest>
					<dependencyReducedPomLocation>${basedir}/small-pom.xml</dependencyReducedPomLocation>
					<instructions>
   						<_snapshot>${osgi.qualifier}</_snapshot>
						<Bundle-SymbolicName>nl.numworx.uploadwidget.UploadWidget</Bundle-SymbolicName>
						<Export-Package>nl.numworx.uploadwidget</Export-Package>
						<Main-class>nl.numworx.uploadwidget.UploadWidget</Main-class>
						<Import-Package>!javax.servlet.*,!dagger.internal.codegen,!dagger.releasablereferences,!com.google.*,!com.googlecode.*,!nl.uu.fi.dwo.interaction.client.*,fi.*,javax.annotation;resolution:=optional;version="[1,4)",*</Import-Package>
						<Private-Package>
						    !nl.numworx.uploadwidget.server,
							nl.numworx.uploadwidget,
							nl.numworx.uploadwidget.module,
							nl.numworx.uploadwidget.shared,
							dagger,
							dagger.internal,
							dagger.multibindings,
							javax.inject							
						</Private-Package>
					</instructions>
				</configuration>
			</plugin>
    </plugins>
  </build>
  <profiles>
		<profile>
			<id>running11</id>
			<activation>
				<jdk>[9,)</jdk>
			</activation>
			<dependencies>
				<dependency>
				    <groupId>javax.annotation</groupId>
				    <artifactId>javax.annotation-api</artifactId>
				    <version>1.3.2</version>
				</dependency>
			</dependencies>
		</profile>  
  </profiles>
</project>
