<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>nl.numworx.uploadwidget</groupId>
    <artifactId>uploadwidget-parent</artifactId>
    <version>2.5.49-SNAPSHOT</version>
  </parent>
  <artifactId>uploadwidget-local</artifactId>
  <properties>
    <maven.compiler.source>1.8</maven.compiler.source>
    <maven.compiler.target>1.8</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <dbrest.url>http://localhost:80/dwo/</dbrest.url>
    <maven.test.skip>true</maven.test.skip>
  </properties>
  <dependencies>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.1</version>
      <scope>test</scope>
    </dependency>
	<dependency>
		<groupId>nl.numworx.uploadwidget</groupId>
		<artifactId>uploadwidget-common</artifactId>
	</dependency>
      <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <version>3.1.0</version>
            <scope>provided</scope>
      </dependency>
	<dependency>
		<groupId>nl.numworx.uploadwidget</groupId>
		<artifactId>uploadwidgetgwt</artifactId>
		<version>${project.version}</version>
		<classifier>classes</classifier>
		<exclusions>
			<exclusion>
				<artifactId>uploadwidget-s3</artifactId>
				<groupId>nl.numworx.uploadwidget</groupId>
			</exclusion>			
		</exclusions>
	</dependency>
  </dependencies>
  <build>
	  <plugins>
			<plugin>
				<artifactId>maven-war-plugin</artifactId>
				<configuration>
			<attachClasses>true</attachClasses>
                    <filteringDeploymentDescriptors>true</filteringDeploymentDescriptors>
				</configuration>
			</plugin>
	  </plugins>
  </build>
  	<profiles>	 	
	 	<profile>
	 		<id>local</id>
	 		<properties>
    			<dbrest.url>http://localhost:8080/dwo/</dbrest.url> 		
	 		</properties>
	 	</profile>
	</profiles>

  <packaging>war</packaging>
</project>
