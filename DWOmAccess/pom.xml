<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>fi.servlet</groupId>
    <artifactId>dwomaccess</artifactId>
    <packaging>war</packaging>
    <name>DWOmAccess</name>
    <description>HTML5 access to dwo-server</description>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <dsaccess>/dwo/xmlrpc</dsaccess>
        <dsaccess.url>http://127.0.0.1/dwo/xmlrpc</dsaccess.url>
        <dsrest.url>http://127.0.0.1/dwo/rest/</dsrest.url>
        <ideas>/ideas/IdeasServlet</ideas>
        <comment>amazon, *.dwo.nl</comment>
        <maven.javadoc.failOnError>false</maven.javadoc.failOnError>
    </properties>
    <dependencies>
       <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <version>3.0.1</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>jsp-api</artifactId>
            <version>2.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>net.oauth.core</groupId>
            <artifactId>oauth</artifactId>
            <version>20100601</version>
        </dependency>
        <dependency>
            <groupId>net.oauth.core</groupId>
            <artifactId>oauth-provider</artifactId>
            <version>20100601</version>
        </dependency>
        <dependency>
            <groupId>commons-lang</groupId>
            <artifactId>commons-lang</artifactId>
            <version>2.6</version>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>3.8.1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
        	<groupId>nl.uu.fi.dwo.rest</groupId>
        	<artifactId>dwo-jclient-lib</artifactId>
        </dependency>
        <dependency>
        	<groupId>nl.uu.fi.dwo</groupId>
        	<artifactId>dwo-commons-lib</artifactId>
        </dependency>
        <dependency>
            <groupId>com.googlecode.json-simple</groupId>
            <artifactId>json-simple</artifactId>
            <version>1.1.1</version>
            <exclusions>
                <exclusion>
                    <groupId>junit</groupId>
                    <artifactId>junit</artifactId>
                </exclusion>
            </exclusions>            
        </dependency>                
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>0.10.5</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>0.10.5</version>
		</dependency>
		<dependency>
			<groupId>edu.uoc.elc.lti</groupId>
			<artifactId>lti-13</artifactId>
			<version>1.0.0</version>
			<exclusions>
				<exclusion>
					<groupId>com.fasterxml.jackson.core</groupId>
					<artifactId>jackson-databind</artifactId>
				</exclusion>
				<exclusion>
					<groupId>org.mockito</groupId>
					<artifactId>mockito-core</artifactId>
				</exclusion>
				<exclusion>
					<groupId>com.fasterxml.jackson.dataformat</groupId>
					<artifactId>jackson-dataformat-yaml</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>edu.uoc.elc.lti</groupId>
			<artifactId>lti-13-jwt</artifactId>
			<version>1.0.0</version>
		</dependency>
		<dependency>
			<groupId>commons-codec</groupId>
			<artifactId>commons-codec</artifactId>
			<version>1.11</version>
		</dependency>
    </dependencies>
    <build>
        <sourceDirectory>src</sourceDirectory>
		<resources>
			<resource>
				<directory>src</directory>
				<excludes>
					<exclude>**/*.java</exclude>
				</excludes>
			</resource>
		</resources>
        <testSourceDirectory>test</testSourceDirectory>
        <plugins>
            <plugin>
                <artifactId>maven-war-plugin</artifactId>
                <configuration>
                    <warSourceDirectory>WebContent</warSourceDirectory>
                    <filteringDeploymentDescriptors>true</filteringDeploymentDescriptors>
                    <archive> <!-- add the manifest to the war -->
                        <manifestFile>WebContent/META-INF/MANIFEST.MF</manifestFile>
                    </archive>
                    <attachClasses>true</attachClasses>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.1</version>
            </plugin>
            <plugin>
                <groupId>org.eclipse.jetty</groupId>
                <artifactId>jetty-maven-plugin</artifactId>
                <version>9.3.7.v20160115</version>
                <configuration>
                    <webAppSourceDirectory>WebContent</webAppSourceDirectory>
                    <webApp>
                        <contextPath>/DWOmAccess</contextPath>
                        <descriptor>target/${project.build.finalName}/WEB-INF/web.xml</descriptor>
                    </webApp>
                    <httpConnector>
                        <port>8081</port>
                        <host>127.0.0.1</host>
                    </httpConnector>          
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>2.18.1</version>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                    <skipTests>true</skipTests> 
                </configuration>
            </plugin>                       
        </plugins>
    </build>
    <repositories>
		<repository>
			<id>numworx-vendor-oauth</id>
			<url>https://maven.pkg.github.com/UtrechtUniversity/numworx-vendor-oauth</url>
		</repository>
	    <repository>
	      <id>github-uoc-lti-core</id>
	      <name>GitHub UOC Apache Maven Packages</name>
	      <url>https://maven.pkg.github.com/uoc/java-lti-1.3-core</url>
	    </repository>				
	    <repository>
	      <id>github-uoc-lti-jwt</id>
	      <name>GitHub UOC Apache Maven Packages</name>
	      <url>https://maven.pkg.github.com/uoc/java-lti-1.3-jwt</url>
	    </repository>				
	    <repository>
	      <id>github-uoc-lti</id>
	      <name>GitHub UOC Apache Maven Packages</name>
	      <url>https://maven.pkg.github.com/uoc/java-lti-1.3</url>
	    </repository>
	</repositories>
    <profiles>
        <profile>
            <id>ws</id>
            <build>
                <finalName>${project.artifactId}</finalName>
            </build>
            <properties>
                <comment>speciaal for ws.fisme.science.uu.nl</comment>
                <dsaccess>//app.dwo.nl/dwo/dsaccess</dsaccess>
                <dsaccess.url>https://app.dwo.nl/dwo/dsaccess</dsaccess.url>
                <dsrest.url>https://app.dwo.nl/dwo/rest/</dsrest.url>
                <ideas>/servlet/IdeasServlet</ideas>
            </properties>
        </profile>
        <profile>
            <id>dummytwo</id>
            <build>
                <finalName>${project.artifactId}_local</finalName>
            </build>
            <properties>
                <comment>speciaal for localhost met dummytwo.dwo.nl als database</comment>
                <dsaccess>https://dummytwo.dwo.nl/dwo/xmlrpc</dsaccess>
                <dsaccess.url>http://dummytwo.dwo.nl/dwo/xmlrpc</dsaccess.url>
                <dsrest.url>http://dummytwo.dwo.nl/dwo/rest/</dsrest.url>
            </properties>
        </profile>
        <profile>
            <id>local</id>
            <build>
<!--                <finalName>${project.artifactId}_local</finalName>-->
            </build>
            <properties>
                <comment>speciaal for localhost met dummytwo.dwo.nl als database</comment>
                <dsaccess>http://127.0.0.1:8080/dwo/xmlrpc</dsaccess>
                <dsaccess.url>http://127.0.0.1:8080/dwo/xmlrpc</dsaccess.url>
                <dsrest.url>http://127.0.0.1:8080/dwo/</dsrest.url>
            </properties>
        </profile>
    </profiles>
    <parent>
    	<groupId>nl.uu.fi.dwo</groupId>
    	<artifactId>dwo</artifactId>
    	<relativePath>../DWO</relativePath>
    	<version>2.5.49-SNAPSHOT</version>
    </parent>
</project>
