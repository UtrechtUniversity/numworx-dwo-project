        <profile>
            <!-- mvn exec:exec -Pdev-localhost -->
            <id>dev-localhost</id>
            <!-- profile for running against localhost with debug enabled -->
            <activation>
                <property>
                    <name>dev-localhost</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-resources-plugin</artifactId>
                        <version>2.5</version>
                        <executions>
                            <execution>
                                <phase>validate</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/exec</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${basedir}/src/test/resources/run-configs/localhost</directory>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>                    
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>1.6.0</version>
                        <configuration>
                            <executable>java</executable>
                            <arguments>
                                <argument>-classpath</argument> 
                                <classpath />
                                <argument>-agentlib:jdwp=transport=dt_socket,server=y,address=${jpda.address}</argument>
                                <argument>fi.dwo.dwojapplet.domain.DWO</argument>
                            </arguments>
                            <!--<mainClass>fi.dwo.dwojapplet.domain.DWO</mainClass>-->
                            <workingDirectory>${project.build.directory}/exec</workingDirectory>
                        </configuration>
                    </plugin>                    
                </plugins>
            </build>
        </profile>
        <profile>
            <id>dwo-pack-sign-obfuscate</id>
            <activation>
                <property>
                    <name>!dev</name>
                </property>
            </activation>            
            <build>
                <plugins>
                    <!-- proguard obfuscation -->            
                    <plugin>
                        <groupId>com.github.wvengen</groupId>
                        <artifactId>proguard-maven-plugin</artifactId>
                        <version>2.7.0</version>
                        <executions>
                            <execution>
                                <phase>package</phase>
                                <goals>
                                    <goal>proguard</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <proguardVersion>7.4.2</proguardVersion>
                            <options>
                                <option>-verbose</option>
                                <option>-dontwarn</option> 
                                <option>-printconfiguration ${project.build.directory}/mapping.txt</option>
                            </options>
                            <obfuscate>true</obfuscate>                    
                            <inputDirectory>${project.build.directory}</inputDirectory>
                            <injar>${project.build.finalName}-jar-with-dependencies.jar</injar>
                            <outFilter>!org/xml/sax/**.class</outFilter>
                            <!-- uncomment to change the output file 
                             <outjar>${project.build.finalName}.jar</outjar>
                            <outputDirectory>${project.build.directory}</outputDirectory>
                            -->
                            <proguardInclude>config.pro</proguardInclude>
                            <libs>
										<lib>${proguard.lib}</lib>
<!--                                 <lib>${java.home}/lib/jsse.jar</lib> -->
                                <!--                               <lib>${java.home}/lib/jfxrt.jar</lib>                       -->
                            </libs>
                            <addMavenDescriptor>false</addMavenDescriptor>
                        </configuration>
                        <dependencies>
                            <dependency>
                                <groupId>com.guardsquare</groupId>
                                <artifactId>proguard-base</artifactId>
                                <version>7.4.2</version>
                                <scope>runtime</scope>
                            </dependency>
                        </dependencies>
                    </plugin>
                    <!-- repack as pack200 -->
                    <plugin>
                        <groupId>com.github.batkinson.plugins</groupId>
                        <artifactId>maven-pack200-plugin</artifactId>
                        <version>1.0.1</version>
                        <executions>
                            <execution>
                                <id>normalize-jars</id>
                                <phase>none</phase>
                                <goals>
                                    <goal>pack</goal>
                                </goals>
                                <configuration>
                                    <normalizeOnly>true</normalizeOnly>
                                </configuration>
                            </execution>
                            <execution>
                                <id>pack-jars</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>pack</goal>
                                </goals>
                                <configuration>
                                    <normalizeOnly>false</normalizeOnly>
                                </configuration>
                            </execution>
                        </executions>
                        <configuration>
                            <processMainArtifact>false</processMainArtifact>
                            <includeClassifiers>
                                <includeClassifier>jar-with-dependencies</includeClassifier>
                            </includeClassifiers>
                        </configuration>                
                        <dependencies>
                            <dependency>
                                <groupId>com.github.batkinson.plugins</groupId>
                                <artifactId>maven-pack200-plugin</artifactId>
                                <version>1.0.1</version>
                                <type>maven-plugin</type>
                            </dependency>
                        </dependencies>                
                    </plugin>        
                </plugins>      
            </build>        
        </profile>
