		        <dependency>
		            <groupId>biz.aQute.bnd</groupId>
		            <artifactId>biz.aQute.bndlib</artifactId>
		            <version>5.1.1</version>
		        </dependency>
		    </dependencies>
    		  <executions>
		    <execution>
		      <id>bundle-manifest</id>
		      <phase>process-classes</phase>
		      <goals>    
		        <goal>manifest</goal>
		      </goals>   
		    </execution>
		  </executions>
       	  <configuration>
       	    <niceManifest>true</niceManifest>
          	<instructions>
   							<_snapshot>${osgi.qualifier}</_snapshot>
                            <Bundle-Name>DWO v2</Bundle-Name>
                            <Bundle-SymbolicName>fi.dwo.dwojapplet.domain.DWO</Bundle-SymbolicName>
                            <Bundle-ManifestVersion>2</Bundle-ManifestVersion>
                            <Fragment-Host>fi.dwo.dwojapplet</Fragment-Host>
                            <Export-Package>fi.beans.numworxlf,fi.beans.copyright,fi.beans.loader,fi.beans.scorm,fi.beans.xmlrpc,fi.beans.mainframe,fi.beans.ideas</Export-Package>
  							<Import-Package>nl.numworx.swingbrowser.api;version="[1.0,2)",
 								com.teamdev.jxbrowser.engine;resolution:=optional,
 								com.teamdev.jxbrowser;resolution:=optional,
  								javax.swing.*,
  								!javax.servlet.*,
  								javax.*;resolution:=optional,
  								fi.dwo.eawt;resolution:=optional,
  								org.osgi.util.promise;version="[1.0,2)",org.osgi.util.function;version="[1.0,2)",
  								!com.*,!org.apache.*,!org.eclipse.*,!org.glassfish.*,!org.springframework.*,!org.joda.*,!fi.dwo.eawt.*,
  								*</Import-Package>
 							<Embed-Dependency>*;scope=compile;type=!pom;inline=true</Embed-Dependency>
         					<Embed-Transitive>true</Embed-Transitive>
                            <DWOJApplet-Implementation-Version>${project.version}</DWOJApplet-Implementation-Version>
                            <Implementation-Build>${buildNumber}</Implementation-Build>
                            <Implementation-Timestamp>${timestamp}</Implementation-Timestamp>
                            <Implementation-ScmBranch>${buildScmBranch}</Implementation-ScmBranch>
                            <DWOJApplet-Implementation-Build>${buildNumber}</DWOJApplet-Implementation-Build>
                            <Main-Class>fi.dwo.dwojapplet.domain.DWO</Main-Class>
                            <Class-Path>swingbrowser-jxb.jar swingbrowser-api.jar</Class-Path>
          	</instructions>
          </configuration>
		</plugin>   
            <!-- put the build number in the manifest -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>2.5</version>
                <configuration>
                    <archive>
                        <manifest>
                            <addDefaultImplementationEntries>false</addDefaultImplementationEntries>
                            <addClasspath>false</addClasspath>
                        </manifest>
                        <manifestEntries>
                            <Main-Class>fi.dwo.dwojapplet.domain.DWO</Main-Class>
                            <Application-Name>DWO v2</Application-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <configuration>
 					<archive>  
      					<manifestFile>${project.build.outputDirectory}/META-INF/MANIFEST.MF</manifestFile>
                         <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                            <addClasspath>false</addClasspath>
                        </manifest>
<!--                          <manifestEntries> -->
<!--                             <Class-Path>swingbrowser-jxb.jar swingbrowser-jfx.jar swingbrowser-api.jar</Class-Path> -->
<!--                             <DWOJApplet-Implementation-Version>${project.version}</DWOJApplet-Implementation-Version> -->
<!--                             <Implementation-Build>${buildNumber}</Implementation-Build> -->
<!--                             <Implementation-Timestamp>${timestamp}</Implementation-Timestamp> -->
<!--                             <Implementation-ScmBranch>${buildScmBranch}</Implementation-ScmBranch> -->
<!--                             <DWOJApplet-Implementation-Build>${buildNumber}</DWOJApplet-Implementation-Build> -->
<!--  						 </manifestEntries> -->
    				</archive> 
                    <descriptorRefs>
                        <descriptorRef>jar-with-dependencies</descriptorRef>
                    </descriptorRefs>
                </configuration>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>       
        </plugins>
        <finalName>${project.artifactId}-${project.version}</finalName>
