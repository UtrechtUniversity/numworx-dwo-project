<?xml version="1.0" encoding="UTF-8"?>
<web-app version="3.1">
  <servlet>
    <servlet-name>dwo</servlet-name>
    <servlet-class>org.mitre.dsmiley.httpproxy.ProxyServlet</servlet-class>
    <init-param>
      <param-name>targetUri</param-name>
      <param-value>http://localhost:8080/DWOServer/dwo</param-value>
    </init-param>
    <init-param>
      <param-name>log</param-name>
      <param-value>true</param-value>
    </init-param>
  </servlet>
    <servlet>
    	<servlet-name>IdeasServlet</servlet-name>
    	<servlet-class>fi.servlet.ideas.IdeasServlet</servlet-class>
      <init-param>
         <param-name>ideascgi</param-name>
         <param-value>http://ideas.cs.uu.nl/cgi-bin/ideas.cgi</param-value>
      </init-param>
      <init-param>
         <param-name>extra-ideascgi</param-name>
         <param-value>hypothesis</param-value>
      </init-param>
      <init-param>
         <param-name>ideascgi.hypothesis</param-name>
         <param-value>http://ideastest.science.uu.nl/cgi-bin/statistics.cgi</param-value>
      </init-param>
      <init-param>
         <param-name>mixedfraction</param-name>
         <param-value>true</param-value>
      </init-param>
      <init-param>
         <param-name>direct</param-name>
         <param-value>true</param-value>
      </init-param>
      <init-param>
         <param-name>phrasebook</param-name>
         <param-value>mpreduce</param-value>
      </init-param>
    </servlet>    
  <servlet-mapping>
    <servlet-name>dwo</servlet-name>
    <url-pattern>/dwo/*</url-pattern>
  </servlet-mapping>
    <servlet-mapping>
    	<servlet-name>IdeasServlet</servlet-name>
    	<url-pattern>/ideas/IdeasServlet</url-pattern>  
    </servlet-mapping>
  <welcome-file-list>
    <welcome-file>gwtclient.html</welcome-file>
  </welcome-file-list>
</web-app>