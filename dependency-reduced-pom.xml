<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>fi.dwo</groupId>
  <artifactId>DWOJApplet</artifactId>
  <name>DWOJApplet - trunk</name>
  <version>1.0.1-SNAPSHOT</version>
  <url>http://www.dwo.nl</url>
  <inceptionYear>2015</inceptionYear>
  <developers>
    <developer>
      <id>Gert van der Plas</id>
      <name>plas0006</name>
      <email>g.a.j.vanderplas@uu.nl</email>
      <organization>Freudenthal Institute</organization>
      <organizationUrl>http://www.uu.nl/onderzoek/freudenthal-instituut</organizationUrl>
      <roles>
        <role>Administrator</role>
        <role>Java Developer</role>
      </roles>
    </developer>
  </developers>
  <scm>
    <developerConnection>scm:svn:https://svn.science.uu.nl/repos/project.fisme.java/DWOJApplet/trunk</developerConnection>
  </scm>
  <organization>
    <name>Freudenthal Institute</name>
    <url>http://www.uu.nl/onderzoek/freudenthal-instituut</url>
  </organization>
  <build>
    <finalName>${project.artifactId}-${project.version}-r${buildNumber}</finalName>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.2</version>
        <configuration>
          <source>1.6</source>
          <target>1.6</target>
          <encoding>${project.build.sourceEncoding}</encoding>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-resources-plugin</artifactId>
        <version>2.7</version>
        <configuration>
          <encoding>${project.build.sourceEncoding}</encoding>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>2.18.1</version>
        <configuration>
          <skipTests>true</skipTests>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>2.3</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <artifactSet>
                <includes>
                  <include>*:*</include>
                </includes>
              </artifactSet>
              <filters>
                <filter>
                  <artifact>fi.dwo:DWO-commons-lib</artifact>
                  <excludes>
                    <exclude>javax.servlet:*</exclude>
                  </excludes>
                </filter>
              </filters>
              <relocations>
                <relocation>
                  <pattern>fi.wiskopdr</pattern>
                  <shadedPattern>fi.shaded.wiskopdr2</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>org.cbook</pattern>
                  <shadedPattern>org.cbook.shaded</shadedPattern>
                </relocation>
              </relocations>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>buildnumber-maven-plugin</artifactId>
        <version>1.3</version>
        <executions>
          <execution>
            <phase>validate</phase>
            <goals>
              <goal>create</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <doCheck>false</doCheck>
          <doUpdate>true</doUpdate>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-jar-plugin</artifactId>
        <version>2.5</version>
        <configuration>
          <archive>
            <manifest>
              <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
              <addClasspath>true</addClasspath>
            </manifest>
            <manifestEntries>
              <DWOJApplet-Implementation-Version>${project.version}</DWOJApplet-Implementation-Version>
              <Implementation-Build>${buildNumber}</Implementation-Build>
              <DWOJApplet-Implementation-Build>${buildNumber}</DWOJApplet-Implementation-Build>
              <Main-Class>fi.dwo.dwojapplet.domain.DWO</Main-Class>
              <Trusted-Only>true</Trusted-Only>
              <Permissions>all-permissions</Permissions>
              <Codebase>*.uu.nl *.fi.uu.nl dme.colorado.edu *.appspot.com *.dwo.nl localhost dme.mathhouse.org</Codebase>
              <Caller-Allowable-Codebase>*.uu.nl *.fi.uu.nl dme.colorado.edu *.appspot.com *.dwo.nl localhost dme.mathhouse.org</Caller-Allowable-Codebase>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>dwo-obfuscate</id>
      <build>
        <plugins>
          <plugin>
            <groupId>com.github.wvengen</groupId>
            <artifactId>proguard-maven-plugin</artifactId>
            <version>2.0.8</version>
            <executions>
              <execution>
                <phase>package</phase>
                <goals>
                  <goal>proguard</goal>
                </goals>
              </execution>
            </executions>
            <dependencies>
              <dependency>
                <groupId>net.sf.proguard</groupId>
                <artifactId>proguard-base</artifactId>
                <version>5.2</version>
                <scope>runtime</scope>
              </dependency>
            </dependencies>
            <configuration>
              <proguardVersion>5.2</proguardVersion>
              <options>
                <option>-verbose</option>
                <option>-dontwarn</option>
                <option>-printconfiguration mapping.txt</option>
              </options>
              <obfuscate>true</obfuscate>
              <inputDirectory>${project.build.directory}</inputDirectory>
              <injar>${project.build.finalName}.jar</injar>
              <proguardInclude>config.pro</proguardInclude>
              <libs>
                <lib>${java.home}/lib/rt.jar</lib>
                <lib>${java.home}/lib/jsse.jar</lib>
                <lib>${java.home}/lib/jfxrt.jar</lib>
              </libs>
              <addMavenDescriptor>false</addMavenDescriptor>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>dwo-pack-sign</id>
      <build>
        <plugins>
          <plugin>
            <groupId>com.github.batkinson.plugins</groupId>
            <artifactId>maven-pack200-plugin</artifactId>
            <version>1.0.1</version>
            <executions>
              <execution>
                <id>normalize-jars</id>
                <phase>package</phase>
                <goals>
                  <goal>pack</goal>
                </goals>
                <configuration>
                  <normalizeOnly>true</normalizeOnly>
                </configuration>
              </execution>
              <execution>
                <id>pack-jars</id>
                <phase>verify</phase>
                <goals>
                  <goal>pack</goal>
                </goals>
                <configuration>
                  <normalizeOnly>false</normalizeOnly>
                </configuration>
              </execution>
            </executions>
            <dependencies>
              <dependency>
                <groupId>com.github.batkinson.plugins</groupId>
                <artifactId>maven-pack200-plugin</artifactId>
                <version>1.0.1</version>
                <type>maven-plugin</type>
              </dependency>
            </dependencies>
            <configuration>
              <processMainArtifact>true</processMainArtifact>
              <includeClassifiers>
                <includeClassifier>all-in-one</includeClassifier>
              </includeClassifiers>
            </configuration>
          </plugin>
          <plugin>
            <artifactId>maven-jarsigner-plugin</artifactId>
            <version>1.4</version>
            <executions>
              <execution>
                <phase>package</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
              <execution>
                <id>verify</id>
                <goals>
                  <goal>verify</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <keystore>${dwoKeyStore}</keystore>
              <alias>${dwoCertKeyAlias}</alias>
              <storepass>${dwoCertKeyStorePassword}</storepass>
              <keypass>${dwoCertKeyPassword}</keypass>
              <sigfile>UU</sigfile>
              <tsa>https://timestamp.geotrust.com/tsa</tsa>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
  <repositories>
    <repository>
      <id>repo</id>
      <url>file://${project.basedir}/repo</url>
    </repository>
    <repository>
      <id>maven-pack200-plugin</id>
      <url>https://oss.sonatype.org/content/repositories/releases/com/github/batkinson/plugins/maven-pack200-plugin/</url>
    </repository>
  </repositories>
  <dependencies>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.12</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <artifactId>hamcrest-core</artifactId>
          <groupId>org.hamcrest</groupId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>jre.plugin</groupId>
      <artifactId>plugin</artifactId>
      <version>1.8.0_31</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>
  <properties>
    <maven.compiler.source>1.6</maven.compiler.source>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.target>1.6</maven.compiler.target>
  </properties>
</project>

