<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
        <groupId>nl.uu.fi.dwo</groupId>
        <artifactId>dwo</artifactId>
        <version>2.5.49-SNAPSHOT</version>
        <relativePath>../DWO/pom.xml</relativePath>
  </parent>
  <groupId>fi.wiskopdrgwt</groupId>
  <artifactId>wiskopdrgwt</artifactId>
  <name>WiskOpdrGWT</name>
  <properties>
  	<gwtVersion>2.8.2</gwtVersion>
  	<mgwtVersion>1.1.2</mgwtVersion>
  	<maven.compiler.source>1.8</maven.compiler.source>
  	<maven.compiler.target>1.8</maven.compiler.target>
  	<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  	<interactionVersion>0.1.6</interactionVersion>
  	<maven.javadoc.skip>true</maven.javadoc.skip>
  </properties>
  <dependencies>
  	<dependency>
  		<groupId>com.google.gwt</groupId>
  		<artifactId>gwt-user</artifactId>
  		<scope>provided</scope>
  		<version>${gwtVersion}</version>
  	</dependency>
  	<dependency>
  		<groupId>nl.uu.fi.dwo.mobile</groupId>
  		<artifactId>interaction</artifactId>
  	</dependency>

  	<dependency>
  		<groupId>nl.uu.fi.dwo.ideas</groupId>
  		<artifactId>ideasgwt</artifactId>
  		<version>0.1.9</version>
  	</dependency>
  </dependencies>
  <build>
	<finalName>wiskopdrexpressies</finalName>
  	<resources>
  		<resource>
  			<directory>src</directory>
  		</resource>
  	</resources>
  	<sourceDirectory>src</sourceDirectory>
    <plugins>
    	<plugin>
    		<artifactId>maven-compiler-plugin</artifactId>
    		<version>3.1</version>   	
    	</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-release-plugin</artifactId>
				<version>2.5.3</version>
				<configuration>
    				<arguments>-Dmaven.javadoc.skip=true</arguments>
				</configuration>
			</plugin>
    </plugins>
  </build>
  <description />
  <version>2.5.49-SNAPSHOT</version>
</project>
