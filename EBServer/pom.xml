			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-war-plugin</artifactId>
				<configuration>
          			<filteringDeploymentDescriptors>true</filteringDeploymentDescriptors>
					<webXml>src/main/webxml/web.xml</webXml>
					<archive>
						<manifest>
							<addDefaultImplementationEntries>true</addDefaultImplementationEntries>
						</manifest>
						<manifestEntries>
							<Implementation-Build>${buildNumber}</Implementation-Build>
							<Implementation-Timestamp>${timestamp}</Implementation-Timestamp>
							<Implementation-ScmBranch>${scmBranch}</Implementation-ScmBranch>
						</manifestEntries>
					</archive>
					<overlays>
						<overlay>
							<groupId>fi.dwo</groupId>
							<artifactId>dwo-apps</artifactId>
							<targetPath>/dwo/apps</targetPath>
							<excludes>
								<exclude>WEB-INF/**</exclude>
								<exclude>META-INF/**</exclude>
							</excludes>
						</overlay>
						<overlay>
							<groupId>nl.uu.fi.dwo.mobile</groupId>
							<artifactId>dwoplayer</artifactId>
							<targetPath>/dwo/tablet</targetPath>		
							<excludes>
								<exclude>WEB-INF/**</exclude>
								<exclude>META-INF/**</exclude>
							</excludes>
						</overlay>
						<overlay>
							<groupId>nl.uu.fi.dwo.lms</groupId>
							<artifactId>dwogwtclient</artifactId>
							<excludes>
								<exclude>WEB-INF/**</exclude>
								<exclude>META-INF/**</exclude>
								<exclude>**/*.scss</exclude>
								<exclude>css/*.rb</exclude>
								<exclude>css/*.map</exclude>
								<exclude>login.html</exclude>
								<exclude>gwtclient.html</exclude>
								<exclude>html5plain.html</exclude>
<!--								<exclude>library.html</exclude>-->
								<exclude>**/*.md</exclude>
								<exclude>ng-js/**</exclude>
								<exclude>js-plainui/**</exclude>
								<exclude>chatbox/**</exclude>
							</excludes>
							<targetPath>/gwtclient</targetPath>
						</overlay>
						<overlay>
							<groupId>nl.uu.fi.dwo.register</groupId>
							<artifactId>register</artifactId>
							<targetPath>/dwo/register</targetPath>
							<excludes>
								<exclude>WEB-INF/**</exclude>
								<exclude>META-INF/**</exclude>
							</excludes>
						</overlay>
						<overlay>
							<groupId>fi.servlet</groupId>
							<artifactId>dwomaccess</artifactId>
							<targetPath>/DWOmAccess</targetPath>
							<excludes>
								<exclude>WEB-INF/**</exclude>
								<exclude>META-INF/**</exclude>
							</excludes>
						</overlay>
						<overlay>
							<groupId>nl.numworx.oauth2</groupId>
							<artifactId>oauth2client</artifactId>
							<targetPath>/dwo/oauth2client</targetPath>
							<excludes>
								<exclude>WEB-INF/**</exclude>
								<exclude>META-INF/**</exclude>
							</excludes>						
						</overlay>
						<overlay>
						     <groupId>nl.uu.fi.dwo.lms</groupId>
             				 <artifactId>chatgwt-server</artifactId>
							<targetPath>/gwtclient/chatbox</targetPath>
							<excludes>
								<exclude>WEB-INF/**</exclude>
								<exclude>META-INF/**</exclude>
							</excludes>						
						</overlay>
					</overlays>
				</configuration>
			</plugin>
			<plugin> <!-- NIET ZOMAAR WEGGOOIEN! -->
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>3.5.0</version>
				<executions>
					<execution>
						<id>local-index</id>
						<goals>
							<goal>java</goal>
						</goals>
						<phase>process-resources</phase>
					</execution>
				</executions>
				<dependencies>
					<dependency>
						<groupId>fi.microserver</groupId>
						<artifactId>microindex</artifactId>
						<version>2.5.48</version>
					</dependency>
				</dependencies>
				<configuration>
					<mainClass>fi.microserver.microindex.Main</mainClass>
					<includeProjectDependencies>false</includeProjectDependencies>
					<includePluginDependencies>true</includePluginDependencies>
					<addOutputToClasspath>false</addOutputToClasspath>
					<addResourcesToClasspath>false</addResourcesToClasspath>
					<arguments>
						<argument>${project.build.directory}/${project.build.finalName}/dwo</argument>
					</arguments>
					<blockSystemExit>true</blockSystemExit>
				</configuration>
			</plugin>
