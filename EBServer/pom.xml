  </servlet>

]]></upload.servlet>
	<upload.servlet.mapping><![CDATA[
  <servlet-mapping>
  	<servlet-name>upload</servlet-name>
    <url-pattern>/dwo/dav/upload/servlet.gupld</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
  	<servlet-name>javaupload</servlet-name>
    <url-pattern>/dwo/dav/upload/dir/*</url-pattern> 
  </servlet-mapping>
  <servlet-mapping>
  	<servlet-name>updownload</servlet-name>
  	<url-pattern>/dwo/dav/upload/download/*</url-pattern>  
  </servlet-mapping>
  <servlet-mapping>
  	<servlet-name>testblob</servlet-name>
  	<url-pattern>/dwo/dav/testblob/*</url-pattern>
  </servlet-mapping>
    <servlet-mapping>
  	<servlet-name>proxy</servlet-name>
  	<url-pattern>/proxy/*</url-pattern>
  </servlet-mapping>
]]></upload.servlet.mapping>		
