	<rule>
		<note>DWO.properties in DWOmAccess</note>
		<from>^/DWOmAccess/lti/DWO.properties</from>
		<to type="redirect">/dwo/DWO.properties</to>
	</rule>
	<rule>
		<note>/wisweb naar cdn</note>
		<from>^/wisweb/images/(.+)$</from>
		<to type="temporary-redirect">https://cdn.dwo.nl/wisweb/images/$1</to>
	</rule>
	<rule>
		<note>/jars naar cdn</note>
		<from>^/dwo/jars/(.+)$</from>
		<to type="temporary-redirect">https://cdn.dwo.nl/jars/$1</to>
	</rule>
    <rule>
        <note>Default rule when no other content-type was asked for</note>
        <from>^/$</from>
        <to>index.jsp</to>
    </rule>
    <rule>
    	<note>/rest/userid+schoolid/*</note>
    	<from>^/dwo/rest/sec:[^/]+/(.*)$</from>
    	<to>/dwo/rest/secure/$1</to>   
    </rule>
